---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import SiteThemeToggle from '../components/SiteThemeToggle.astro';
import SiteLangToggle from '../components/SiteLangToggle.astro';
import { SITE } from '../lib/constants';
import { absUrl, hreflangs, keyOf, localeOf, pathOr } from '../lib/routes.mjs';
import { t } from '../lib/i18n';

interface Props {
  pageTitle: string;
  /** Optional: ueberschreibt den gesamten <title> und og:title.
      Ohne wird pageTitle mit " — Tammo Studios" suffixed. Nutzen fuer
      SEO-optimierte Titles wo der Brand-Suffix redundant waere
      (z.B. Homepage — Domain zeigt schon Brand). */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Optionales page-spezifisches JSON-LD (z.B. Person auf /ueber),
      wird in den @graph mit aufgenommen. */
  additionalSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const { pageTitle, title, description = `${SITE.name} — Webentwicklung aus ${SITE.location}.`, noindex = false, additionalSchema } = Astro.props;

const fullTitle = title ?? `${pageTitle} — ${SITE.name}`;
// Default Allow: nur PUBLIC_ALLOW_INDEXING="false" rendert das
// noindex-Meta-Tag. Dieselbe Inversion wie in src/pages/robots.txt.ts —
// schützt gegen Env-Var-Fehlkonfiguration in Production. Plus: Pages
// können selbst noindex erzwingen (z.B. 404).
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING !== 'false';
const renderNoindex = !allowIndexing || noindex;
// absUrl() statt new URL(): letzteres haengt der Wurzel einen Slash an
// (…de/), die Sitemap liefert sie aber ohne (…de). Zwei Schreibweisen
// derselben Seite in Canonical und Sitemap sind unnoetig.
const canonicalURL = absUrl(Astro.url.pathname);
// Texte der strukturierten Daten. Vorher standen sie fest auf Deutsch,
// und damit trug jede englische Seite eine deutsche Beschreibung, eine
// Brotkrume namens "Startseite" mit der deutschen Startseite als Ziel
// und Angebote, die auf /preise statt /en/pricing verwiesen.
const d = t(Astro.url.pathname);

// ZU DEN UEBERGANGS-REGELN WEITER UNTEN (is:inline im <head>):
//
// Sie stehen inline, und das ist nicht kosmetisch. Der Uebergang beim
// Sprachwechsel geht ueber zwei Dokumente: der Browser entscheidet beim
// ANKOMMEN der neuen Seite, ob er ihn weiterfuehrt, und braucht
// @view-transition zu diesem Zeitpunkt bereits. Liegt die Regel in
// einer nachgeladenen Datei, kommt sie zu spaet und der Uebergang
// faellt still aus. Im Dev-Server liefert Astro JEDEN <style>-Block als
// nachgeladenes Modul aus — dort waere der Uebergang damit nie zu
// sehen, im Build dagegen schon. Genau dieser Unterschied hat ihn
// zuerst unsichtbar gemacht.
//
// Aus demselben Grund stehen die Keyframes hier und nicht bei den
// Umschaltern: sie muessen zur selben Zeit greifen.
//
// Was die beiden Uebergaenge zeigen:
//   Sprachwechsel — die alte Fassung zieht zur Seite ab, die neue kommt
//   von der anderen nach, in Richtung des Daumens am Umschalter.
//   Der Weg war zuerst auf vier Prozent gesetzt, aus Sorge vor einer
//   Diashow. Das war zu wenig: die beiden Sprachfassungen sehen bis auf
//   den Text gleich aus, und bei vier Prozent in 220 ms war die
//   Bewegung nachweislich da, aber nicht zu sehen. Jetzt achtzehn
//   Prozent und etwas mehr Zeit — genug, dass das Auge dem Schub folgt.
//   Themenwechsel — der neue Zustand wird als Kreis vom Knopf aus ueber
//   den alten gezogen, wie Licht, das von einem Schalter ausgeht. Den
//   alten wegzuwischen saehe aus wie ein Loch in der Seite.
//
// Ohne gesetzte Richtung laeuft nichts: jede andere Navigation wechselt
// ohne Ueberblendung. Die Weiche dafuer steht im Skript am Fuss.
const alternateLinks = hreflangs(Astro.url.pathname);
// Seitenart ueber die Routen-Tabelle statt ueber Pfad-Vergleiche. Die
// alten Pruefungen (pathname === '/' und /^\/webdesign-/) waeren fuer
// /en und /en/web-design-trades beide falsch ausgegangen.
const routeKey = keyOf(Astro.url.pathname);
const locale = localeOf(Astro.url.pathname);
const isLanding = routeKey === 'home';
const initialPage = isLanding ? 'landing' : 'subpage';

// Vertical Landings sind eigene Photo-Hero-Landings mit eigener
// Design-Sprache — kein Site-Theme-Toggle darauf.
const VERTICAL_KEYS = ['handwerk', 'praxis', 'gastronomie'];
const isVerticalLanding = VERTICAL_KEYS.includes(routeKey ?? '');
const hideThemeToggle = isLanding || isVerticalLanding;

// LocalBusiness JSON-LD Schema. ProfessionalService (Subtype von
// LocalBusiness) matched einen Solo-Freelance-Webentwickler besser
// als das generische LocalBusiness. Google indexiert das + zeigt es
// bei lokaler Suche in Bremen (mit Google-Business-Profile-Match).
// @id koppelt uns eindeutig — Google dedupliziert schema-Blocks
// die auf den gleichen @id verweisen sitewide.
//
// Founder-Referenz zeigt per @id auf Tammo Hendriks (Person). Die
// vollstaendige Person-Definition steht separat auf /ueber (via
// additionalSchema-Prop) — Google merged Entities mit gleicher
// @id automatisch in ihren Knowledge-Graph.
const TAMMO_ID = `${SITE.url}/#tammo`;
const BUSINESS_ID = `${SITE.url}/#business`;

const businessSchema: Record<string, unknown> = {
  '@type': 'ProfessionalService',
  '@id': BUSINESS_ID,
  name: SITE.name,
  description: d.schema.beschreibung,
  // Die Adresse DIESER Sprachfassung. @id bleibt dieselbe: es ist
  // derselbe Betrieb, nur anders beschrieben.
  url: absUrl(pathOr('home', locale)),
  logo: new URL('/logos/logo-websiteicon.png', SITE.url).toString(),
  image: new URL('/og-image.png', SITE.url).toString(),
  telephone: '+49 177 1962704',
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.zip,
    addressLocality: SITE.address.city,
    addressCountry: 'DE',
  },
  // Exakte Geo-Koordinaten via OpenStreetMap Nominatim geocoded.
  // Google kann zwar aus der Adresse selbst geocoden, aber explizit
  // gesetzt gibt es eine hoehere Confidence + hilft bei Map-Snippets.
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 53.1021131,
    longitude: 8.7901098,
  },
  areaServed: [
    { '@type': 'City', name: 'Bremen' },
    { '@type': 'AdministrativeArea', name: d.schema.bundesland },
    { '@type': 'Country', name: d.schema.land },
  ],
  priceRange: '€€',
  // Konkrete Angebote — Google kann Preise im Rich-Result ausspielen.
  // Preise als String (schema.org empfiehlt das fuer Waehrungsangaben).
  // Preis und Ziel sind Struktur, Name und Beschreibung stehen im
  // Woerterbuch. Die Ziele folgen der Sprache: ein englisches Angebot,
  // das auf die deutsche Preisseite zeigt, schickt den Leser in die
  // falsche Fassung.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: d.schema.katalog,
    itemListElement: (
      [
        { preis: '2000', ziel: 'preise' },
        { preis: '3000', ziel: 'preise' },
        { preis: '500', ziel: 'software' },
      ] as const
    ).map((angebot, i) => ({
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: angebot.preis,
      availability: 'https://schema.org/InStock',
      url: absUrl(pathOr(angebot.ziel, locale)),
      itemOffered: {
        '@type': 'Service',
        name: d.schema.angebote[i].name,
        description: d.schema.angebote[i].beschreibung,
        provider: { '@id': BUSINESS_ID },
      },
    })),
  },
  founder: {
    '@type': 'Person',
    '@id': TAMMO_ID,
    name: 'Tammo Hendriks',
    jobTitle: d.schema.jobTitle,
    url: absUrl(pathOr('ueber', locale)),
  },
  sameAs: ['https://www.instagram.com/tammostudios/'],
  knowsAbout: d.schema.kannUeber,
  slogan: d.schema.slogan,
};

// BreadcrumbList: nur auf Sub-Pages. Zwei Ebenen (Startseite -> Page),
// da die Site flach ist (kein Category-Level). Google nutzt das fuer
// den Breadcrumb-Snippet im Suchergebnis unter dem Titel.
const breadcrumbSchema: Record<string, unknown> | null = isLanding
  ? null
  : {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          // Nicht fest 'Startseite' und nicht fest die deutsche Wurzel:
          // auf einer englischen Seite stand damit "Startseite" im
          // Suchergebnis, und die Brotkrume fuehrte aus der Sprache
          // heraus. absUrl schreibt die Wurzel ausserdem ohne Slash am
          // Ende, wie canonical und Sitemap es auch tun.
          name: d.schema.brotkrumeStart,
          item: absUrl(pathOr('home', locale)),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageTitle,
          item: canonicalURL,
        },
      ],
    };

// Alle Schemas zu einem @graph zusammenfassen — Google akzeptiert das
// als kanonische Multi-Entity-Struktur, Entities mit gleicher @id
// werden ueber Blocks hinweg dedupliziert.
const additionalSchemas = additionalSchema
  ? Array.isArray(additionalSchema)
    ? additionalSchema
    : [additionalSchema]
  : [];

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    businessSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...additionalSchemas,
  ],
};
---

<!doctype html>
<html lang={locale} data-page={initialPage} data-no-theme={hideThemeToggle ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternateLinks.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}
    {renderNoindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/png" href="/logos/logo-websiteicon.png" />
    <link rel="apple-touch-icon" href="/logos/logo-websiteicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "de_DE"} />
    <meta property="og:image" content={new URL('og-image.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.schema.bildAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('og-image.png', Astro.site).toString()} />
    <meta name="theme-color" content="#0a0a0c" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLdGraph)}
    />
    {isLanding && (
      <link
        rel="preload"
        href="/logos/logo-full.webp"
        as="image"
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <link
      rel="preload"
      href="/fonts/montreal/NeueMontreal-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {!isLanding && (
      <link
        rel="preload"
        href="/fonts/aileron/Aileron-BlackItalic.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <script is:inline>
      // Startseite-Reveal-Flag: setzt einmalig pro Session
      // data-startseite-anim="1" auf <html>, sobald der User von der
      // Landing auf eine Sub-Page wechselt. Die Keyframe-Animation
      // im TopBar-CSS hängt an genau diesem Attribut, sodass das Item
      // beim ERSTEN Sub-Page-Besuch smooth einfadet — bei späteren
      // Sub-Page-Wechseln ist es einfach da, ohne erneutes Re-Triggern.
      // Bei Rückkehr zur Landing wird das Flag gelöscht, sodass der
      // nächste Wechsel wieder eine Animation produziert.
      try {
        // Liest data-page vom <html>, das serverseitig ueber die
        // Routen-Tabelle gesetzt wird. Kein Pfad-Vergleich mehr, damit
        // /en genauso als Landing gilt wie /.
        var isLanding = document.documentElement.dataset.page === 'landing';
        if (isLanding) {
          window.sessionStorage.removeItem('ts-startseite-shown');
        } else if (!window.sessionStorage.getItem('ts-startseite-shown')) {
          document.documentElement.setAttribute('data-startseite-anim', '1');
          window.sessionStorage.setItem('ts-startseite-shown', '1');
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // Splash-Intro deaktiviert (User-Wunsch): sofort alles anzeigen,
      // keine 1.2s-Reveal-Sequence mehr. Alle Hero-Elemente werden per
      // splash-skip-Class direkt sichtbar. Section1-Script hat einen
      // splash-skip-Check und tut nichts wenn Class gesetzt ist.
      try {
        document.documentElement.classList.add('splash-skip');
      } catch (e) {}
    </script>
    <script is:inline>
      // Site-Theme (Dark ↔ Light) fruehzeitig setzen um FOUC zu vermeiden.
      // WIRKT NICHT wo data-no-theme gesetzt ist (Landing + Verticals).
      // Toggle-Component + CSS reagieren auf data-site-theme=light auf <html>.
      //
      // Legacy-Migration: der fruehere Journal-only Toggle hat
      // 'journal-theme' localStorage geschrieben. Wir migrieren einmalig
      // zu 'site-theme' damit User's Preference erhalten bleibt.
      try {
        // data-no-theme setzt der Server ueber die Routen-Tabelle auf
        // Landing und Vertical-Landings. Frueher stand hier derselbe
        // Pfad-Vergleich ein zweites Mal — zwei Orte, eine Wahrheit.
        var isLandingPath =
          document.documentElement.hasAttribute('data-no-theme');

        // Migration von altem 'journal-theme' → 'site-theme'
        var legacy = localStorage.getItem('journal-theme');
        if (legacy && !localStorage.getItem('site-theme')) {
          localStorage.setItem('site-theme', legacy);
          localStorage.removeItem('journal-theme');
        }

        if (!isLandingPath && localStorage.getItem('site-theme') === 'light') {
          document.documentElement.setAttribute('data-site-theme', 'light');
        }
      } catch (e) {}
    </script>
    <!-- Uebergaenge der beiden Umschalter. Inline, weil der Browser
         @view-transition beim Ankommen der neuen Seite schon braucht —
         die Begruendung steht im Frontmatter. -->
    <style is:inline>
      /* Normalfall: keine Richtung gesetzt, keine Bewegung. */
      html:not([data-sprach-richtung]):not([data-thema-wechsel])::view-transition-old(root),
      html:not([data-sprach-richtung]):not([data-thema-wechsel])::view-transition-new(root) {
        animation: none;
      }

      /* Themenwechsel: Lichtkegel vom Knopf aus ueber den alten Stand.
         mix-blend-mode hebt die eingebaute Vorgabe auf, die die
         Ueberlappung aufhellen wuerde. */
      html[data-thema-wechsel]::view-transition-old(root) {
        animation: none; mix-blend-mode: normal; z-index: 0;
      }
      html[data-thema-wechsel]::view-transition-new(root) {
        animation: thema-kreis 560ms cubic-bezier(0.33, 0, 0.2, 1) both;
        mix-blend-mode: normal; z-index: 1;
      }
      @keyframes thema-kreis {
        from { clip-path: circle(0 at var(--thema-x) var(--thema-y)); }
        to   { clip-path: circle(var(--thema-r) at var(--thema-x) var(--thema-y)); }
      }
    </style>
    {alternateLinks.length > 0 && (
      <style is:inline>
        /* Nur auf Seiten mit Gegenseite. Auf Journal und Rechtstexten
           kann es keinen Sprachwechsel geben — dort waeren die Regel und
           der dafuer vorbereitete, gleich wieder abgebrochene Uebergang
           reine Verschwendung. */
        @view-transition { navigation: auto; }

        /* Sprachwechsel: Schub in Richtung des Daumens am Umschalter.
           Die alte Fassung zieht ab und faded schnell weg, die neue
           kommt langsamer nach — so ist die Ueberlappung kurz und das
           Bild bleibt klar. */
        html[data-sprach-richtung='en']::view-transition-old(root) {
          animation: sprache-raus-links 300ms cubic-bezier(0.5, 0, 0.75, 0) both;
        }
        html[data-sprach-richtung='en']::view-transition-new(root) {
          animation: sprache-rein-rechts 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        html[data-sprach-richtung='de']::view-transition-old(root) {
          animation: sprache-raus-rechts 300ms cubic-bezier(0.5, 0, 0.75, 0) both;
        }
        html[data-sprach-richtung='de']::view-transition-new(root) {
          animation: sprache-rein-links 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @keyframes sprache-raus-links {
          from { opacity: 1; transform: translateX(0); }
          to   { opacity: 0; transform: translateX(-18%); }
        }
        @keyframes sprache-rein-rechts {
          from { opacity: 0; transform: translateX(18%); }
          to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes sprache-raus-rechts {
          from { opacity: 1; transform: translateX(0); }
          to   { opacity: 0; transform: translateX(18%); }
        }
        @keyframes sprache-rein-links {
          from { opacity: 0; transform: translateX(-18%); }
          to   { opacity: 1; transform: translateX(0); }
        }
      </style>
    )}
    <!--
      Die Weiche fuer die Uebergaenge. Als is:inline im KOPF, nicht als
      Modul im Body: pagereveal feuert auf der ankommenden Seite vor der
      ersten Darstellungsmoeglichkeit. Ein Modul-Skript laeuft
      verzoegert, und auch wenn es in der Messung rechtzeitig dran war,
      haengt das an der Reihenfolge, die der Browser nicht zusichert.
      Inline im Kopf ist der Hoerer garantiert vor dem Ereignis da.

      Kein TypeScript hier — is:inline reicht Astro unveraendert durch.
    -->
    <script is:inline>
      (function () {
        var SCHLUESSEL = 'sprachwechsel';

        // Vormerker lesen: "<richtung> <zielpfad>".
        function vormerker() {
          try {
            var roh = sessionStorage.getItem(SCHLUESSEL);
            if (!roh) return null;
            var teile = roh.split(' ');
            return teile[0] && teile[1] ? { richtung: teile[0], ziel: teile[1] } : null;
          } catch (e) {
            return null;
          }
        }

        function vergessen() {
          try {
            sessionStorage.removeItem(SCHLUESSEL);
          } catch (e) {
            // kein Speicher, also auch nichts zu vergessen
          }
        }

        function reduziert() {
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        }

        function pfadVon(url) {
          if (!url) return null;
          try {
            return new URL(url).pathname;
          } catch (e) {
            return null;
          }
        }

        // Verlassende Seite.
        window.addEventListener('pageswap', function (e) {
          var uebergang = e.viewTransition;
          if (!uebergang) return;
          var merker = vormerker();
          if (!merker || reduziert()) {
            uebergang.skipTransition();
            return;
          }
          // Wohin die Navigation geht, steht in der Navigation-API. Die
          // gibt es nicht in jedem Browser — fehlt sie, bleibt ziel null
          // und es wird hier nicht geprueft. Die ankommende Seite prueft
          // es ohnehin noch einmal.
          var ziel = pfadVon(e.activation && e.activation.entry && e.activation.entry.url);
          if (ziel && merker.ziel !== ziel) {
            // Vormerker von einem abgebrochenen Wechsel. Weg damit,
            // sonst animiert der naechste beliebige Klick.
            vergessen();
            uebergang.skipTransition();
            return;
          }
          document.documentElement.dataset.sprachRichtung = merker.richtung;
        });

        // Ankommende Seite. Hier wird der Vormerker geloescht: er hat
        // seinen Zweck erfuellt, und beim Zurueckblaettern soll er nicht
        // ein zweites Mal greifen.
        window.addEventListener('pagereveal', function (e) {
          var uebergang = e.viewTransition;
          if (!uebergang) return;
          var merker = vormerker();
          vergessen();
          if (!merker || merker.ziel !== location.pathname || reduziert()) {
            uebergang.skipTransition();
            return;
          }
          var html = document.documentElement;
          html.dataset.sprachRichtung = merker.richtung;
          // then(f, f) statt finally: finished wird abgelehnt, wenn der
          // Uebergang abgebrochen wird, und finally wuerfe die Ablehnung
          // weiter — als unbehandelte Ablehnung in der Konsole.
          var aufraeumen = function () {
            delete html.dataset.sprachRichtung;
          };
          uebergang.finished.then(aufraeumen, aufraeumen);
        });

        // Die verlassende Seite behaelt ihr Richtungs-Merkmal, weil der
        // alte Schnappschuss es fuer seine Animation braucht. Landet sie
        // im Vor-Zurueck-Zwischenspeicher, kommt sie damit spaeter
        // wieder hervor — und der naechste Klick von dort waere
        // animiert, ohne ein Sprachwechsel zu sein.
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) delete document.documentElement.dataset.sprachRichtung;
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-ts-bg text-ts-fg">
    <TopBar />
    {!hideThemeToggle && <SiteThemeToggle />}
    {/* Rendert sich selbst nur, wenn es eine Gegenseite gibt. Kein
        Ausblenden per Bedingung hier — die Entscheidung gehoert in die
        Routen-Tabelle, nicht ins Layout. */}
    <SiteLangToggle />
    <slot />
    <script>
      // Site-weiter Scroll-Reveal: alle [data-reveal] Elemente werden
      // beim Eintritt in den Viewport (15% sichtbar) eingefadet. Pro
      // Callback-Batch wird ein 100ms-Stagger zwischen den Elementen
      // gelegt, damit gleichzeitig sichtbar werdende Blöcke nicht
      // synchron, sondern leicht versetzt erscheinen. Initialisiert
      // bei DOMContentLoaded — Full-Page-Reloads triggern das Event
      // bei jeder Navigation neu, kein Astro-Event nötig.
      function setupReveal() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // Reduced-Motion: Elemente bleiben sichtbar via CSS-Override.
          return;
        }

        const targets = document.querySelectorAll<HTMLElement>(
          '[data-reveal]:not(.is-revealed)'
        );
        if (targets.length === 0) return;

        const observer = new IntersectionObserver(
          (entries, obs) => {
            const intersecting = entries.filter((e) => e.isIntersecting);
            intersecting.forEach((entry, i) => {
              const el = entry.target as HTMLElement;
              // Stagger cap: Math.min(i, 4) * 60ms → maximal 240ms
              // Verzoegerung. Vorher: i * 100 unbounded — bei 6+
              // gleichzeitig intersect'ing Elementen (schneller Scroll
              // durch Section 4/7) sah User das letzte Element mit
              // 500ms+ Delay erscheinen, was auf ProMotion 120Hz
              // als "traege" empfunden wird.
              el.style.transitionDelay = Math.min(i, 4) * 60 + 'ms';
              el.classList.add('is-revealed');
              obs.unobserve(el);
            });
          },
          {
            threshold: 0.15,
            rootMargin: '0px 0px -5% 0px',
          }
        );

        targets.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReveal);
      } else {
        setupReveal();
      }

      // === Section-BG-Aware CTA-Button ===
      // Setzt body[data-current-bg="cream"|"dark"] basierend auf welche
      // Section aktuell im Viewport-Mid liegt. Die TopBar-CTA passt sich
      // per CSS an (dark solid Button auf cream Sections statt amber
      // pulse). IO mit narrow rootMargin (-45% top/bottom = 10%-Slice in
      // Viewport-Mitte) triggert nur wenn Section durch die Mitte scrollt.
      //
      // Ownership-Trennung mit Section 5:
      // - IO schreibt NUR 'cream' (nie 'dark') — Section 5's Script owns
      //   die dark-Transition via horizon-progress Hysteresis, damit der
      //   Button beim Rueckscrollen NICHT zu frueh amber wird bevor die
      //   dark-Overlays wieder komplett zurueck sind.
      // - Exception: bei prefers-reduced-motion laeuft Section 5's Script
      //   nicht (kein scroll listener) → IO uebernimmt dann auch dark.
      function setupBgSwitcher() {
        const creamSections = document.querySelectorAll<HTMLElement>('[data-section-bg="cream"]');
        if (creamSections.length === 0) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const intersectingState = new Map<Element, boolean>();
        creamSections.forEach((s) => intersectingState.set(s, false));

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              intersectingState.set(entry.target, entry.isIntersecting);
            });
            const anyCreamVisible = Array.from(intersectingState.values()).some((v) => v);
            if (anyCreamVisible) {
              document.body.dataset.currentBg = 'cream';
            } else if (reducedMotion) {
              // Section 5's Script laeuft in reduced-motion nicht — IO
              // muss dark selbst schreiben, sonst haengt Body auf 'cream'
              // fest wenn User zurueckscrollt.
              document.body.dataset.currentBg = 'dark';
            }
            // Sonst: nichts schreiben. Section 5 owns dark via horizon.
          },
          { rootMargin: '-45% 0px -45% 0px' }
        );

        creamSections.forEach((s) => io.observe(s));
        // Initial: default zu 'dark' (falls Landing gestartet oben)
        if (!document.body.dataset.currentBg) {
          document.body.dataset.currentBg = 'dark';
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupBgSwitcher);
      } else {
        setupBgSwitcher();
      }
</script>
  </body>
</html>
