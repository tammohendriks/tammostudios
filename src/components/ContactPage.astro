---
/**
 * Kontakt-Seite mit Kontaktformular (POST /api/kontakt via Resend).
 *
 * Hier stand mal zusaetzlich ein Cal.com-Kalender zum Buchen eines
 * Erstgespraechs. Der ist raus: zwei Wege zum selben Ziel haben mehr
 * verwirrt als geholfen. Damit setzt die Seite jetzt ueberhaupt keine
 * Cookies mehr — der Datenschutz-Hinweis in der Fussleiste und
 * Abschnitt 5 der Datenschutzerklaerung sagen das entsprechend.
 *
 * Liegt als Komponente und nicht als Seite in src/pages, weil es zwei
 * Routen darauf gibt: /kontakt und /en/contact. Markup und der
 * <style>-Block gehoeren dabei zusammen — Astro bindet die Regeln an
 * eine Kennung der Komponente, und waere nur eines von beiden
 * umgezogen, griffe kein einziger Selektor mehr.
 *
 * Struktur:
 *   1. Hero — Headline + Einladung
 *   2. Kontaktformular (NEU, primaer)
 *   3. Alternative Kontakte — Telefon/Email/Instagram-Cards
 *   4. Was im Erstgespraech passiert — 4-Schritte Prep-Info
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from './SubPageBackground.astro';
import SiteFooter from './SiteFooter.astro';
import { SITE, PHONE_INTERNATIONAL } from '../lib/constants';
import { localeOf, pathOr } from '../lib/routes.mjs';
import { KONTAKT } from '../lib/i18n/seiten/kontakt';
import type { Gleichlang } from '../lib/i18n/shape';

const locale = localeOf(Astro.url.pathname);
const k = KONTAKT[locale];


// Diese Werte gehen so an die API und werden dort gegen ein Enum
// geprueft — sie sind sprachunabhaengig. Uebersetzt wird nur die
// Beschriftung, in derselben Reihenfolge. Haette die englische Liste
// andere Werte, kaeme von der API eine Validierungsmeldung und niemand
// wuesste, warum.
// satisfies Gleichlang<...> bindet die Laenge an die Beschriftungen im
// Woerterbuch. Vorher stand diese Zusicherung nur im Kommentar darueber:
// ein sechster Eintrag im Woerterbuch haette eine Auswahl mit leerer
// Beschriftung ergeben und die Vorbelegung des Nachrichtenfeldes
// lautlos ausfallen lassen.
const ANLIEGEN_WERTE = [
  'website-projekt',
  'online-shop',
  'wartung-support',
  'allgemein',
  'anderes',
] as const satisfies Gleichlang<typeof KONTAKT.de.anliegen, string>;

const subjectOptions = ANLIEGEN_WERTE.map((value, i) => ({ value, label: k.anliegen[i] }));

// Was das Formular-Skript braucht. Ein <script> ohne is:inline wird von
// Astro gebuendelt und laeuft im Browser — es sieht das Frontmatter
// nicht. Die Texte gehen deshalb als JSON durchs DOM. define:vars waere
// der andere Weg, macht das Skript aber inline und damit untypisiert.
const skriptTexte = {
  vorlagen: Object.fromEntries(ANLIEGEN_WERTE.map((value, i) => [value, k.vorlagen[i]])),
  sendenLaeuft: k.formular.sendenLaeuft,
  fehler: k.formular.fehler,
};
// Ein '<' im Text koennte den script-Block beenden. Kommt in den Texten
// nicht vor, kostet als Absicherung aber nichts.
const skriptTexteJson = JSON.stringify(skriptTexte).replace(/</g, '\\u003c');
---

<BaseLayout
  pageTitle={k.meta.pageTitle}
  title={k.meta.title}
  description={k.meta.description}
>
  <main class="kontakt-page">
    <SubPageBackground />

    <header class="kontakt-hero">
      <h1 class="subpage-hero-title">{k.hero.headline}</h1>
      <p class="subpage-hero-subtitle text-lines">{k.hero.sub}</p>
    </header>

    <!-- ================================================================
         KONTAKTFORMULAR (primary CTA)
         POST → /api/kontakt (siehe src/pages/api/kontakt.ts)
         ============================================================== -->
    <section class="kontakt-form-section" data-reveal aria-label={k.formular.label}>
      <form
        class="kontakt-form"
        id="kontakt-form"
        novalidate
        autocomplete="on"
      >
        <div class="form-row">
          <div class="form-field">
            <label for="kontakt-name">{k.formular.name} <span class="req" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="kontakt-name"
              name="name"
              required
              minlength="2"
              autocomplete="name"
              placeholder={k.formular.platzhalterName}
            />
          </div>
          <div class="form-field">
            <label for="kontakt-email">{k.formular.email} <span class="req" aria-hidden="true">*</span></label>
            <input
              type="email"
              id="kontakt-email"
              name="email"
              required
              autocomplete="email"
              placeholder={k.formular.platzhalterEmail}
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <label for="kontakt-phone">{k.formular.telefon} <span class="req" aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="kontakt-phone"
              name="phone"
              required
              minlength="6"
              autocomplete="tel"
              placeholder={k.formular.platzhalterTelefon}
            />
          </div>
          <div class="form-field">
            <label for="kontakt-company">{k.formular.firma} <span class="opt">{k.formular.optional}</span></label>
            <input
              type="text"
              id="kontakt-company"
              name="company"
              autocomplete="organization"
              placeholder={k.formular.platzhalterFirma}
            />
          </div>
        </div>

        <div class="form-field">
          <label for="kontakt-subject">{k.formular.anliegen} <span class="req" aria-hidden="true">*</span></label>
          <select id="kontakt-subject" name="subject" required>
            {subjectOptions.map((opt) => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>

        <div class="form-field">
          <label for="kontakt-message">{k.formular.nachricht} <span class="req" aria-hidden="true">*</span></label>
          <textarea
            id="kontakt-message"
            name="message"
            required
            minlength="20"
            rows="8"
          ></textarea>
        </div>

        <!-- Honeypot — hidden via CSS, sichtbar fuer Bots. Server-Route
             checkt: wenn ausgefuellt → 200 zurueck ohne Mail. -->
        <div class="hp-field" aria-hidden="true">
          <label for="kontakt-website">{k.formular.honeypot}</label>
          <input
            type="text"
            id="kontakt-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="form-field form-checkbox">
          <input
            type="checkbox"
            id="kontakt-datenschutz"
            name="datenschutz"
            required
          />
          <label for="kontakt-datenschutz">
            {k.formular.datenschutzVor}<a href={pathOr('datenschutz', locale)}
              >{k.formular.datenschutzLink}</a
            >{k.formular.datenschutzNach}
            <span class="req" aria-hidden="true">*</span>
          </label>
        </div>

        {/* Ohne hidden: ein Live-Bereich muss im Baum stehen, BEVOR
            Text darin erscheint, sonst sagt eine Sprachausgabe nichts.
            Vorher wurde er aus hidden heraus eingeblendet und im selben
            Durchlauf gefuellt — die Ansage war Glueckssache. Leer nimmt
            er keinen Platz ein, siehe .form-status:empty. */}
        <div
          class="form-status"
          id="kontakt-status"
          role="status"
          aria-live="polite"
        ></div>

        <button type="submit" class="form-submit" id="kontakt-submit">
          <span class="form-submit-label">{k.formular.senden}</span>
        </button>
      </form>

      <!-- Success-State wird per JS gefuellt + eingeblendet nach 200. -->
      {/* tabindex="-1", damit das Skript den Fokus hierher setzen kann.
          Beim Absenden verschwindet das Formular samt fokussiertem
          Knopf; ohne diesen Schritt landet der Fokus am Seitenanfang und
          die Bestaetigung wird nicht vorgelesen. */}
      <div class="form-success" id="kontakt-success" tabindex="-1" hidden>
        <span class="form-success-icon" aria-hidden="true">✓</span>
        <h2 class="form-success-headline">{k.formular.dankeTitel}</h2>
        <p class="form-success-body">{k.formular.dankeText}</p>
      </div>
    </section>

    <!-- ================================================================
         Alternative Kontakte
         ============================================================== -->
    <section class="kontakt-alternatives">
      <p class="kontakt-eyebrow" data-reveal>{k.alternativen.eyebrow}</p>
      <div class="contact-cards">
        <a class="contact-card" data-reveal href={SITE.phoneHref}>
          <span class="contact-card-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
            </svg>
          </span>
          <span class="contact-card-label">{k.alternativen.telefon}</span>
          <span class="contact-card-value">
            {locale === 'en' ? PHONE_INTERNATIONAL : SITE.phone}
          </span>
        </a>

        <a class="contact-card" data-reveal href={`mailto:${SITE.email}`}>
          <span class="contact-card-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </span>
          <span class="contact-card-label">{k.alternativen.email}</span>
          <span class="contact-card-value">{SITE.email}</span>
        </a>

        <a class="contact-card" data-reveal href="https://www.instagram.com/tammostudios/" target="_blank" rel="noopener noreferrer me">
          <span class="contact-card-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="contact-card-label">{k.alternativen.instagram}</span>
          <span class="contact-card-value">@tammostudios</span>
        </a>
      </div>
    </section>

    <!-- ================================================================
         Was im Erstgespraech passiert — Prep-Info
         ============================================================== -->
    <section class="kontakt-prep">
      <h2 class="kontakt-prep-headline" data-reveal>{k.ablauf.headline}</h2>
      <ol class="prep-list">
        {k.ablauf.schritte.map((step) => (
          <li data-reveal>
            <span class="prep-list-text">{step}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Texte fuer den Formular-Controller weiter unten. Siehe
         skriptTexte im Frontmatter. -->
    <script type="application/json" id="kontakt-texte" set:html={skriptTexteJson}></script>
  </main>

  <SiteFooter />
</BaseLayout>

<!-- ==================================================================
     FORM-CONTROLLER — Reactive Placeholder + Submit-Handler
     ================================================================== -->
<script>
  // Die Texte kommen aus dem JSON-Block, den die Komponente in der
  // Sprache der Seite gerendert hat. Dieses Skript wird gebuendelt und
  // sieht das Frontmatter nicht.
  //
  // Hier stehen BEWUSST keine deutschen Rueckfall-Texte: das waere ein
  // zweiter Ort fuer dieselben Saetze, und auf der englischen Seite
  // stuende im Fehlerfall ploetzlich Deutsch. Bleiben die Texte leer,
  // sendet das Formular weiterhin — nur ohne Vorbelegung, und die
  // Fehlermeldung kommt dann von der API, die ihre Meldungen selbst in
  // der richtigen Sprache liefert.
  type FormularTexte = {
    vorlagen: Record<string, string>;
    sendenLaeuft: string;
    fehler: string;
  };
  const texteEl = document.getElementById('kontakt-texte');
  let texte: FormularTexte = { vorlagen: {}, sendenLaeuft: '…', fehler: '' };
  try {
    if (texteEl?.textContent) texte = JSON.parse(texteEl.textContent) as FormularTexte;
  } catch (err) {
    console.error('[kontakt-form] Texte nicht lesbar:', err);
  }

  // Vorbelegung des Nachrichtenfeldes pro Anliegen. Wird beim
  // <select>-change auf das <textarea> gesetzt — aber NUR wenn die
  // Textarea noch leer ist, sonst uebermalen wir User-Input.
  const PLACEHOLDERS: Record<string, string> = texte.vorlagen;

  const form = document.getElementById('kontakt-form') as HTMLFormElement | null;
  const subjectSelect = document.getElementById('kontakt-subject') as HTMLSelectElement | null;
  const messageArea = document.getElementById('kontakt-message') as HTMLTextAreaElement | null;
  const statusEl = document.getElementById('kontakt-status') as HTMLElement | null;
  const submitBtn = document.getElementById('kontakt-submit') as HTMLButtonElement | null;
  const submitLabel = submitBtn?.querySelector('.form-submit-label') as HTMLElement | null;
  const successEl = document.getElementById('kontakt-success') as HTMLElement | null;

  // Die Beschriftung des Knopfes steht schon im Markup, in der richtigen
  // Sprache. Nach einem Fehlversuch wird genau sie wieder eingesetzt,
  // statt sie ein zweites Mal irgendwo zu hinterlegen.
  const knopfBeschriftung = submitLabel?.textContent ?? '';

  // Textarea VORFUELLEN mit Template (nicht nur als placeholder) — User
  // kann seine Infos direkt in die eckigen [Klammern] tippen statt
  // von leerem Feld zu starten. Beim Select-Wechsel wird das Template
  // ausgetauscht — aber NUR wenn User noch nix editiert hat (value
  // matched noch das zuletzt gesetzte Template). Sobald User etwas
  // aendert, bleibt sein Text stehen.
  //
  // Referenz-Wert wird in `lastTemplate` gespeichert. Nach jedem Setzen
  // updaten. Beim Submit werden die Templates NICHT gefiltert — falls
  // User einfach ohne Editing sendet, kommt der Template-Text mit
  // [Klammer]-Platzhaltern bei Tammo an, der dann rueckfragen kann.
  let lastTemplate = '';
  if (subjectSelect && messageArea) {
    lastTemplate = PLACEHOLDERS[subjectSelect.value] ?? '';
    messageArea.value = lastTemplate;

    subjectSelect.addEventListener('change', () => {
      const val = subjectSelect.value;
      const newTemplate = PLACEHOLDERS[val] ?? '';
      // Nur austauschen wenn User das aktuelle Template noch nicht
      // editiert hat (oder Textarea manuell geleert hat).
      if (messageArea.value === lastTemplate || messageArea.value.trim() === '') {
        messageArea.value = newTemplate;
        lastTemplate = newTemplate;
      }
    });
  }

  const setStatus = (msg: string, kind: 'error' | 'info' | '' = '') => {
    if (!statusEl) return;
    // Kein hidden mehr: der Bereich bleibt stehen, nur sein Inhalt
    // wechselt. Das ist der Unterschied zwischen einer Ansage, die
    // ankommt, und einer, die manchmal ankommt.
    statusEl.textContent = msg;
    statusEl.dataset.kind = msg ? kind : '';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !submitLabel) return;

    // HTML5 validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Serialize form → JSON
    const fd = new FormData(form);
    const payload: Record<string, unknown> = {};
    fd.forEach((value, key) => {
      payload[key] = value;
    });
    // Checkbox: FormData enthaelt nur checked keys als 'on' — konvertieren
    payload.datenschutz = (document.getElementById('kontakt-datenschutz') as HTMLInputElement)?.checked;
    // Sprache der Seite. Die API richtet ihre Fehlermeldungen und die
    // Bestaetigungsmail danach, und die Benachrichtigung an Tammo
    // bekommt bei 'en' einen Hinweis. Das lang-Attribut setzt das
    // BaseLayout aus dem Pfad — dieselbe Quelle wie fuer alles andere.
    payload.locale = document.documentElement.lang === 'en' ? 'en' : 'de';

    // Loading state
    submitBtn.disabled = true;
    submitLabel.textContent = texte.sendenLaeuft;
    setStatus('', '');

    try {
      const res = await fetch('/api/kontakt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { success: boolean; error?: string };

      if (res.ok && data.success) {
        // Success: Formular ausblenden, Success-State zeigen
        form.hidden = true;
        if (successEl) successEl.hidden = false;
        // Scroll zum Success-Panel damit User Feedback sieht. Bei
        // reduzierter Bewegung ohne Animation — 'smooth' ist genau die
        // Art Bewegung, die damit abgewaehlt wird.
        const sanft = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        successEl?.scrollIntoView({
          behavior: sanft ? 'smooth' : 'auto',
          block: 'center',
        });
        // Und den Fokus hinterher. Der lag auf dem Absende-Knopf, der
        // gerade mit dem Formular verschwunden ist — ohne diesen Schritt
        // sitzt er am Seitenanfang und die Bestaetigung bleibt
        // ungelesen. preventScroll, damit das sanfte Scrollen oben nicht
        // von einem harten Sprung ueberholt wird.
        successEl?.focus({ preventScroll: true });
      } else {
        setStatus(data.error || texte.fehler, 'error');
        submitBtn.disabled = false;
        submitLabel.textContent = knopfBeschriftung;
      }
    } catch (err) {
      console.error('[kontakt-form] submit error:', err);
      setStatus(texte.fehler, 'error');
      submitBtn.disabled = false;
      submitLabel.textContent = knopfBeschriftung;
    }
  });
</script>

<style>
  .kontakt-page {
    min-height: calc(100vh - 200px);
    background: #050507;
    padding: 140px 40px 100px;
    position: relative;
    overflow: hidden;
  }

  .kontakt-page > *:not(:first-child) {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  /* === Hero === */
  .kontakt-hero {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 60px;
    padding-top: 32px;
    position: relative;
    z-index: 1;
  }

  .kontakt-hero .subpage-hero-title {
    margin-bottom: 20px;
  }

  /* === Kontaktformular === */
  .kontakt-form-section {
    margin: 0 auto 72px;
    max-width: 720px;
    padding: 32px;
    background: rgba(15, 15, 18, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.28);
  }

  @media (max-width: 640px) {
    .kontakt-form-section {
      padding: 24px 20px;
    }
  }

  .kontakt-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-field label {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(245, 245, 244, 0.85);
  }

  .form-field label .req {
    color: rgba(245, 158, 11, 0.95);
    margin-left: 2px;
  }
  .form-field label .opt {
    color: rgba(245, 245, 244, 0.4);
    font-weight: 400;
    margin-left: 4px;
  }

  .form-field input[type='text'],
  .form-field input[type='email'],
  .form-field input[type='tel'],
  .form-field select,
  .form-field textarea {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 12px 14px;
    background: rgba(10, 10, 12, 0.6);
    color: #f5f5f4;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    outline: none;
    transition: border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .form-field input:hover,
  .form-field select:hover,
  .form-field textarea:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  .form-field input:focus-visible,
  .form-field select:focus-visible,
  .form-field textarea:focus-visible {
    border-color: rgba(245, 158, 11, 0.6);
    background: rgba(10, 10, 12, 0.85);
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: rgba(245, 245, 244, 0.35);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 180px;
    font-family: 'Inter', sans-serif;
  }

  .form-field select {
    /* Custom-chevron via SVG-BG damit's mit dem dark theme matched.
       -webkit-appearance:none oben killed die native chevron. */
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='rgba(245,158,11,0.85)' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 40px;
    cursor: pointer;
  }

  /* Honeypot — CSS-only hidden, aber DOM-mässig da fuer Bots */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Datenschutz-Checkbox: horizontal layout, larger click area */
  .form-checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    padding: 4px 0;
  }

  .form-checkbox input[type='checkbox'] {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: rgba(245, 158, 11, 0.95);
    cursor: pointer;
  }

  .form-checkbox label {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(245, 245, 244, 0.75);
    font-weight: 400;
    cursor: pointer;
  }

  .form-checkbox label a {
    color: rgba(245, 158, 11, 0.95);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .form-checkbox label a:hover {
    color: rgba(252, 211, 77, 1);
  }

  /* Status-Message (Fehler) */
  .form-status {
    padding: 12px 16px;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
  }
