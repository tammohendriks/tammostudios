---
// Template fuer die 3 Vertical Landing Pages (webdesign-handwerk /
// -praxis / -gastronomie). Nimmt eine Vertical-Config aus
// src/lib/verticals.ts entgegen und rendert die komplette Seite.
//
// Sections in Reihenfolge:
//   1. Hero            — Full-Bleed Background-Image + Dark Gradient +
//                        Eyebrow + Multi-Line Headline (mit Highlight-
//                        Span + SVG-Underline) + Subheadline + CTA
//   2. Intro           — Kurzabsatz, mit \n-Zeilenumbruechen (pre-line)
//   3. Checklist       — 5-7 Punkte mit Amber Check-Icons
//   4. Pricing         — Preisblock, matched /preise Styling
//   5. Case Study      — Bild(er) + Text + Live-Link
//   6. FAQ             — <details>/<summary> Accordions
//   7. Final CTA       — Klarer Abschluss mit CTA
//
// CTA-Links zeigen auf /kontakt (Formular + alternative Kontakte).
// Kein Modal mehr — direkter Seiten-Wechsel.
//
// FAQ-Section bekommt zusaetzlich FAQPage JSON-LD via additionalSchema.
// NICHT fuer Rich Snippets: die hat Google 2023 auf Behoerden- und
// Gesundheitsseiten beschraenkt, eine Freelancer-Seite bekommt sie
// nicht. Das Markup bleibt trotzdem — es beschreibt den Inhalt korrekt
// und wird von anderen Diensten gelesen. Der Kommentar stand hier mal
// anders und hat etwas versprochen, was nicht mehr eintritt.

import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import ClosingCta from './ClosingCta.astro';
import { t } from '../lib/i18n';
import { localeOf, path, pathOr } from '../lib/routes.mjs';
import { getVertical, type VerticalSlug } from '../lib/verticals.i18n';
import QuizModal from './QuizModal.astro';
import Kundenstimmen from './Kundenstimmen.astro';
import { SKIZZE } from '../lib/i18n/seiten/skizze';
import { SITE, PHONE_INTERNATIONAL } from '../lib/constants';
import { REFERENCES } from '../lib/references';
import { ANGEBOTE } from '../lib/angebote';
import { subtitleFor } from '../lib/references.en';
import Projektslots from './Projektslots.astro';
import UeberMich from './UeberMich.astro';
import Angebotskarte from './Angebotskarte.astro';
import AbschlussSkizze from './AbschlussSkizze.astro';
import FuenfSekunden from './FuenfSekunden.astro';
import Ablauf from './Ablauf.astro';
import Hochzaehlen from './Hochzaehlen.astro';
import SchwebenderCta from './SchwebenderCta.astro';
import { UMBAU_AKTIV, type SkizzeBranche } from '../lib/skizze';

export interface Props {
  /**
   * Welche Branche. Die Sprache steht NICHT in den Props: die liest die
   * Komponente aus dem Pfad. Sonst muesste jede Seite ihre eigene
   * Sprache nochmal nennen, und eine englische Seite koennte
   * versehentlich die deutschen Texte anfordern.
   */
  slug: VerticalSlug;
}

const { slug } = Astro.props;

const d = t(Astro.url.pathname);
const locale = localeOf(Astro.url.pathname);

const vertical = getVertical(slug, locale);
// Der Typ laesst nur die drei bekannten Slugs zu, der Fall kann also
// nicht eintreten. Ein Abbruch mit Grund ist trotzdem besser als ein
// nicht-null-Ausrufezeichen, das im Fehlerfall nur "undefined is not an
// object" liefert.
if (!vertical) throw new Error(`Unbekannte Branche: ${slug}`);

// Die Preisseite und die Software-Seite gibt es nicht zwangslaeufig in
// der Sprache dieser Seite. Solange nicht, faellt der Verweis darauf
// weg: ein englischer Linktext, der auf eine deutsche Seite fuehrt, ist
// schlechter als kein Link. pathOr() waere hier also falsch.
const preisePfad = path('preise', locale);
const softwarePfad = path('software', locale);

// FAQPage Schema fuer Rich-Snippets in Google.
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: vertical.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

/**
 * Das Angebot DIESER Seite als eigene Entitaet.
 *
 * Die Startseite beschreibt ueber BaseLayout den Betrieb samt
 * Leistungskatalog. Das beantwortet aber nicht, was auf DIESER Seite
 * zu welchem Preis angeboten wird — und genau danach fragt eine
 * Suchmaschine bei einer Branchenseite. provider zeigt per @id auf
 * denselben Betrieb, Google fuehrt beides zusammen.
 *
 * Der Preis kommt aus lib/angebote.ts, also aus derselben Quelle wie
 * die Karte auf der Seite. Zwei Zahlen, die auseinanderlaufen
 * koennen, waeren hier besonders teuer: eine falsche Angabe in
 * strukturierten Daten ist eine Zusage an die Suchmaschine.
 */
const seitenUrl = `${SITE.url}${Astro.url.pathname.replace(/\/$/, '')}`;
const dienstSchema = {
  '@type': 'Service',
  '@id': `${seitenUrl}#dienst`,
  name: vertical.meta.title,
  description: vertical.meta.description,
  serviceType: locale === 'en' ? 'Web design' : 'Webdesign',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: {
    '@type': 'Country',
    name: locale === 'en' ? 'Germany' : 'Deutschland',
  },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: SKIZZE[locale as 'de' | 'en'].seo.zielgruppe[slug as SkizzeBranche],
  },
  offers: {
    '@type': 'Offer',
    price: String(ANGEBOTE[slug as SkizzeBranche]?.preis ?? ''),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: seitenUrl,
  },
};

// Amber Check-Icon fuer Checklist-Items (matched /preise-Style).
const checkIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="rgba(245, 158, 11, 0.6)" stroke-width="1.5"/><path d="M8 12.5L11 15.5L16 9" stroke="rgba(245, 158, 11, 1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// Hero-Focal-Point fuer object-position (default center center).
// Ohne Foto baut die Komponente den Hintergrund selbst. Ein fremdes
// Stockfoto waere schlechter als keines: es verspricht eine Naehe zur
// Branche, die nicht da ist.
const heroBild = vertical.hero.background?.image;
const heroFocalPoint = vertical.hero.background?.focalPoint ?? 'center center';

/**
 * Der Name der Seite fuer die Scheinleiste des Browser-Rahmens.
 *
 * Aus der URL abgeleitet statt im Datensatz gepflegt: so kann die
 * Leiste gar nicht erst etwas anderes anzeigen als der Verweis
 * darunter aufruft.
 */
const hostVon = (url: string): string => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};

/**
 * Was ueber eine Referenz sonst noch bekannt ist.
 *
 * verticals.ts kennt pro Referenz nur Name, Bild und Adresse.
 * references.ts kennt dazu die Unterzeile („Arbeitsmedizinische
 * Praxis“) und die eingesetzte Technik. Beides steht laengst da und
 * macht aus einem nackten Screenshot eine Angabe. Verknuepft ueber den
 * Hostnamen, nicht ueber die Zeichenkette: in verticals.ts steht mal
 * mit und mal ohne www.
 */
/**
 * Die Fallstudie hatte als einziger Abschnitt keine Ueberschrift:
 * Augenbraue (12px) und direkt Fliesstext (16px), waehrend ueberall
 * sonst eine 34px-Zeile dazwischen steht. Der Abschnitt fiel dadurch
 * aus der Ordnung — genau so gemeldet.
 *
 * Beide Teile stecken schon in der bestehenden Zeile
 * („AUS DER PRAXIS — SAMEDOS + IBI", englisch mit Doppelpunkt). Der
 * vordere Teil wird die Augenbraue; die Ueberschrift kommt aus den
 * Namen der Referenzen selbst, damit sie richtig geschrieben ist und
 * nicht in Grossbuchstaben schreit.
 */
// --- Suchbegriffe in den Ueberschriften -------------------------------
//
// Google gewichtet Ueberschriften. „Haeufige Fragen" und
// „Samedos + IBI" sind gute Zeilen, in denen kein Begriff steht, nach
// dem jemand sucht. Die Zeilen bleiben, bekommen aber den
// Branchenbegriff dazu.
const seo = SKIZZE[locale as 'de' | 'en'].seo;
const seoWort = seo.wort[slug as SkizzeBranche];
const seoFuerWen = seo.fuerWen[slug as SkizzeBranche];
const faqTitel = seo.faqTitel.replace('{wort}', seoWort);

const fallstudieBraue = (() => {
  const roh = vertical.caseStudy?.eyebrow ?? '';
  const m = roh.match(/^(.*?)(?:\s—\s|:\s)/);
  return m ? m[1] : roh;
})();
const fallstudieTitel = seo.fallstudieTitel
  .replace('{fuerWen}', seoFuerWen)
  .replace(
    '{namen}',
    (vertical.caseStudy?.references ?? []).map((r) => r.name).join(' + ')
  );

const refInfo = (url: string) => {
  const host = hostVon(url);
  const treffer = REFERENCES.find((r) => hostVon(r.url) === host);
  if (!treffer) return null;
  return {
    unterzeile: subtitleFor(treffer, locale as 'de' | 'en'),
    technik: treffer.tags,
  };
};

// --- Umbau fuer bezahlte Werbung ---------------------------------------
//
// Die neuen Teile erscheinen nur auf den Seiten, die in UMBAU_AKTIV
// stehen. Alles andere bleibt unveraendert — eine Branche kommt dazu,
// indem ihr Name dort eingetragen wird.
const sk = SKIZZE[locale as 'de' | 'en'];
const umgebaut = UMBAU_AKTIV.includes(slug as SkizzeBranche);

// Den Scroll-Moment gibt es nur fuer Branchen, fuer die eigene Fragen
// hinterlegt sind. Wo nicht, bleibt der Intro-Absatz stehen — er sagt
// dasselbe, nur ohne Inszenierung, und erfundene Fragen fuer eine
// andere Branche waeren schlechter als keine.
const ersteSekundenAlle: Partial<Record<SkizzeBranche, unknown>> =
  SKIZZE[locale as 'de' | 'en'].ersteSekunden;
const hatFuenfSekunden = umgebaut && Boolean(ersteSekundenAlle[slug as SkizzeBranche]);

// Der zweite Weg aus dem Hero geht ans Telefon, nicht auf /kontakt.
// Die Seite ist das Ziel bezahlter Anzeigen: ein Verweis auf eine
// andere Seite kostet den Klick und gibt dafuer ein weiteres Formular
// zurueck. Ein Anruf ist eine fertige Anfrage.
const telefonAnzeige = locale === 'en' ? PHONE_INTERNATIONAL : SITE.phone;
const telefonLink = `tel:${PHONE_INTERNATIONAL.replace(/\s/g, '')}`;

---

<BaseLayout
  pageTitle={vertical.meta.title}
  description={vertical.meta.description}
  additionalSchema={umgebaut ? [faqSchema, dienstSchema] : faqSchema}
>
  <main class:list={['vertical-page', umgebaut && 'ist-umgebaut']}>
    <!-- HERO: Full-Bleed BG-Image (CSS background-image, 100dvh) + Dark
         Gradient-Scrim + fette Typo mit Text-Shadow fuer Punch. Bild
         wird ueber CSS-Custom-Property injiziert damit Astro-Scoped
         CSS clean bleibt. Preload-Link im <head> haetten wir gerne
         auch fuer LCP, wird aber ueber BaseLayout nicht exponiert —
         bleibt Nice-to-have. -->
    <header
      class="v-hero"
      data-ohne-bild={heroBild ? undefined : ''}
      style={heroBild ? `--hero-image: url('${heroBild}'); --hero-focal: ${heroFocalPoint};` : undefined}
    >
      <div class="v-hero-content">
        {umgebaut && <Projektslots />}
        {/* Auf den umgebauten Seiten faellt sie weg: darueber steht
            schon der Projektstart-Block, und zwei kleine Zeilen
            uebereinander vor der Ueberschrift verzoegern nur den
            Blick auf das, worum es geht. */}
        {!umgebaut && <p class="v-eyebrow v-hero-eyebrow">{vertical.hero.eyebrow}</p>}
        <h1 class="v-hero-title">
          {vertical.hero.headlineLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.highlight ? (
                <span class="hero-highlight">
                  {line.text}
                  <svg
                    class="hero-highlight-underline"
                    viewBox="0 0 200 12"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    {/* KEIN pathLength und kein stroke-dasharray mehr.
                        Beides zusammen mit vector-effect war der
                        Grund, warum der Strich in der Mitte eine
                        Luecke hatte: die Normierung rechnet in
                        viewBox-Einheiten, non-scaling-stroke zeichnet
                        das Muster aber in Bildschirmpixeln. Bei einem
                        575 px breiten Wort wurde daraus Strich 194 px,
                        Luecke 194 px, Strich 194 px. Gezeichnet wird
                        jetzt per clip-path, siehe CSS. */}
                    <path
                      d="M 3 6.5 C 50 3.2, 150 8.8, 197 5.5"
                      vector-effect="non-scaling-stroke"
                    />
                  </svg>
                </span>
              ) : (
                line.text
              )}
            </>
          ))}
        </h1>
        <p class="v-hero-subtitle text-lines">{vertical.hero.subheadline}</p>
        <div class="v-hero-cta">
          {umgebaut ? (
            <>
              {/* Ein Knopf, kein Link: das Ziel ist kein Dokument,
                  sondern ein Dialog auf derselben Seite. Als <a href="#">
                  stuende im Verlauf ein Eintrag, der nirgendwohin
                  fuehrt, und Vorleseprogramme kuendigten einen
                  Seitenwechsel an, der nicht kommt. */}
              <button type="button" class="cta-orbital" data-skizze-oeffnen>
                <span>{sk.hero.cta}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </button>
              {/* Bewusst leiser und bewusst vorhanden: wer lieber redet
                  als tippt, braucht einen Weg, der nicht durch sechs
                  Schritte fuehrt. */}
              <a class="cta-link v-hero-cta-zweit" href={telefonLink}>
                {sk.hero.ctaZweit}
                <span class="v-hero-nummer">{telefonAnzeige}</span>
              </a>
            </>
          ) : (
            <a class="cta-orbital" href={pathOr('kontakt', locale)}>
              <span>{d.branche.erstgespraech}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          )}
        </div>

        {umgebaut && (
          /* Keine Doppelung des Abschluss-Blocks: der verspricht
             Reaktion (Antwort < 24 h, Erstgespraech gratis, DE & EN),
             hier stehen die geschaeftlichen Zusagen. */
          <ul class="v-zusagen">
            {sk.hero.vertrauen.map((punkt) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true" class="v-zusagen-haken">
                  <path d="M3 8.5L6.2 11.7L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {punkt}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {/* INTRO — entweder als Scroll-Moment oder als Absatz.
        text-lines respektiert \n aus verticals.ts als Zeilenumbrueche. */}
    {hatFuenfSekunden ? (
      <FuenfSekunden branche={slug as SkizzeBranche} />
    ) : (
      <section class="v-intro" data-reveal>
        <p class="text-lines">{vertical.intro}</p>
      </section>
    )}

    <!-- CHECKLIST -->
    <section class="v-checklist" aria-label={vertical.checklistTitle}>
      <h2 class="v-section-headline" data-reveal>{vertical.checklistTitle}</h2>
      <ul class="v-check-list">
        {vertical.checklist.map((item) => (
          <li data-reveal>
            <span class="v-check-icon" set:html={checkIcon} />
            <span class="v-check-text">{item}</span>
          </li>
        ))}
      </ul>
    </section>

    {umgebaut && <UeberMich branche={slug as SkizzeBranche} />}

    {/* PREIS — auf den umgebauten Seiten eine Karte mit einem Betrag,
        sonst der bisherige Fliesstext. Der Verweis auf die volle
        Preisliste faellt dort weg: die Seite ist das Ziel bezahlter
        Anzeigen, und jeder Verweis, der wegfuehrt, verliert einen
        bezahlten Klick. */}
    {umgebaut ? (
      <Angebotskarte branche={slug as SkizzeBranche} />
    ) : (
      <section class="v-pricing" data-reveal aria-label={d.branche.wasEsKostet}>
        <article class="v-pricing-card">
          <p class="v-eyebrow v-eyebrow-inline">{d.branche.wasEsKostet}</p>
          <h2 class="v-section-headline v-pricing-headline">{d.branche.preisHeadline}</h2>
          <div class="v-pricing-body">
            {vertical.pricing.paragraphs.map((p) => <p class="text-lines">{p}</p>)}
          </div>
          {preisePfad && (
            <a class="cta-link" href={preisePfad}>{d.branche.preislisteAnsehen} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          )}
        </article>
      </section>
    )}

    {/* FALLSTUDIE ODER ABLAUF — je nachdem, ob es fuer die Branche
        schon Referenzen gibt. Erfundene oder branchenfremde Beispiele
        waeren an dieser Stelle das Gegenteil von Vertrauen; der
        Ablauf braucht kein fremdes Material. Kommen spaeter
        Referenzen dazu, verschwindet er von selbst. */}
    {vertical.caseStudy ? (
      <>
      <!-- CASE STUDY -->
      <section class="v-case" aria-label={vertical.caseStudy!.eyebrow}>
        <p class="v-eyebrow" data-reveal>{fallstudieBraue}</p>
        <h2 class="v-section-headline" data-reveal>{fallstudieTitel}</h2>
        <div class={`v-case-grid ${vertical.caseStudy!.references.length > 1 ? 'is-multi' : 'is-single'}`}>
          <div class="v-case-body" data-reveal>
            {vertical.caseStudy!.paragraphs.map((p, i) => (
              <p class:list={['text-lines', i === 0 && 'v-case-lead']}>{p}</p>
            ))}
          </div>
          <div class="v-case-images">
            {vertical.caseStudy!.references.map((ref) => {
              const info = refInfo(ref.url);
              return (
              <article class="v-case-karte" data-reveal>
              <a class="v-case-image-link" href={ref.url} target="_blank" rel="noopener noreferrer" aria-label={`${ref.name} — ${d.branche.liveSeiteOeffnen}`}>
                {/* Scheinleiste eines Browsers. Sie sagt in einem Blick,
                    dass das kein Entwurf ist, sondern eine Seite, die
                    im Netz steht — und sie nennt die Adresse, die der
                    Verweis wirklich oeffnet. Reine Zierde fuer
                    Vorleseprogramme: die Adresse steht als Linktext
                    schon daneben. */}
                <span class="v-case-leiste" aria-hidden="true">
                  <span class="v-case-punkte">
                    <span class="v-case-punkt"></span>
                    <span class="v-case-punkt"></span>
                    <span class="v-case-punkt"></span>
                  </span>
                  <span class="v-case-adresse">{hostVon(ref.url)}</span>
                </span>
                <span class="v-case-bild">
                  <img src={ref.image} alt={ref.alt} loading="lazy" />
                </span>
              </a>
              <div class="v-case-fuss">
                <p class="v-case-name">{ref.name}</p>
                {info?.unterzeile && <p class="v-case-unter">{info.unterzeile}</p>}
                {info?.technik && (
                  <ul class="v-case-technik">
                    {info.technik.map((tech) => <li>{tech}</li>)}
                  </ul>
                )}
                <a class="cta-link v-case-link" href={ref.url} target="_blank" rel="noopener noreferrer">
                  {ref.linkLabel}
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              </div>
              </article>
              );
            })}
          </div>
        </div>
      </section>
      </>
    ) : (
      <Ablauf branche={slug as SkizzeBranche} />
    )}

    <!-- FAQ -->
    <section class="v-faq" aria-label={faqTitel}>
      <h2 class="v-section-headline" data-reveal>{faqTitel}</h2>
      <div class="v-faq-list">
        {vertical.faq.map((entry) => (
          <details class="v-faq-item" data-reveal>
            <summary>
              <span class="v-faq-q">{entry.q}</span>
              <span class="v-faq-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </span>
            </summary>
            <p class="v-faq-a">{entry.a}</p>
          </details>
        ))}
      </div>
    </section>

    {umgebaut && <Kundenstimmen branche={slug as SkizzeBranche} />}

    {/* ABSCHLUSS — auf den umgebauten Seiten ein Block, der genau eine
        Sache anbietet. Der geteilte ClosingCta schickt zum
        Erstgespraech UND empfiehlt eine andere Seite; das sind zwei
        Wege nach draussen, und einer davon fuehrt nicht einmal zu
        einer Anfrage. */}
    {umgebaut ? (
      <AbschlussSkizze branche={slug as SkizzeBranche} />
    ) : (
      <ClosingCta
        recommendation={
          softwarePfad
            ? {
                text: d.branche.empfehlung.text,
                label: d.branche.empfehlung.label,
                href: softwarePfad,
              }
            : undefined
        }
      />
    )}
  </main>

  <SiteFooter />

  {/* Ganz am Ende, hinter der Fusszeile: ein <dialog> wird per
      showModal() in die oberste Ebene gehoben, seine Position im
      Markup ist fuer die Darstellung belanglos — aber in der
      Vorlese-Reihenfolge steht er so nicht mitten im Inhalt. */}
  {umgebaut && <QuizModal branche={slug as SkizzeBranche} />}
  {umgebaut && <SchwebenderCta />}
  {umgebaut && <Hochzaehlen />}
</BaseLayout>

<style>
  /* Grund-Layout: dunkler BG, generoeses Padding. Content-Kolumnen
     unter Hero max-width 880px (editorial, schmaler als /preise). */
  .vertical-page {
    min-height: calc(100vh - 200px);
    background: #050507;
    padding: 0 0 100px;
    position: relative;
    /* CLIP, NICHT HIDDEN. Beides schneidet ab, aber `hidden` macht das
       Element zum Scroll-Container — und damit ist jedes
       `position: sticky` darin wirkungslos: es klebt dann an einem
       Kasten, der selbst nicht scrollt, und wandert mit nach oben
       raus. Nachgemessen: die Buehne des Fuenf-Sekunden-Abschnitts
       stand bei -1881px, die ganze Inszenierung lief ausserhalb des
       Bildes ab. `clip` schneidet genauso ab, ohne Scroll-Container.
       Nur auf der Waagerechten, damit die Senkrechte frei bleibt. */
    overflow-x: clip;
  }

  /* Der Abschluss-Block bringt seinen eigenen Abstand nach unten mit.
     Der Seitenabstand kaeme obendrauf und riss ein Loch zwischen
     Telefonnummer und Fusszeile. */
  .vertical-page.ist-umgebaut {
    padding-bottom: 0;
  }

  .vertical-page > *:not(:first-child) {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  /* Amber Eyebrow — Section 3/5 Style. */
  .v-eyebrow {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: var(--lp-braue);
    letter-spacing: var(--lp-braue-sperrung);
    color: rgba(245, 158, 11, 0.85);
    text-transform: uppercase;
    margin: 0 0 18px;
  }

  .v-eyebrow-inline {
    margin-bottom: 12px;
  }

  /* === HERO ===
     Full-Bleed 100dvh Hero. Background-Image kommt ueber CSS-Custom-
     Property vom style-Attribut (injiziert aus vertical.hero.background.
     image). 3-Layer-BG:
       1. Radiales Vignette-Gradient (Center leicht heller, Rand dunkler)
       2. Bottom-Linear-Gradient (unten fast opaque fuer Text-Safety)
       3. Das Foto selbst
     background-position wird per --hero-focal gesteuert (default center).
     background-color als Fallback bevor das WebP geladen ist. */
  .v-hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Die Abstaende haengen an der HOEHE des Fensters, nicht an einer
       festen Zahl. Gemessen: mit 140/100 stand auf einem 1366x768er
       Laptop der Haupt-CTA unter der Falz und die Zusagen fehlten um
       154px — auf einer Seite, die bezahlte Klicks einkauft, ist das
       der teuerste Fehler ueberhaupt. */
    padding: clamp(96px, 13dvh, 140px) 40px clamp(48px, 8dvh, 100px);
    overflow: hidden;
    isolation: isolate;

    background-color: #050507;
    background-image:
      radial-gradient(
        ellipse at center,
        transparent 0%,
        rgba(5, 5, 7, 0.35) 55%,
        rgba(5, 5, 7, 0.7) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(5, 5, 7, 0.35) 0%,
        rgba(5, 5, 7, 0.55) 45%,
        rgba(5, 5, 7, 0.92) 100%
      ),
      var(--hero-image, none);
    background-size: cover, cover, cover;
    background-position: center, center, var(--hero-focal, center);
    background-repeat: no-repeat;
  }

  /* Ohne Foto: derselbe Aufbau wie die Startseite — fast schwarz, ein
     warmer Schein aus der Mitte und ein feines Raster darueber. Das
     ist eine eigene Gestaltung, kein Platzhalter. */
  .v-hero[data-ohne-bild] {
    background-color: #050507;
    background-image:
      radial-gradient(
        ellipse 95% 70% at 50% 38%,
        rgba(245, 158, 11, 0.2) 0%,
        rgba(245, 158, 11, 0.05) 45%,
        transparent 72%
      ),
      linear-gradient(to bottom, rgba(5, 5, 7, 0) 55%, rgba(5, 5, 7, 0.9) 100%),
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: cover, cover, 64px 64px, 64px 64px;
    background-position: center, center, center, center;
  }

  .v-hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    text-align: center;
    color: #ffffff;
  }

  .v-hero-eyebrow {
    color: rgba(245, 158, 11, 0.95);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    margin-bottom: clamp(11px, 2.2dvh, 22px);
  }

  /* Fette Typo mit Text-Shadow fuer Punch auf dem Foto.
     clamp 3rem → 6rem: mobile bleibt lesbar, Desktop knallt. */
  .v-hero-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-style: normal;
    /* min() statt nur clamp(): die Breite allein weiss nicht, ob
       noch Hoehe da ist. 9.5dvh haelt vier Zeilen Ueberschrift auch
       auf einem flachen Laptop im Bild. */
    font-size: min(var(--lp-riese), 9.5dvh);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0 0 clamp(16px, 2.8dvh, 28px);
    text-wrap: balance;
    text-shadow:
      0 2px 24px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .v-hero-subtitle {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: var(--lp-lead);
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.95);
    max-width: 640px;
    margin: 0 auto clamp(20px, 3.6dvh, 40px);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }

  .v-hero-cta {
    display: flex;
    justify-content: center;
  }

  /* === Hero-Highlight ===
     Slanted SVG-Underline unter dem highlighteten Wort. Amber, leicht
     kurvig fuer Marker-Feel. Groesserer Stroke damit's zur fetten
     Headline passt. Amber-Glow als drop-shadow fuer Punch auf dem Foto. */
  .hero-highlight {
    position: relative;
    display: inline-block;
    color: #f59e0b;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }

  .hero-highlight-underline {
    position: absolute;
    left: -1%;
    right: -1%;
    bottom: -0.02em;
    width: 102%;
    height: 0.22em;
    overflow: visible;
    pointer-events: none;
  }

  .hero-highlight-underline path {
    stroke: #f59e0b;
    stroke-width: 5;
    stroke-linecap: round;
    fill: none;
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.5));
  }

  /* Der Strich zeichnet sich einmal beim Laden, von links nach rechts
     — als Wischblende ueber dem fertigen Strich, nicht als
     Strichmuster auf dem Pfad.

     WARUM NICHT MEHR MIT stroke-dasharray: der Pfad traegt
     vector-effect="non-scaling-stroke", damit die Strichstaerke bei
     jeder Wortbreite gleich bleibt. Damit rechnet der Browser das
     Strichmuster aber in Bildschirmpixeln, waehrend pathLength es auf
     die viewBox normiert. Ergebnis bei „Makler-Website." (575 px
     breit): Strich 194 px, Luecke 194 px, Strich 194 px — eine
     sichtbare Luecke mitten im Wort, auf jeder Branchenseite.
     Nachgemessen am 04.11.2026, Bild im Scratchpad.

     clip-path kennt diesen Konflikt nicht: es beschneidet das fertige
     Bild, unabhaengig von Pfadlaenge, Skalierung und Strichstaerke.
     Die negativen Werte oben, unten und links lassen den Schein und
     die runden Enden heraus, die sonst an der Kante abgeschnitten
     wuerden.

     Nur unter no-preference, und zwar so herum: ohne die Abfrage
     stuende der Strich bei abgeschalteter Bewegung dauerhaft
     beschnitten da. Der Grundzustand ist der fertige Strich. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-highlight-underline {
      clip-path: inset(-60% 100% -60% -2%);
      animation: hero-strich 820ms cubic-bezier(0.22, 1, 0.36, 1) 380ms forwards;
    }

    @keyframes hero-strich {
      to {
        clip-path: inset(-60% -2% -60% -2%);
      }
    }
  }

  /* === INTRO ===
     .text-lines (pre-line) im global.css respektiert \n als Zeilen-
     umbrueche. text-wrap: pretty aus global.css bleibt aktiv fuer
     die einzelnen Zeilen intern. */
  .v-intro {
    max-width: 720px;
    margin: 96px auto 96px !important;
  }

  .v-intro p {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.82);
    text-align: center;
    margin: 0;
  }

  /* Section-Headlines */
  .v-section-headline {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: var(--lp-titel);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #f5f5f4;
    margin: 0 0 32px;
  }

  /* === CHECKLIST === */
  .v-checklist {
    margin-bottom: 96px;
  }

  .v-check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .v-check-list li {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(15, 15, 18, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: var(--lp-text);
    line-height: 1.5;
    color: rgba(245, 245, 244, 0.85);
    transition: border-color 240ms ease, background-color 240ms ease;
  }

  .v-check-list li:hover {
    border-color: rgba(245, 158, 11, 0.28);
    background: rgba(15, 15, 18, 0.7);
  }

  .v-check-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .v-check-text {
    /* Kein flex: 1 — sonst fuellt der Text die ganze Zeile und
       justify-content hat nichts mehr zu zentrieren. */
    flex: 0 1 auto;
    text-align: center;
  }

  /* === PRICING === */
  .v-pricing {
    margin-bottom: 96px;
  }

  .v-pricing-card {
    background: linear-gradient(180deg, rgba(20, 20, 24, 0.7) 0%, rgba(15, 15, 18, 0.7) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 40px 40px 36px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }

  .v-pricing-headline {
    margin-bottom: 20px;
  }

  .v-pricing-body {
    display: grid;
    gap: 14px;
    margin-bottom: 24px;
  }

  .v-pricing-body p {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.82);
    margin: 0;
  }


  /* === CASE STUDY === */
  .v-case {
    margin-bottom: 96px;
  }

  .v-case-grid {
    display: grid;
    gap: 28px;
  }

  .v-case-grid.is-single {
    grid-template-columns: 1fr;
  }

  /* EINE Referenz: Text links, Vorschau rechts — und zwar auf halber
     Hoehe des Textes, nicht oben buendig.

     Vorher stand align-items: start, und dazu kamen 40px Abstand oben
     an der Vorschau. Bei „Er & Sie" (Gastro) hing die Karte dadurch
     sichtbar unter der ersten Textzeile und ueber dem letzten Absatz
     in der Luft; bei Gräfe Media (Medien) traf sie den unteren Rand
     zufaellig genau. Mittig trifft es bei jeder Textlaenge. */
  @media (min-width: 720px) {
    .v-case-grid.is-single {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }

    /* Der Abstand oben gehoert zum Untereinander (is-multi). Neben
       dem Text waere er genau der Versatz, um den es geht. */
    .v-case-grid.is-single .v-case-images {
      margin-top: 0;
    }
  }

  .v-case-grid.is-multi {
    grid-template-columns: 1fr;
  }

  .v-case-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .v-case-body p {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: var(--lp-text);
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.82);
    margin: 0;
  }

  /* Der erste Absatz traegt den Abschnitt und bekommt Lesegroesse. */
  .v-case-lead {
    font-size: var(--lp-lead) !important;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.92) !important;
  }

  .v-case-images {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  /* Eine Karte je Referenz: Rahmen, Name, was es ist, womit gebaut,
     Verweis. Vorher stand unter dem Text nur eine Reihe nackter
     Screenshots und zwei lose Links daneben — viel Flaeche, wenig
     Aussage. Name, Unterzeile und Technik stehen laengst in
     references.ts. */
  .v-case-karte {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .v-case-fuss {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
  }

  .v-case-name {
    margin: 0;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: var(--lp-text);
    line-height: 1.25;
    color: #f5f5f4;
  }

  .v-case-unter {
    margin: 0;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: var(--lp-klein);
    line-height: 1.35;
    color: rgba(245, 245, 244, 0.55);
  }

  .v-case-technik {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 5px 0 2px;
    padding: 0;
  }

  .v-case-technik li {
    padding: 3px 9px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: rgba(245, 245, 244, 0.5);
  }

  .v-case-link {
    font-size: var(--lp-klein);
  }

  .v-case-grid.is-multi .v-case-images {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .v-case-image-link {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #0a0a0c;
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.42);
    transition: transform 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  /* Browser-Rahmen: Leiste oben, Bild darunter. Das Seitenverhaeltnis
     sitzt am Bild, nicht am Rahmen — sonst fraesse die Leiste oben
     vom Bild ab. */
  .v-case-leiste {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    background: rgba(255, 255, 255, 0.045);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .v-case-punkte {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .v-case-punkt {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .v-case-adresse {
    flex: 1;
    min-width: 0;
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.32);
    font-family: var(--lp-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: rgba(245, 245, 244, 0.45);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Die Punkte links wiegen optisch; ohne Gegengewicht rechts saesse
     die Adresse nicht in der Mitte des Rahmens. */
  .v-case-leiste::after {
    content: '';
    flex-shrink: 0;
    width: 39px;
  }

  .v-case-bild {
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
  }

  .v-case-image-link:hover,
  .v-case-image-link:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 22px 56px rgba(0, 0, 0, 0.5), 0 0 48px rgba(245, 158, 11, 0.14);
    outline: none;
  }

  .v-case-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 600ms ease;
  }

  .v-case-image-link:hover img {
    transform: scale(1.04);
  }

  /* === FAQ === */
  .v-faq {
    margin-bottom: 96px;
  }

  .v-faq-list {
    display: grid;
    gap: 10px;
  }

  .v-faq-item {
    background: rgba(15, 15, 18, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 240ms ease;
  }

  .v-faq-item[open] {
    border-color: rgba(245, 158, 11, 0.28);
    background: rgba(15, 15, 18, 0.7);
  }

  .v-faq-item summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    /* Rechts und links derselbe Platz, damit die Frage wirklich
       mittig steht und nicht nur neben dem Pfeil. */
    padding: 18px 52px;
    cursor: pointer;
    list-style: none;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: var(--lp-text);
    line-height: 1.4;
    color: #f5f5f4;
    transition: color 200ms ease;
  }

  .v-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .v-faq-item summary:hover {
    color: rgba(245, 158, 11, 0.95);
  }

  .v-faq-item summary:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.6);
    outline-offset: -2px;
  }

  .v-faq-q {
    flex: 0 1 auto;
    text-align: center;
  }

  .v-faq-icon {
    position: absolute;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    display: inline-flex;
    flex-shrink: 0;
    color: rgba(245, 158, 11, 0.85);
    transition: transform 240ms ease;
  }

  .v-faq-item[open] .v-faq-icon {
    transform: translateY(-50%) rotate(180deg);
  }

  .v-faq-a {
    padding: 0 28px 20px;
    margin: 0;
    text-align: center;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: var(--lp-text);
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.78);
  }

  /* === FINAL CTA === */

  /* === MOBILE === */
  @media (max-width: 768px) {
    .vertical-page {
      padding: 0 0 60px;
    }

    .vertical-page > *:not(:first-child) {
      padding-left: 20px;
      padding-right: 20px;
    }

    .v-hero {
      padding: clamp(84px, 12dvh, 120px) 20px clamp(40px, 7dvh, 80px);
      min-height: 100dvh;
    }

    .v-hero-title {
      font-size: clamp(2.4rem, 10vw, 3.8rem);
    }

    .hero-highlight-underline path {
      stroke-width: 4;
    }

    .v-hero-cta .cta-orbital {
      font-size: 0.98rem;
      padding: 12px 24px;
    }

    .v-intro {
      margin: 64px auto 64px !important;
    }

    .v-checklist,
    .v-pricing,
    .v-case {
      margin-bottom: 64px;
    }

    .v-check-list li {
      padding: 12px 14px;
      font-size: 0.95rem;
    }

    .v-pricing-card {
      padding: 32px 24px 28px;
    }

    .v-faq-item summary {
      padding: 16px 44px;
      font-size: 0.95rem;
    }

    .v-faq-a {
      padding: 0 20px 18px;
      font-size: 0.92rem;
    }

  }
  /* === Alles auf die Mittelachse ==================================
     Hero und Intro standen zentriert, ab der Checkliste lief alles
     linksbuendig weiter — die Seite kippte auf halber Hoehe nach
     links, und beim Scrollen sah man die Kante.

     Zentriert wird der TEXT, nicht der Inhalt von Listenzeilen. Eine
     zentrierte Aufzaehlung liest sich schlechter als eine
     linksbuendige: dem Auge fehlt die gemeinsame Kante, an der die
     naechste Zeile anfaengt. Checkliste und FAQ bleiben deshalb innen
     linksbuendig und werden nur als Block mittig gesetzt.

     Diese Regeln stehen am Ende des Stilblocks, damit sie die
     Ausrichtung der Abschnitte weiter oben ueberschreiben, ohne dass
     dort etwas geloescht werden muss. */
  .v-eyebrow,
  .v-section-headline {
    text-align: center;
  }

  /* Lesespalte: 680px traegt rund 75 Zeichen pro Zeile. Darueber
     verliert das Auge beim Ruecksprung die naechste Zeile. */
  .v-pricing-body,
  .v-case-body {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .v-pricing-body p,
  .v-case-body {
    text-align: center;
  }

  .v-check-list {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  .v-faq-list {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  /* === Umbau fuer bezahlte Werbung ============================== */

  /* Der Knopf traegt dieselbe globale Klasse wie der Link daneben.
     .cta-orbital gehoert aber auch der Navigationsleiste — deshalb
     hier ein Zusatz statt einer Aenderung in global.css. Ein <button>
     erbt die Schrift des Browsers, nicht die der Seite. */
  .v-hero-cta button.cta-orbital {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    text-align: left;
  }
  .v-hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .v-hero-cta-zweit {
    font-size: var(--lp-klein);
    color: rgba(245, 245, 244, 0.65);
  }
  .v-hero-nummer {
    border-bottom: 1px solid rgba(245, 158, 11, 0.45);
    padding-bottom: 1px;
  }
  .v-hero-cta-zweit:hover,
  .v-hero-cta-zweit:focus-visible {
    color: rgba(252, 211, 77, 1);
  }

  /* Zusagen-Zeile unter dem CTA. */
  .v-zusagen {
    list-style: none;
    margin: clamp(13px, 2.4dvh, 26px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
