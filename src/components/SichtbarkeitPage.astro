    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.12);
    color: rgba(26, 26, 28, 0.8);
  }

  :global(html[data-site-theme='light']) .sb-mitte {
    background: #ffffff;
  }
</style>

<script>
  /* Zwei Dinge: der Stapel, der beim Scrollen zu einem wird, und die
     Lichtbox. */
  (() => {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- Fünf werden einer ---------------------------------------
    const stapel = document.querySelector<HTMLElement>('[data-stapel]');
    if (stapel && !ruhig) {
      /* DREI STUFEN ALS DAUERSCHLEIFE.
       *
       * Erst lief das einmal und sofort: man sah das Durcheinander
       * eine Zehntelsekunde und danach nur noch „Tammo" — der Witz
       * war vorbei, bevor man ihn gelesen hatte. Jetzt steht jede
       * Stufe lange genug, und die Schleife faengt von vorn an, damit
       * man sie auch sieht, wenn man zu spaet hinschaut.
       *
       * Sie laeuft NUR im Blick. Eine Schleife hinter dem
       * Bildschirmrand kostet Rechenzeit und zeigt niemandem etwas.
       */
      const PLAN: ReadonlyArray<readonly [number, (el: HTMLElement) => void]> = [
        // Durcheinander steht und wird gelesen.
        [1600, (el) => { el.dataset.ordnung = ''; }],
        // In eine Spalte geordnet.
        [1150, (el) => { el.dataset.zusammen = ''; }],
        // Zusammengefuehrt, „Tammo" erscheint — dann abblenden.
        [2250, (el) => { el.dataset.aus = ''; }],
        // Unsichtbar zuruecksetzen und wieder aufblenden.
        [430, (el) => {
          el.dataset.sprung = '';
          delete el.dataset.ordnung;
          delete el.dataset.zusammen;
          // Zwei Frames: einer, damit der Grundzustand steht, der
          // zweite, damit der Browser ihn uebernommen hat, bevor die
          // Uebergaenge wieder scharf sind.
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              delete el.dataset.sprung;
              delete el.dataset.aus;
            });
          });
        }],
      ];

      let uhr: number | undefined;

      const schritt = (i: number) => {
        const [wartezeit, tun] = PLAN[i % PLAN.length];
        uhr = window.setTimeout(() => {
          tun(stapel);
          schritt(i + 1);
        }, wartezeit);
      };

      const anhalten = () => {
        if (uhr !== undefined) window.clearTimeout(uhr);
        uhr = undefined;
      };

      const beobachter = new IntersectionObserver(
        (eintraege) => {
          for (const e of eintraege) {
            if (e.isIntersecting) {
              if (uhr === undefined) schritt(0);
            } else {
              anhalten();
            }
          }
        },
        // Erst wenn der Block wirklich steht. Bei 0.6 fing es an,
        // waehrend die Unterkante noch unter dem Rand hing.
        { threshold: 0.85 }
      );
      beobachter.observe(stapel);
    }

    // --- Lichtbox --------------------------------------------------
    const licht = document.querySelector<HTMLDialogElement>('[data-licht]');
    const bild = licht?.querySelector<HTMLImageElement>('[data-licht-bild]');
    const bu = licht?.querySelector<HTMLElement>('[data-licht-bu]');
    if (!licht || !bild || !bu) return;

    document.querySelectorAll<HTMLButtonElement>('.sb-oeffnen').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        const quelle = knopf.dataset.gross;
        const text = knopf.dataset.bu ?? '';
        if (!quelle) return;
        bild.src = quelle;
        // Der Alternativtext der Kachel beschreibt dasselbe Bild.
        bild.alt = knopf.querySelector('img')?.alt ?? text;
        bu.textContent = text;
        licht.showModal();
      });
    });

    // Klick auf den Grund schliesst. Das <dialog> selbst ist das
    // Ziel nur dann, wenn daneben geklickt wurde — innerhalb trifft
    // es immer ein Kind.
    licht.addEventListener('click', (e) => {
      if (e.target === licht) licht.close();
    });

    // Das Bild erst freigeben, wenn zu ist: sonst haengt die grosse
    // Datei bis zum naechsten Oeffnen im Speicher.
    licht.addEventListener('close', () => {
      bild.removeAttribute('src');
      bild.alt = '';
    });
  })();
</script>
