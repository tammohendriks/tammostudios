---
/**
 * JournalThemeToggle — iOS-style Slider fuer Dark ↔ Light Mode.
 *
 * Scope: nur /journal + /journal/[slug]. Andere Sub-Pages nicht betroffen.
 *
 * Persistierung: localStorage 'journal-theme' = 'dark' | 'light'.
 * FOUC-Prevention: BaseLayout hat einen is:inline script der den
 * data-journal-theme Attribut auf <html> setzt BEVOR die Page rendert.
 * Dieses Component reagiert nur auf User-Klicks und schreibt in
 * localStorage.
 *
 * Toggle-Positionierung: position:fixed top-right unter TopBar, sichtbar
 * ueber Content-Scroll. Solid dunkles Pill matched TopBar-Aesthetik in
 * BEIDEN Themes (Toggle ist Nav, nicht Content).
 */
---

<button
  type="button"
  class="journal-theme-toggle"
  data-journal-theme-toggle
  aria-label="Farbthema umschalten (Dark / Light)"
>
  <span class="journal-theme-track" aria-hidden="true">
    <span class="journal-theme-icon journal-theme-icon-moon">☾</span>
    <span class="journal-theme-icon journal-theme-icon-sun">☀</span>
    <span class="journal-theme-thumb"></span>
  </span>
</button>

<script>
  // Toggle-Click: switcht data-journal-theme auf <html> + persistiert.
  // Der Initial-Wert wird vom is:inline script in BaseLayout gesetzt (vor
  // Render → kein Flash).
  const btn = document.querySelector<HTMLButtonElement>(
    '[data-journal-theme-toggle]'
  );
  if (btn) {
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-journal-theme');
      const next = current === 'light' ? 'dark' : 'light';
      if (next === 'light') {
        html.setAttribute('data-journal-theme', 'light');
      } else {
        html.removeAttribute('data-journal-theme');
      }
      try {
        localStorage.setItem('journal-theme', next);
      } catch (_) {
        // localStorage nicht verfuegbar (private-mode etc.) — ok
      }
      btn.setAttribute(
        'aria-label',
        next === 'light'
          ? 'Farbthema umschalten (aktuell: Light)'
          : 'Farbthema umschalten (aktuell: Dark)'
      );
    });
  }
</script>

<style>
  .journal-theme-toggle {
    position: fixed;
    top: 88px;
    right: 24px;
    z-index: 50;
    padding: 6px 8px;
    background: rgba(5, 5, 7, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .journal-theme-toggle:hover {
    border-color: rgba(245, 158, 11, 0.5);
  }

  .journal-theme-toggle:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.95);
    outline-offset: 2px;
  }

  .journal-theme-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 52px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
  }

  .journal-theme-icon {
    position: relative;
    z-index: 2;
    font-size: 12px;
    line-height: 1;
    color: rgba(245, 245, 244, 0.7);
    /* iOS rendered Sonne/Mond emojis colorful — disable per CSS */
    font-variant-emoji: text;
    transition: color 200ms ease;
  }

  .journal-theme-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(245, 158, 11, 0.95);
    transition: transform 220ms cubic-bezier(0.4, 0.0, 0.2, 1);
    z-index: 1;
  }

  /* Light-Mode Zustand: Thumb rechts, Sun-Icon aktiv, Moon dim */
  :global(html[data-journal-theme='light']) .journal-theme-thumb {
    transform: translateX(30px);
  }
  :global(html[data-journal-theme='light']) .journal-theme-icon-moon {
    color: rgba(245, 245, 244, 0.4);
  }
  :global(html:not([data-journal-theme='light'])) .journal-theme-icon-sun {
    color: rgba(245, 245, 244, 0.4);
  }

  @media (max-width: 768px) {
    .journal-theme-toggle {
      top: 74px;
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-theme-thumb {
      transition: none;
    }
  }
</style>
