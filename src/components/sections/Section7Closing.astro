---
// Section 6 — Cream Closing (matcht Section 5 Werkstattlicht-Palette).
//
// Bildet mit Section 5 einen "Ankunfts-Arc": dunkler Fahrplan bricht
// bei Section 5 auf Cream auf, Section 6 fuehrt konsequent im Cream
// weiter und muendet in den einzigen schweren Punkt auf hellem Grund:
// den dunklen Amber-CTA-Block. Kein Video, keine Cosmic-Aurora, keine
// orbital breathing frame — Typography + eine bewusste Farbfrucht.
//
// Content aus SECTION5 constants (eyebrow/headline/subtext/cta bleiben
// gleich, nur visuelle Umsetzung wechselt komplett).

import { SECTION5 } from '../../lib/constants';
import SiteFooter from '../SiteFooter.astro';

// headline + primaryCta.label werden bewusst NICHT destructured —
// Section 6 hardcodet Headline ("Bereit für [Phase 01?]" mit Highlight-
// Span um "Phase 01?") und CTA-Text ("Lass uns sprechen", matcht
// /preise-Sprache), beide nicht via einfacher Interpolation abbildbar.
const { eyebrow, subtext, secondaryEmail } = SECTION5;

---

<section class="section-6" aria-labelledby="closing-headline" data-section-bg="cream">
  <!-- Cream Base-BG -->
  <div class="closing-bg" aria-hidden="true"></div>
  <!-- Sonnenschein: subtile radiale Halo von unten. Basiswaerme, dezent. -->
  <div class="closing-sunrise" aria-hidden="true"></div>
  <!-- Aufsteigende Amber-Embers — 14 Glut-Partikel steigen kontinuierlich
       vom unteren Section-Rand zum oberen. Verschiedene Groessen, Start-
       X-Positionen, Durations + Delays fuer organischen Aurora-artigen
       Effekt. Reminisziert Section 2 aurora-drift aber vertikal, matcht
       das "Sonnen-Aufstieg zum Ziel" Storytelling. -->
  <div class="closing-embers" aria-hidden="true">
    <span style="--x:8%;--size:4px;--dur:14s;--delay:-2s;--drift:16px"></span>
    <span style="--x:16%;--size:6px;--dur:18s;--delay:-8s;--drift:-22px"></span>
    <span style="--x:24%;--size:3px;--dur:12s;--delay:-4s;--drift:10px"></span>
    <span style="--x:32%;--size:5px;--dur:16s;--delay:-11s;--drift:-14px"></span>
    <span style="--x:40%;--size:4px;--dur:15s;--delay:-6s;--drift:18px"></span>
    <span style="--x:48%;--size:7px;--dur:20s;--delay:-13s;--drift:-8px"></span>
    <span style="--x:55%;--size:3px;--dur:13s;--delay:-1s;--drift:12px"></span>
    <span style="--x:62%;--size:5px;--dur:17s;--delay:-9s;--drift:-20px"></span>
    <span style="--x:70%;--size:4px;--dur:14s;--delay:-3s;--drift:16px"></span>
    <span style="--x:78%;--size:6px;--dur:19s;--delay:-12s;--drift:-10px"></span>
    <span style="--x:85%;--size:3px;--dur:13s;--delay:-7s;--drift:14px"></span>
    <span style="--x:92%;--size:5px;--dur:16s;--delay:-4s;--drift:-18px"></span>
    <span style="--x:20%;--size:3px;--dur:15s;--delay:-10s;--drift:20px"></span>
    <span style="--x:74%;--size:4px;--dur:18s;--delay:-5s;--drift:-16px"></span>
  </div>

  <div class="closing">
    <p class="closing-eyebrow" data-reveal>{eyebrow}</p>

    <h2 class="closing-headline" id="closing-headline" data-reveal>
      Bereit für
      <span class="closing-highlight">
        Phase 01?
        <svg
          class="closing-highlight-underline"
          viewBox="0 0 200 12"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M 3 7 C 50 3, 150 9, 197 4"
            vector-effect="non-scaling-stroke"
          />
        </svg>
      </span>
    </h2>

    <p class="closing-sub" data-reveal>{subtext}</p>

    <div class="closing-cta-wrap" data-reveal>
      <!-- Inline-Link-CTA (matcht /preise Pattern): grosser Text mit
           amber Arrow, subtile amber Hover-Underline. Kein Pill, kein
           Glow — leiseres, editorialeres Statement passend zum Cream. -->
      <a
        class="closing-cta-link"
        href="/kontakt"
      >
        <span>Lass uns sprechen</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <p class="closing-secondary" data-reveal>
      Oder direkt:
      {' '}
      <a href={`mailto:${secondaryEmail}`}>{secondaryEmail}</a>
    </p>
  </div>

  <ul class="trust-trio" aria-label="Was du erwarten kannst" data-reveal>
    <li>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 15 14" />
      </svg>
      <span>Antwort &lt; 24 h</span>
    </li>
    <li>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
      </svg>
      <span>Erstgespräch gratis</span>
    </li>
    <li>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" />
        <line x1="2" y1="12" x2="22" y2="12" />
        <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
      </svg>
      <span>DE &amp; EN</span>
    </li>
  </ul>

  <SiteFooter variant="embedded-cream" />
</section>

<style>
  /* Section-Root: Cool-Sunset Cream — weniger gesaettigt-gelb als der
     erste Wurf (#f4e2b5), stattdessen ein neutralerer warm-cream Ton
     der sich klar von S5 (#f7f0dd) und S6 (#f3ecd7) abhebt ohne
     "yellow-heavy" zu wirken. Chapter-Divider oben: 2px Amber-Horizon
     fuer klaren Break vom Werkzeug zum Ziel. */
  .section-6 {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #ecdcbf;
    padding: clamp(100px, 14vh, 160px) 40px 24px;
    isolation: isolate;
  }

  /* Amber-Horizon oben als "Chapter-Divider" zwischen den 3 Cream-
     Sections. 2px + glow. Fadet an den Kanten aus. */
  .section-6::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(245, 158, 11, 0.65) 15%,
      rgba(245, 158, 11, 0.95) 50%,
      rgba(245, 158, 11, 0.65) 85%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  .closing-bg {
    position: absolute;
    inset: 0;
    background: #ecdcbf;
    z-index: 0;
  }

  /* === Sonnenschein: subtile Halo von unten ===================== */
  .closing-sunrise {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 90% 55% at 50% 108%,
        rgba(245, 158, 11, 0.18) 0%,
        rgba(245, 158, 11, 0.08) 30%,
        rgba(245, 158, 11, 0.03) 60%,
        transparent 85%
      );
    animation: sunrise-breathe 14s ease-in-out infinite;
  }

  @keyframes sunrise-breathe {
    0%, 100% { opacity: 0.75; }
    50%      { opacity: 1; }
  }

  /* === Aufsteigende Amber-Embers ==================================
     14 kleine glow-particles die vom unteren Section-Rand nach oben
     aufsteigen. Negative animation-delays sorgen dafuer dass beim
     ersten Frame schon alle Embers verteilt in ihrem Zyklus sind
     (kein "leerer Start" wo alle unten warten).
     Composite-only (translate3d + opacity) → Mobile-Perf-freundlich.
     overflow:hidden am Parent clippt die Embers die aus der Section
     rausdriften. */
  .closing-embers {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .closing-embers span {
    position: absolute;
    left: var(--x);
    bottom: -12px;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(245, 158, 11, 0.85) 0%,
      rgba(245, 158, 11, 0.35) 40%,
      transparent 75%
    );
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.35);
    animation-name: ember-rise;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-delay: var(--delay);
    animation-duration: var(--dur);
    will-change: transform, opacity;
  }

  @keyframes ember-rise {
    0% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translate3d(var(--drift, 0px), -110vh, 0);
      opacity: 0;
    }
  }

  /* Mobile: 8 statt 14 Embers, kein box-shadow (glow-simulation
     ausreichend via radial-gradient background), damit Perf-Impact
     minimal bleibt. */
  @media (max-width: 767px) {
    .closing-embers span:nth-child(n+9) {
      display: none;
    }
    .closing-embers span {
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .closing-sunrise {
      animation: none;
      opacity: 0.85;
    }
    .closing-embers {
      display: none;
    }
  }

  /* Content Container — zentriert, max-width, wachst flex-1 damit
     Footer natuerlich am Boden sitzt. */
  .closing {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(24px, 5vh, 60px) 0;
    gap: clamp(18px, 3vh, 32px);
  }

  .closing-eyebrow {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: #f59e0b;
    text-transform: uppercase;
    margin: 0;
  }

  /* HUGE Typographie — der optische Anker der Section neben dem CTA-
     Block. Charcoal-Text auf warmem Cream. */
  .closing-headline {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: #1a1a1c;
    margin: 0;
    text-wrap: balance;
  }

  /* Highlight-Wort "Phase 01?" — amber-700 mit SVG-Underline,
     matcht die Vertical-Landing-Pages Highlight-Sprache. */
  .closing-highlight {
    position: relative;
    display: inline-block;
    color: #f59e0b;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }

  .closing-highlight-underline {
    position: absolute;
    left: -1%;
    right: -1%;
    bottom: -0.02em;
    width: 102%;
    height: 0.22em;
    overflow: visible;
    pointer-events: none;
  }

  .closing-highlight-underline path {
    stroke: #f59e0b;
    stroke-width: 5;
    stroke-linecap: round;
    fill: none;
    filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.35));
  }

  /* Mobile: SVG drop-shadow ist auf iOS Safari software-rasterized. */
  @media (max-width: 767px) {
    .closing-highlight-underline path {
      filter: none;
    }
  }

  .closing-sub {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: rgba(26, 26, 28, 0.72);
    max-width: 560px;
    margin: 0;
  }

  /* Inline-Link-CTA (matcht /preise Pattern, adaptiert fuer Cream):
     Charcoal Text statt light, amber Arrow, subtile amber Underline
     on hover. Groessere Font-Size als Body damit's als CTA lesbar
     bleibt ohne visuell zu dominant zu sein — der Fokus soll auf
     der Headline "Bereit für Phase 01?" liegen. */
  .closing-cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: clamp(8px, 2vh, 16px);
  }

  .closing-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    color: #1a1a1c;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 600;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    padding: 0 0 2px;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .closing-cta-link svg {
    color: #f59e0b;
    transition: transform 200ms ease;
    flex-shrink: 0;
  }

  .closing-cta-link:hover,
  .closing-cta-link:focus-visible {
    border-bottom-color: rgba(245, 158, 11, 0.6);
    color: #000;
    outline: none;
  }

  .closing-cta-link:hover svg,
  .closing-cta-link:focus-visible svg {
    transform: translateX(4px);
  }

  .closing-secondary {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: 0.92rem;
    color: rgba(26, 26, 28, 0.55);
    margin: 0;
  }

  .closing-secondary a {
    color: #f59e0b;
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
    padding-bottom: 1px;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .closing-secondary a:hover,
  .closing-secondary a:focus-visible {
    color: #d97706;
    border-color: rgba(245, 158, 11, 0.7);
    outline: none;
  }

  /* Trust-Trio — Linework-Icons in amber-700, charcoal Labels.
     Horizontal auf Desktop, vertikal auf Mobile. */
  .trust-trio {
    position: relative;
    z-index: 2;
    list-style: none;
    padding: 0;
    margin: clamp(24px, 5vh, 48px) auto 32px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 40px;
    max-width: 720px;
  }

  .trust-trio li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: rgba(26, 26, 28, 0.7);
  }

  .trust-trio svg {
    color: #f59e0b;
    flex-shrink: 0;
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .section-6 {
      padding: 80px 20px 20px;
    }

    .closing {
      padding: 16px 0;
      gap: 16px;
    }

    .closing-headline {
      font-size: clamp(2.4rem, 10vw, 3.4rem);
    }

    .closing-highlight-underline path {
      stroke-width: 4;
    }

    .closing-cta {
      padding: 16px 26px;
      font-size: 1rem;
    }

    .trust-trio {
      gap: 12px 24px;
      margin-bottom: 24px;
    }

    .trust-trio li {
      font-size: 0.78rem;
    }
  }

  /* Reduced Motion — data-reveal wird global von BaseLayout gehandhabt.
     Fuer die Section-spezifischen Transitions Sicherheits-Reset. */
  @media (prefers-reduced-motion: reduce) {
    .closing-cta,
    .closing-cta svg,
    .closing-secondary a {
      transition: none !important;
    }
  }
</style>
