---
// Section 5 — DER FAHRPLAN (Hybrid v3: Horizon-Split + Cream Werkstatt +
// Horizontal Phase-Flow + Centroid-Synced Ink-Rail).
//
// Choreografie in Scroll-Progress-Ranges (0..1 ueber section min-height):
//   0.00 - 0.08  Horizon-Split — dunkle Overlays weichen von 1px amber
//                Hairline auseinander, Cream-Werkstatt wird revealed
//   0.08 - 0.14  Header emerged aus der Fuge (opacity + 8px translateY)
//   0.16 - 0.94  5 Phase-Cards flow horizontal (left→center→right),
//                Fahrplan-Rail unten trackt den Zentroid der Phase-Opacities
//   0.94 - 1.00  Settle — Phase 05 haelt, Ink voll gefuellt
//
// Sync-Mechanik: --ink-progress kommt aus dem Zentroid der Phase-
// Opacities (nicht linearer scroll-progress). Formel:
//   inkP = Σ(i · opacity_i) / Σ(opacity_i) / (N − 1)
// Konsequenz: fully-solo Phase k lands den Ink exakt auf Dot k.
// Crossfade zwischen k und k+1 sliced die Ink smooth mit derselben
// easeOut-Kurve die die Phasen benutzen — Ink und Type atmen als
// eins, nicht zufaellig sondern per Identitaet.
//
// Kein Video, kein Glow-Overkill. Amber-Akzent in amber-700 (#f59e0b)
// fuer Kontrast auf Cream statt amber-500 im Dark-Kontext.

import { SECTION4 } from '../../lib/constants';

// Phase 06 ("Und jetzt du") lebt in Section 6 als Closing-Moment.
// Section 5 zeigt Phasen 01-05.
const phases = SECTION4.phases.slice(0, 5);
---

<section class="section-5" aria-labelledby="section-5-headline">
  <div class="section-5-sticky" style="--ink-progress:0">
    <!-- Cream Werkstatt-BG (immer da, initial durch Overlays verdeckt) -->
    <div class="werkstatt-bg" aria-hidden="true"></div>
    <!-- Blaupausen-Textur ueber Cream -->
    <div class="werkstatt-blueprint" aria-hidden="true"></div>

    <!-- Horizon-Split Overlays -->
    <div class="horizon-top" aria-hidden="true"></div>
    <div class="horizon-bottom" aria-hidden="true"></div>
    <div class="horizon-hairline" aria-hidden="true"></div>

    <!-- Werkstatt-Content: 3-Row Grid (Header / Stage / Rail) -->
    <div class="werkstatt-content">
      <header class="werkstatt-header">
        <p class="werkstatt-eyebrow">{SECTION4.eyebrow}</p>
        <h2 class="werkstatt-headline" id="section-5-headline">{SECTION4.title}</h2>
      </header>

      <div class="phase-stage">
        {phases.map((phase, i) => (
          <article class="phase-card" data-i={i}>
            <p class="phase-label" aria-hidden="true">{phase.label}</p>
            <h3 class="phase-title">{phase.title}</h3>
            <p class="phase-body">{phase.body}</p>
            {'link' in phase && phase.link && (
              <a class="phase-link" href={phase.link.href}>
                {phase.link.label} →
              </a>
            )}
          </article>
        ))}
      </div>

      <!-- Horizontal Fahrplan-Rail: Track + amber Flow-Line + 5 Dots -->
      <div class="fahrplan-rail" aria-hidden="true">
        <div class="fahrplan-track"></div>
        <div class="fahrplan-flow"></div>
        {phases.map((_, i) => (
          <span
            class="fahrplan-dot"
            data-i={i}
            style={`left: ${(i / (phases.length - 1)) * 100}%`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.section-5');
  const sticky = document.querySelector<HTMLElement>('.section-5-sticky');
  const stage = document.querySelector<HTMLElement>('.phase-stage');
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.fahrplan-dot'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.phase-card'));

  if (section && sticky && stage) {
    // Horizon-Split laengere Choreografie (0.08→0.15) damit das
     // Aufmachen NICHT ueberrumpelt beim schnellen Scrollen. Header-
     // Emerge verschoben auf 0.15-0.21, danach direkt in Phase 01.
    const HORIZON_END = 0.15;
    const HEADER_START = 0.15;
    const HEADER_END = 0.21;

    // 5 Phasen, alle um +0.06 gegen die vorige Config verschoben um
    // dem laengeren Horizon-Split Platz zu machen. Letzte Phase (05)
    // fadet BEWUSST NICHT innerhalb [0,1] aus — Ranges >1.0.
    const phasesConfig = [
      { fadeIn: [0.22, 0.28], fadeOut: [0.36, 0.42] },
      { fadeIn: [0.36, 0.42], fadeOut: [0.50, 0.56] },
      { fadeIn: [0.50, 0.56], fadeOut: [0.64, 0.70] },
      { fadeIn: [0.64, 0.70], fadeOut: [0.78, 0.84] },
      { fadeIn: [0.78, 0.84], fadeOut: [1.02, 1.05] },
    ];

    // Horizontal-Offset fuer Phase-Cards. Incoming startet -200px links
    // vom Center, driftet zu 0. Outgoing driftet weiter zu +200px rechts.
    // Dramatisch genug damit "fliegen" sichtbar wird, in Kombination mit
    // Motion-Blur (CSS: filter: blur gebunden an opacity) fuer cinematic
    // Feel. Scale delta 0.88→1 (vorher 0.94→1) verstaerkt den "in-die-
    // Ferne-driften"-Eindruck beim Rausfliegen.
    const OFFSET_X_PX = 200;

    const clamp = (v: number, min = 0, max = 1) => Math.max(min, Math.min(max, v));
    const mapRange = (v: number, [a, b]: number[]) =>
      clamp((v - a) / (b - a));
    // easeOut-quad — sanfter am Bewegungsende
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 2);
    const fadeCurve = (v: number, [inA, inB]: number[], [outA, outB]: number[]) => {
      if (v < inA) return 0;
      if (v < inB) return easeOut(mapRange(v, [inA, inB]));
      if (v < outA) return 1;
      if (v < outB) return 1 - easeOut(mapRange(v, [outA, outB]));
      return 0;
    };
    const offsetCurveX = (v: number, [inA, inB]: number[], [outA, outB]: number[]) => {
      if (v < inA) return -OFFSET_X_PX;
      if (v < inB) return -OFFSET_X_PX * (1 - easeOut(mapRange(v, [inA, inB])));
      if (v < outA) return 0;
      if (v < outB) return OFFSET_X_PX * easeOut(mapRange(v, [outA, outB]));
      return OFFSET_X_PX;
    };

    let sectionHeight = 0;
    let lastActiveIndex = -1;

    const measure = () => {
      sectionHeight = section.offsetHeight - window.innerHeight;
    };
    measure();

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const raw = -rect.top / sectionHeight;
      const progress = clamp(raw);

      // Horizon-Split (0..0.08)
      sticky.style.setProperty(
        '--horizon-progress',
        mapRange(progress, [0, HORIZON_END]).toFixed(4)
      );

      // Header-Emerge (0.08..0.14)
      sticky.style.setProperty(
        '--header-progress',
        mapRange(progress, [HEADER_START, HEADER_END]).toFixed(4)
      );

      // Phase-Cards: opacity + horizontal offset + scale, alle in einem Loop.
      // Gleichzeitig: Zentroid der Phase-Opacities aggregieren fuer Ink-Sync.
      const N = cards.length;
      const EPS = 1e-4;
      let sumO = 0;
      let sumIO = 0;
      let maxOpacity = 0;
      let activeIndex = -1;

      cards.forEach((card, i) => {
        const cfg = phasesConfig[i];
        const o = fadeCurve(progress, cfg.fadeIn, cfg.fadeOut);
        const offsetX = offsetCurveX(progress, cfg.fadeIn, cfg.fadeOut);
        // Groesserer Scale-Delta (0.88→1) fuer sichtbareres In-Die-
        // Ferne-Driften. Skaliert nichtlinear via opacity als Proxy.
        const scale = 0.88 + 0.12 * o;

        card.style.setProperty('--phase-opacity', o.toFixed(4));
        card.style.setProperty('--phase-offset-x', `${offsetX.toFixed(2)}px`);
        card.style.setProperty('--phase-scale', scale.toFixed(4));
        card.style.pointerEvents = o > 0.5 ? 'auto' : 'none';

        sumO += o;
        sumIO += i * o;
        if (o > maxOpacity) {
          maxOpacity = o;
          activeIndex = i;
        }
      });

      // Ink-Progress via Zentroid — teilt die easeOut-Kurve der Phasen,
      // Ink und Type atmen als eins. Fallback: parked links vor phase 0,
      // parked rechts nach phase 4.
      const firstFadeInStart = phasesConfig[0].fadeIn[0];
      const inkP =
        N > 1 && sumO > EPS
          ? sumIO / sumO / (N - 1)
          : progress < firstFadeInStart
            ? 0
            : 1;
      sticky.style.setProperty('--ink-progress', inkP.toFixed(4));

      // Preserve last-known active dot wenn alle opacities briefly vanish
      // (extremes Scrollen im settle-tail) — verhindert Flicker.
      if (activeIndex !== -1) {
        lastActiveIndex = activeIndex;
      } else if (lastActiveIndex !== -1) {
        activeIndex = lastActiveIndex;
      }
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === activeIndex);
        dot.classList.toggle('is-passed', i < activeIndex);
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    let resizeTimer: number | undefined;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        update();
      }, 120);
    };

    // Reduced-Motion Fallback: alles auf end-state pinnen, keine Transitions
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const applyReducedMotion = () => {
      if (reducedMotion.matches) {
        sticky.style.setProperty('--horizon-progress', '1');
        sticky.style.setProperty('--header-progress', '1');
        sticky.style.setProperty('--ink-progress', '1');
        cards.forEach((card, i) => {
          card.style.setProperty('--phase-opacity', i === cards.length - 1 ? '1' : '0');
          card.style.setProperty('--phase-offset-x', '0px');
          card.style.setProperty('--phase-scale', '1');
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-active', i === dots.length - 1);
          dot.classList.toggle('is-passed', i < dots.length - 1);
        });
      } else {
        update();
      }
    };
    reducedMotion.addEventListener('change', applyReducedMotion);
    applyReducedMotion();

    // Reduced-Motion: alle phase-scale auf 1 pinnen zusaetzlich zu offset
    if (reducedMotion.matches) {
      cards.forEach((card) => {
        card.style.setProperty('--phase-scale', '1');
      });
    }

    if (!reducedMotion.matches) {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize);
      update();
    }
  }
</script>

<style>
  /* === Section-Root ===
     min-height treibt die Scroll-Dauer der Sticky-Choreografie.
     280vh = 180vh Sticky-Verweildauer, ~36vh pro Phase (vorher ~50vh).
     Fuehlt sich punchiger an ohne die Choreografie zu hetzen. */
  .section-5 {
    position: relative;
    min-height: 280vh;
    background: #050507;
  }

  @media (max-width: 768px) {
    .section-5 {
      min-height: 250vh;
    }
  }

  .section-5-sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;

    --horizon-progress: 0;
    --header-progress: 0;
    --ink-progress: 0;
  }

  /* === Cream Werkstatt-BG === */
  .werkstatt-bg {
    position: absolute;
    inset: 0;
    background: #f7f0dd;
    z-index: 0;
  }

  /* Blaupausen-Textur: 32px Cross-Grid amber-700 mit 5% Opacity —
     subtil, Werkstatt-Charakter. */
  .werkstatt-blueprint {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(245, 158, 11, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(245, 158, 11, 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    z-index: 1;
    opacity: calc(var(--horizon-progress) * 0.9);
    pointer-events: none;
  }

  /* === Horizon-Split Overlays === */
  .horizon-top,
  .horizon-bottom {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    background: #050507;
    z-index: 10;
    will-change: transform;
  }

  .horizon-top {
    top: 0;
    transform: translateY(calc(-100% * var(--horizon-progress)));
  }

  .horizon-bottom {
    bottom: 0;
    transform: translateY(calc(100% * var(--horizon-progress)));
  }

  .horizon-hairline {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    margin-top: -0.5px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(245, 158, 11, 0.85) 20%,
      rgba(245, 158, 11, 0.95) 50%,
      rgba(245, 158, 11, 0.85) 80%,
      transparent 100%
    );
    z-index: 11;
    opacity: calc(1 - var(--horizon-progress) * 1.2);
  }

  /* === Werkstatt-Content: 4-Row Grid Header/Stage/Rail/Breath ===
     4. Row als 0.6fr Bottom-Breath schiebt den Rail visuell nach oben,
     damit er nicht am Section-Rand klebt (matcht die Content-Zentrierung
     der anderen Sections). Symmetrische Top/Bottom Paddings zusaetzlich. */
  .werkstatt-content {
    position: relative;
    z-index: 5;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto 0.6fr;
    row-gap: clamp(30px, 5vh, 60px);
    align-items: center;
    justify-items: center;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(120px, 15vh, 160px) 40px clamp(80px, 12vh, 120px);
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .werkstatt-content {
      padding: 110px 20px 80px;
      row-gap: 32px;
    }
  }

  @media (max-height: 780px) {
    .werkstatt-content {
      padding-top: 100px;
      padding-bottom: 60px;
      row-gap: 24px;
    }
  }

  /* === Header (emerged aus der Fuge) === */
  .werkstatt-header {
    text-align: center;
    max-width: 720px;
    opacity: var(--header-progress);
    transform: translateY(calc(12px * (1 - var(--header-progress))));
    transition: opacity 100ms linear, transform 100ms linear;
  }

  .werkstatt-eyebrow {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: #f59e0b;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  .werkstatt-headline {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #1a1a1c;
    margin: 0;
  }

  /* === Phase-Stage: Single-Center-Stage mit Horizontal-Flow ===
     Alle Cards absolut positioniert, driven by --phase-offset-x + scale
     + opacity. Left-to-Right Sweep: -96px links → 0 (center) → +96px
     rechts. Cards ueberschneiden sich nie visuell weil sie raeumlich
     getrennt sind waehrend des Crossfade. */
  .phase-stage {
    position: relative;
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    min-height: 380px;
    display: block;
  }

  @media (max-width: 768px) {
    .phase-stage {
      min-height: 320px;
    }
  }

  @media (max-height: 780px) {
    .phase-stage {
      min-height: 320px;
    }
  }

  /* Phase-Card centered + cinematic fly-in/fly-out.
     - align-items:center + text-align:center → Content horizontal zentriert
     - justify-content:flex-start + padding-top → Content START ist konstant,
       damit PHASE 0X und Titel bei allen 5 Phasen auf derselben Y-Position
       sitzen unabhaengig von Body-Laenge (sonst driftet Titel nach oben
       bei laengerem Body weil Group-Center hoch geht).
     - translateX 200px + scale 0.88→1 + blur 6px→0 gebunden an opacity
       → sichtbares Fliegen/Driften
     - transform-origin center center — Skalierung symmetrisch um Karten-
       mitte statt links-verankert
     - Transitions duration erhoeht (opacity 620ms, transform 780ms) */
  .phase-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: flex-start;
    align-items: center;
    text-align: center;
    padding-top: clamp(20px, 4vh, 50px);
    opacity: var(--phase-opacity, 0);
    transform:
      translate3d(var(--phase-offset-x, -200px), 0, 0)
      scale(var(--phase-scale, 0.88));
    transform-origin: center center;
    transition:
      opacity 620ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 780ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .phase-card {
      gap: 14px;
      padding-top: 16px;
    }
  }

  /* Groessere Blueprint-Numerale — freed from 60px left rail constraint.
     Outlined via -webkit-text-stroke in charcoal fuer editorial Look. */
  .phase-label {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(3.8rem, 9vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(26, 26, 28, 0.4);
    text-stroke: 1.5px rgba(26, 26, 28, 0.4);
    margin: 0;
  }

  .phase-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #1a1a1c;
    margin: 0;
  }

  .phase-body {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.55;
    color: rgba(26, 26, 28, 0.72);
    max-width: 620px;
    margin: 0 auto;
  }

  .phase-link {
    display: inline-block;
    margin-top: 4px;
    padding: 0;
    color: #f59e0b;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(245, 158, 11, 0.4);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    padding-bottom: 1px;
    align-self: center;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease;
  }

  .phase-link:hover,
  .phase-link:focus-visible {
    color: #d97706;
    border-color: rgba(245, 158, 11, 0.8);
    outline: none;
  }

  /* === Horizontal Fahrplan-Rail (unter Phase-Stage) ===
     Dot-Positionen via inline style (i / (N-1) * 100%) — robuster als
     nth-child weil die Element-Reihenfolge track/flow/dots leichter
     brechbar ist. Amber Flow-Line scaled X von 0 → 1 based on
     --ink-progress (Zentroid der Phase-Opacities). */
  .fahrplan-rail {
    position: relative;
    width: 100%;
    max-width: 780px;
    height: 20px;
    display: block;
  }

  .fahrplan-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    height: 1.5px;
    background: rgba(245, 158, 11, 0.15);
    border-radius: 1px;
    pointer-events: none;
  }

  .fahrplan-flow {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: #f59e0b;
    border-radius: 1px;
    transform-origin: left center;
    transform: translateY(-50%) scaleX(var(--ink-progress, 0));
    transition: transform 120ms linear;
    pointer-events: none;
  }

  .fahrplan-dot {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f7f0dd;
    border: 1.5px solid rgba(245, 158, 11, 0.4);
    transform: translate(-50%, -50%);
    box-sizing: border-box;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      width 200ms ease,
      height 200ms ease,
      box-shadow 200ms ease;
  }

  .fahrplan-dot.is-passed {
    background: rgba(245, 158, 11, 0.85);
    border-color: rgba(245, 158, 11, 0.85);
  }

  .fahrplan-dot.is-active {
    width: 14px;
    height: 14px;
    background: #f59e0b;
    border-color: #f59e0b;
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15);
  }

  /* === Reduced Motion === */
  @media (prefers-reduced-motion: reduce) {
    .horizon-top,
    .horizon-bottom,
    .horizon-hairline,
    .werkstatt-header,
    .phase-card,
    .fahrplan-flow,
    .fahrplan-dot {
      transition: none !important;
    }
  }
</style>
