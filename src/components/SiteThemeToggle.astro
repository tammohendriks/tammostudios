---
/**
 * SiteThemeToggle — iOS-style Slider fuer Dark ↔ Light Mode, site-wide.
 *
 * Scope: alle Sub-Pages ausser Landing. Wird von BaseLayout aus gerendert
 * wenn !isLanding — nicht individuell pro Page importieren.
 *
 * Persistierung: localStorage 'site-theme' = 'dark' | 'light'.
 * FOUC-Prevention: BaseLayout hat einen is:inline script der das
 * data-site-theme Attribut auf <html> setzt BEVOR die Page rendert.
 * Dieses Component reagiert nur auf User-Klicks und schreibt in
 * localStorage.
 *
 * Toggle-Positionierung: position:fixed top-right unter TopBar, sichtbar
 * ueber Content-Scroll. Solid dunkles Pill matched TopBar-Aesthetik in
 * BEIDEN Themes (Toggle ist Nav, nicht Content).
 *
 * Legacy: fruehere JournalThemeToggle-Component nutzte localStorage-Key
 * 'journal-theme'. BaseLayout inline-script migriert den Key nach
 * 'site-theme' bevor er ausgewertet wird → nahtloser Upgrade.
 *
 * Uebergang: der neue Zustand wird als Kreis vom Knopf aus aufgezogen,
 * ueber dem alten. Das Bild dahinter ist ein Lichtschalter — Helligkeit
 * breitet sich von der Stelle aus, an der man sie eingeschaltet hat.
 * Technisch ueber die View-Transitions-API; wo die fehlt, schaltet es
 * wie vorher sofort um.
 */
import { t } from '../lib/i18n';

export interface Props {
  /**
   * Erst unterhalb des Heros einblenden.
   *
   * Fuer die Branchenseiten: deren Hero ist ein Foto und bleibt in
   * beiden Themen gleich. Ein Schalter, der dort sichtbar ist und
   * nichts bewirkt, liest sich als kaputt. Weiter unten schaltet die
   * ganze Seite um — dort gehoert er hin.
   */
  nachHero?: boolean;
}

const { nachHero = false } = Astro.props;

const d = t(Astro.url.pathname);
---

<button
  type="button"
  class="site-theme-toggle"
  data-site-theme-toggle
  data-nach-hero={nachHero ? '' : undefined}
  aria-label={d.thema.umschalten}
  data-label-hell={d.thema.aktuellHell}
  data-label-dunkel={d.thema.aktuellDunkel}
>
  <span class="site-theme-track" aria-hidden="true">
    <span class="site-theme-icon site-theme-icon-moon">
      <svg viewBox="0 0 12 12" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.2 7.5A4.5 4.5 0 013.5 1.8a4.5 4.5 0 105.7 5.7z" />
      </svg>
    </span>
    <span class="site-theme-icon site-theme-icon-sun">
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg">
        <circle cx="6" cy="6" r="2.2" fill="currentColor" stroke="none" />
        <line x1="6" y1="0.5" x2="6" y2="2" />
        <line x1="6" y1="10" x2="6" y2="11.5" />
        <line x1="0.5" y1="6" x2="2" y2="6" />
        <line x1="10" y1="6" x2="11.5" y2="6" />
        <line x1="2.1" y1="2.1" x2="3.15" y2="3.15" />
        <line x1="8.85" y1="8.85" x2="9.9" y2="9.9" />
        <line x1="9.9" y1="2.1" x2="8.85" y2="3.15" />
        <line x1="2.1" y1="9.9" x2="3.15" y2="8.85" />
      </svg>
    </span>
    <span class="site-theme-thumb"></span>
  </span>
</button>

<script>
  /* Einblenden, sobald der Hero weitgehend durchgescrollt ist.
     Laeuft nur, wenn der Knopf data-nach-hero traegt — auf allen
     anderen Seiten steht er wie bisher sofort da.

     Gemessen wird die Unterkante des Heros, nicht scrollY: der Hero
     ist 100dvh hoch, und das ist auf dem Handy je nach Adressleiste
     eine andere Zahl. */
  (() => {
    const schalter = document.querySelector<HTMLElement>(
      '.site-theme-toggle[data-nach-hero]'
    );
    const hero = document.querySelector<HTMLElement>('.v-hero');
    if (!schalter || !hero) return;

    let geplant = false;
    const pruefen = () => {
      geplant = false;
      const unten = hero.getBoundingClientRect().bottom;
      if (unten < window.innerHeight * 0.35) schalter.dataset.sichtbar = '';
      else delete schalter.dataset.sichtbar;
    };
    const anstossen = () => {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(pruefen);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen, { passive: true });
    // Beim Laden einmal pruefen: der Browser stellt beim Zurueck-
    // Navigieren die alte Scrollposition wieder her, und die kann
    // schon weit unterhalb des Heros liegen.
    pruefen();
  })();

  const btn = document.querySelector<HTMLButtonElement>(
    '[data-site-theme-toggle]'
  );
  if (btn) {
    // Beschriftung gleich beim Laden auf den aktuellen Zustand setzen.
    // Vorher stand dort die allgemeine Fassung ("Dark / Light") und
    // erst nach dem ersten Klick die mit Zustand — derselbe Knopf hat
    // sich also unterschiedlich gemeldet, je nachdem ob man ihn schon
    // benutzt hatte.
    const zustandMelden = () => {
      const hell = document.documentElement.getAttribute('data-site-theme') === 'light';
      const label = hell ? btn.dataset.labelHell : btn.dataset.labelDunkel;
      if (label) btn.setAttribute('aria-label', label);
    };
    zustandMelden();

    // Zaehler fuer die laufenden Wechsel. Wer zweimal schnell klickt,
    // bricht den ersten Uebergang ab; dessen Aufraeumen darf dann nicht
    // das Merkmal des zweiten wegnehmen, sonst laeuft der zweite ohne
    // Animation.
    let laufenderWechsel = 0;
    // Der eigentliche Umschaltvorgang. Steht als eigene Funktion da,
    // weil die View-Transitions-API ihn als Rueckruf braucht: sie macht
    // vorher eine Aufnahme der Seite, ruft dann das hier, macht danach
    // eine zweite Aufnahme und blendet zwischen beiden.
    const umschalten = () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-site-theme');
      const next = current === 'light' ? 'dark' : 'light';
      if (next === 'light') {
        html.setAttribute('data-site-theme', 'light');
      } else {
        html.removeAttribute('data-site-theme');
      }
      try {
        localStorage.setItem('site-theme', next);
      } catch (_) {
        // private-mode etc. — no persistence, but toggle still works session
      }
      zustandMelden();
    };

    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Ohne die API oder bei reduzierter Bewegung schaltet es sofort
      // um, genau wie vorher. Der Uebergang ist Zierde, nicht Funktion.
      if (reduziert || typeof document.startViewTransition !== 'function') {
        umschalten();
        return;
      }

      // Mitte des Knopfes als Ursprung des Kreises, dazu der Radius bis
      // zur entferntesten Ecke des Fensters — sonst bliebe eine Ecke
      // unbedeckt, wenn der Kreis fertig aufgezogen ist.
      const kasten = btn.getBoundingClientRect();
      const x = kasten.left + kasten.width / 2;
      const y = kasten.top + kasten.height / 2;
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );
      html.style.setProperty('--thema-x', `${x}px`);
      html.style.setProperty('--thema-y', `${y}px`);
      html.style.setProperty('--thema-r', `${radius}px`);
      html.dataset.themaWechsel = '';

      const meiner = ++laufenderWechsel;
      const aufraeumen = () => {
        if (meiner === laufenderWechsel) delete html.dataset.themaWechsel;
      };
      const uebergang = document.startViewTransition(umschalten);
      // then(f, f) statt finally: finished wird abgelehnt, wenn der
      // Uebergang abgebrochen wird, und finally wuerfe die Ablehnung
      // weiter — als unbehandelte Ablehnung in der Konsole.
      uebergang.finished.then(aufraeumen, aufraeumen);
    });
  }
</script>

{/* Wie der UEBERGANG beim Umschalten aussieht, steht als
    is:inline-Stil im Kopf des BaseLayouts — dort muss er stehen, damit
    die Regeln im ersten Parse-Durchgang greifen. Das Aussehen des
    Knopfes selbst gehoert dagegen hierher. */}

<style>
  .site-theme-toggle {
    position: fixed;
    top: 88px;
    right: 24px;
    z-index: 50;
    padding: 6px 8px;
    background: rgba(5, 5, 7, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  /* Ueber dem Hero nicht da, darunter schon. Kein display: none,
     sondern Deckkraft: so laesst es sich weich einblenden, und der
     Knopf behaelt seinen Platz im Fokus-Ablauf erst, wenn er
     sichtbar ist (pointer-events + inert waere doppelt gemoppelt,
     tabindex setzt das Skript nicht — der Knopf ist dann zwar
     fokussierbar, aber auch erreichbar, sobald man dorthin
     scrollt). */
  .site-theme-toggle[data-nach-hero] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-8px);
    transition:
      opacity 280ms ease,
      transform 280ms ease,
      border-color 200ms ease;
  }

  .site-theme-toggle[data-nach-hero][data-sichtbar] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .site-theme-toggle:hover {
    border-color: rgba(245, 158, 11, 0.5);
  }

  .site-theme-toggle:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.95);
    outline-offset: 2px;
  }

  /* Absolute-Positionen fuer Icons + Thumb — Center matched exakt in
     beiden States (dark thumb-center = moon-center, light = sun-center). */
  .site-theme-track {
    position: relative;
    display: block;
    width: 52px;
    height: 22px;
    border-radius: 999px;
    box-sizing: border-box;
  }

  /* SVG icons statt emoji — deterministisches Rendering, keine
     Platform-abhaengigen Glyphen-Metriken. Beide icons sind 12x12,
     sitzen absolut positioniert, ihr Bounding-Box-Center matched
     exakt mit dem Thumb-Center in beiden States. */
  .site-theme-icon {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 12px;
    height: 12px;
    color: rgba(245, 245, 244, 0.7);
    transform: translateY(-50%);
    transition: color 200ms ease;
    display: block;
  }
  .site-theme-icon svg {
    display: block;
    width: 12px;
    height: 12px;
  }
  .site-theme-icon-moon { left: 4px; }   /* Center: 4 + 6 = 10 */
  .site-theme-icon-sun  { left: 36px; }  /* Center: 36 + 6 = 42 */

  .site-theme-thumb {
    position: absolute;
    top: 2px;
    left: 1px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(245, 158, 11, 0.95);
    transition: transform 220ms cubic-bezier(0.4, 0.0, 0.2, 1);
    z-index: 1;
  }

  :global(html[data-site-theme='light']) .site-theme-thumb {
    transform: translateX(32px);
  }
  :global(html[data-site-theme='light']) .site-theme-icon-moon {
    color: rgba(245, 245, 244, 0.4);
  }
  :global(html:not([data-site-theme='light'])) .site-theme-icon-sun {
    color: rgba(245, 245, 244, 0.4);
  }

  /* Bestandsfehler, hier mitbehoben: TopBar setzt beim Oeffnen des
     Mobile-Menues data-menu-open auf <html>, dieser Schalter hat aber
     nie darauf reagiert und schwebte mit z-index 50 ueber dem Menue
     (z-index 45). Faellt erst auf, seit ein zweiter Schalter daneben
     sitzt — einer, der verschwindet, und einer, der bleibt. */
  :global(html[data-menu-open]) .site-theme-toggle {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    /* Unter TopBar-Bottom (mobile TopBar ~76px hoch, top:90 = 14px Luft) */
    .site-theme-toggle {
      top: 90px;
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-theme-thumb {
      transition: none;
    }

    .site-theme-toggle[data-nach-hero] {
      transform: none;
      transition: none;
    }
  }
</style>
