---
/**
 * Fehlerseite, in der Sprache des aufgerufenen Pfads.
 *
 * Liegt als Komponente, weil es zwei Zugaenge gibt: die statische
 * /404-Seite, die Vercel fuer alles Unbekannte ausliefert, und die
 * Sammelroute unter /en, die serverseitig laeuft und einen echten
 * 404-Status setzen kann. Ohne die zweite bekaeme ein englischer
 * Besucher eine deutsche Fehlerseite.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from './SubPageBackground.astro';
import SiteFooter from './SiteFooter.astro';
import { SITE } from '../lib/constants';
import { localeOf, pathOr } from '../lib/routes.mjs';
import { NICHT_GEFUNDEN } from '../lib/i18n/seiten/nichtGefunden';

const locale = localeOf(Astro.url.pathname);
const d = NICHT_GEFUNDEN[locale];
---

<BaseLayout pageTitle={d.pageTitle} description={d.description} noindex>
  <main class="error-page">
    <SubPageBackground />

    <header class="error-hero">
      <h1 class="subpage-hero-title">{d.headline}</h1>
      <p class="subpage-hero-subtitle">{d.sub}</p>
    </header>

    <section class="error-actions">
      <a class="error-link error-link-primary" href={pathOr('home', locale)}>
        <span>{d.cta}</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <p class="error-secondary">
        {d.schreibMir}
        {' '}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .error-page {
    position: relative;
    background: #050507;
    padding: 140px 40px 80px;
    min-height: calc(100vh - 200px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .error-page {
      padding: 100px 20px 60px;
    }
  }

  .error-hero {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .error-hero .subpage-hero-subtitle {
    margin-top: 16px;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .error-actions {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .error-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #f5f5f4;
    text-decoration: none;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .error-link svg {
    color: rgba(245, 158, 11, 0.95);
    transition: transform 200ms ease;
  }

  .error-link:hover,
  .error-link:focus-visible {
    border-bottom-color: rgba(245, 158, 11, 0.6);
    outline: none;
  }

  .error-link:hover svg,
  .error-link:focus-visible svg {
    transform: translateX(3px);
  }

  .error-link-primary {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    font-weight: 600;
  }

  .error-secondary {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.9rem;
    color: rgba(245, 245, 244, 0.55);
    margin: 8px 0 0;
  }

  .error-secondary a {
    color: rgba(245, 158, 11, 0.85);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
    padding-bottom: 1px;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .error-secondary a:hover,
  .error-secondary a:focus-visible {
    color: rgba(245, 158, 11, 1);
    border-bottom-color: rgba(245, 158, 11, 0.7);
    outline: none;
  }

  /* Footer-Styles leben jetzt in SiteFooter.astro (Component-scoped). */
</style>
