---
/**
 * Liegt als Komponente und nicht in src/pages, weil es zwei Routen
 * darauf gibt: /ueber und /en/about. Markup und <style>-Block gehoeren
 * dabei zusammen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from './SubPageBackground.astro';
import SiteFooter from './SiteFooter.astro';
import ClosingCta from './ClosingCta.astro';
import { SITE } from '../lib/constants';
import { absUrl, localeOf, path, pathOr } from '../lib/routes.mjs';
import { UEBER } from '../lib/i18n/seiten/ueber';

const locale = localeOf(Astro.url.pathname);
const d = UEBER[locale];

const preisePfad = path('preise', locale);
const werkstattPfad = path('werkstatt', locale);
const referenzenPfad = path('referenzen', locale);

// Standalone Person-Schema fuer /ueber. @id matcht die founder-
// Referenz in businessSchema (BaseLayout) — Google merged beide
// Entities. Standalone Definition erlaubt reichere Personal-Info
// (givenName/familyName, worksFor, sameAs, image) fuer ein eigenes
// Knowledge-Panel im Suchergebnis.
const personSchema = {
  '@type': 'Person',
  '@id': `${SITE.url}/#tammo`,
  name: 'Tammo Hendriks',
  givenName: 'Tammo',
  familyName: 'Hendriks',
  jobTitle: d.schema.jobTitle,
  description: d.schema.description,
  worksFor: { '@id': `${SITE.url}/#business` },
  // Die Adresse DIESER Sprachfassung, nicht fest die deutsche.
  url: absUrl(pathOr('ueber', locale)),
  image: `${SITE.url}/tammo-foto.webp`,
  sameAs: ['https://www.instagram.com/tammostudios/'],
  knowsAbout: d.schema.knowsAbout,
  nationality: { '@type': 'Country', name: d.schema.land },
  workLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Bremen',
      addressCountry: 'DE',
    },
  },
};
---

<BaseLayout
  pageTitle={d.meta.pageTitle}
  title={d.meta.title}
  description={d.meta.description}
  additionalSchema={personSchema}
>
  <main class="ueber-page">
    <SubPageBackground />

    <header class="ueber-hero">
      <div class="hero-text">
        <h1 class="subpage-hero-title">{d.hero.headline}</h1>
        <p class="subpage-hero-subtitle text-lines">{d.hero.sub}</p>
      </div>
      <div class="hero-mark">
        <img
          class="hero-photo"
          src="/tammo-foto.webp"
          alt={d.hero.fotoAlt}
          loading="eager"
          fetchpriority="high"
          width="480"
          height="480"
        />
      </div>
    </header>

    <article class="ueber-content">
      <section class="ueber-section" data-reveal>
        <h2>{d.werIchBin.headline}</h2>
        <p>{d.werIchBin.absatz1}</p>
        <p>{d.werIchBin.absatz2}</p>
      </section>

      <section class="ueber-section" data-reveal>
        <h2>{d.wieIchArbeite.headline}</h2>
        <p>{d.wieIchArbeite.absatz1}</p>
        <p>{d.wieIchArbeite.absatz2}</p>
        <p>{d.wieIchArbeite.absatz3}</p>
        <p>
          {d.wieIchArbeite.dauerVor}
          <strong>{d.wieIchArbeite.dauerTage}</strong>{d.wieIchArbeite.dauerMitte}
          <strong>{d.wieIchArbeite.dauerTage2}</strong>{d.wieIchArbeite.dauerNach}
        </p>
      </section>

      <section class="ueber-section" data-reveal>
        <h2>{d.kosten.headline}</h2>
        <p>
          {d.kosten.websiteVor} <strong>{d.kosten.websitePreis}</strong>{d.kosten.shopVor}
          <strong>{d.kosten.shopPreis}</strong>{d.kosten.nach}
        </p>
        {preisePfad && (
        <a class="cta-link" href={preisePfad}>
          <span>{d.kosten.cta}</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        )}
      </section>

      <section class="ueber-section" data-reveal>
        <h2>{d.ausserhalb.headline}</h2>
        <p>{d.ausserhalb.absatz1}</p>
        <p>{d.ausserhalb.absatz2}</p>
        {werkstattPfad && (
        <a class="cta-link" href={werkstattPfad}>
          <span>{d.ausserhalb.cta}</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        )}
      </section>

      <ClosingCta
        recommendation={
          referenzenPfad
            ? { text: d.empfehlung.text, label: d.empfehlung.label, href: referenzenPfad }
            : undefined
        }
      />
    </article>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .ueber-page {
    position: relative;
    background: #050507;
    padding: 140px 40px 80px;
    min-height: calc(100vh - 200px);
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .ueber-page {
      padding: 100px 20px 60px;
    }
  }

  /* Atmosphäre liegt jetzt in <SubPageBackground /> — gemeinsame
     Komponente für /ueber, /referenzen, /preise. */

  /* === Hero: 55/45 Grid auf Desktop, Stack auf Mobile (Foto zuerst).
     45-Anteil und 1200px max-width geben der Photo-Spalte ~520px,
     genug für 480px Photo + Atemraum. */
  .ueber-hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    gap: 60px;
    /* WAR: align-items:center — H1 landete relativ zum 480er-Foto in der
       Mitte, sass visuell tiefer als auf /referenzen /preise /journal.
       JETZT: start — H1 an gleicher Baseline wie andere Sub-Pages. Foto
       via .hero-mark align-self:center weiter vertikal zentriert. */
    align-items: start;
    max-width: 1200px;
    margin: 0 auto 96px;
  }

  /* Desktop: H1 padding-top matcht ref-hero/preise-hero/journal-hero →
     H1-Baseline auf identischer Y-Position ueber alle Sub-Pages. Photo
     bleibt via align-self:center vertikal in der Grid-Row zentriert. */
  @media (min-width: 769px) {
    .hero-text {
      padding-top: 32px;
    }
    .hero-mark {
      align-self: center;
    }
  }

  @media (max-width: 768px) {
    .ueber-hero {
      grid-template-columns: 1fr;
      gap: 36px;
      text-align: center;
      margin-bottom: 72px;
    }
    .hero-mark {
      order: -1;
      justify-self: center;
    }
  }

  /* Typografie der H1 + Subtitle kommt aus .subpage-hero-title /
     .subpage-hero-subtitle in global.css — hier nur layout-spezifisch
     der max-width und das Mobile-Centering. */
  .subpage-hero-subtitle {
    max-width: 520px;
  }

  @media (max-width: 768px) {
    .subpage-hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* === Foto-Avatar: rundes Bild mit amber Ring + Glow-Aura.
     ::after-Pseudo legt eine subtile Vignette an die Innenkanten,
     damit das Foto nicht hart gegen den Hintergrund schneidet. */
  .hero-mark {
    position: relative;
    width: min(480px, 100%);
    aspect-ratio: 1 / 1;
    justify-self: end;
    isolation: isolate;
  }

  @media (max-width: 768px) {
    .hero-mark {
      width: 140px;
      justify-self: center;
    }
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    display: block;
    box-shadow:
      0 0 80px rgba(245, 158, 11, 0.25),
      inset 0 0 0 2px rgba(245, 158, 11, 0.4);
  }

  /* Innenkanten-Vignette: weiches dunkles Gradient an den Rändern,
     damit das Foto sauber in den Hintergrund übergeht. */
  .hero-mark::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      transparent 55%,
      rgba(0, 0, 0, 0.25) 100%
    );
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .hero-photo {
      box-shadow:
        0 0 40px rgba(245, 158, 11, 0.25),
        inset 0 0 0 2px rgba(245, 158, 11, 0.4);
    }
  }

  /* === Content: einspaltig zentriert, max-width für Lesbarkeit */
  .ueber-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .ueber-section {
    margin-bottom: 56px;
  }

  .ueber-section:last-of-type {
    margin-bottom: 32px;
  }

  /* Section-Headline mit vertikaler Amber-Bar links — 3px breit,
     volle Höhe der Headline. Padding-left schiebt den Text rechts
     vom Bar-Position weg. */
  .ueber-content h2 {
    position: relative;
    padding-left: 18px;
    margin: 0 0 20px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #f5f5f4;
  }

  .ueber-content h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: rgba(245, 158, 11, 0.9);
    border-radius: 2px;
  }

  .ueber-content p {
    margin: 0 0 18px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1.05rem, 1.15vw, 1.125rem);
    line-height: 1.7;
    color: rgba(245, 245, 244, 0.78);
  }

  .ueber-content p:last-child {
    margin-bottom: 0;
  }

  .ueber-content strong {
    color: #f5f5f4;
    font-weight: 600;
  }

  /* Inline-Link mit amber Pfeil — leiser als ein Pill-Button.
     Funktioniert auf <a> und <button> identisch — Browser-Defaults
     werden hier explizit zurückgesetzt, damit ein semantischer
     Button-Trigger (z.B. fürs Kontakt-Modal) nicht wie ein nativer
     Button rendert. */
  .inline-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    color: #f5f5f4;
    text-decoration: none;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 1rem;
    padding: 0 0 1px;
    cursor: pointer;
    transition: border-color 200ms ease, color 200ms ease;
    margin-top: 8px;
  }

  .inline-link svg {
    color: rgba(245, 158, 11, 0.95);
    transition: transform 200ms ease;
    flex-shrink: 0;
  }

  .inline-link:hover,
  .inline-link:focus-visible {
    border-bottom-color: rgba(245, 158, 11, 0.6);
    color: #fff;
    outline: none;
  }

  .inline-link:hover svg,
  .inline-link:focus-visible svg {
    transform: translateX(3px);
  }

  /* Schluss-Block: bewusst leiser Ausstieg, leichtes Trennluft nach oben */

  /* Footer-Styles leben jetzt in SiteFooter.astro (Component-scoped). */
</style>
