---
// Hintergrund fuer /werkstatt — der einzige Ort auf der Seite, der
// spielen darf. Statt der ruhigen Glows von <SubPageBackground /> gibt
// es hier ein Canvas-Weltall: Sternenfeld mit Parallaxe, trudelnde
// Asteroiden und gelegentlich ein Schiff, das durchfliegt.
//
// Alles laeuft auf EINEM Canvas, weil ~60 animierte DOM-Knoten auf dem
// Handy teuer waeren. Das Canvas liegt hinter dem Inhalt (z-index 0)
// und faengt keine Zeiger-Events ab.
//
// Zwei Sparmassnahmen: der Loop pausiert, sobald das Tab im Hintergrund
// ist, und bei prefers-reduced-motion wird genau ein Standbild
// gezeichnet statt animiert.
---

<div class="werkstatt-bg" aria-hidden="true">
  <canvas class="werkstatt-bg-canvas" data-werkstatt-canvas></canvas>
  <div class="werkstatt-bg-vignette"></div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-werkstatt-canvas]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const AMBER = '245, 158, 11';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let w = 0;
    let h = 0;
    let dpr = 1;

    type Star = { x: number; y: number; r: number; a: number; vy: number };
    type Rock = {
      x: number; y: number; r: number;
      vx: number; vy: number;
      spin: number; angle: number;
      verts: number[];
    };
    type Ship = { x: number; y: number; vx: number; scale: number; trail: number };

    let stars: Star[] = [];
    let rocks: Rock[] = [];
    let ship: Ship | null = null;
    let nextShipAt = 0;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    // Asteroiden sind unregelmaessige Polygone: pro Ecke ein
    // Radius-Faktor, damit keiner wie ein Kreis aussieht.
    const makeRock = (x: number, y: number): Rock => {
      const corners = Math.round(rand(7, 10));
      const verts: number[] = [];
      for (let i = 0; i < corners; i++) verts.push(rand(0.68, 1.15));
      return {
        x, y,
        r: rand(14, 46),
        vx: rand(-0.16, 0.16),
        vy: rand(0.05, 0.22),
        spin: rand(-0.0016, 0.0016),
        angle: rand(0, Math.PI * 2),
        verts,
      };
    };

    const build = () => {
      const area = w * h;
      const starCount = Math.min(220, Math.round(area / 7000));
      const rockCount = Math.min(14, Math.round(area / 90000));

      stars = Array.from({ length: starCount }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: rand(0.4, 1.5),
        a: rand(0.18, 0.75),
        // Parallaxe: kleine Sterne stehen fast, grosse ziehen schneller
        vy: rand(0.015, 0.09),
      }));

      rocks = Array.from({ length: rockCount }, () =>
        makeRock(Math.random() * w, Math.random() * h)
      );
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
    };

    const drawRock = (r: Rock) => {
      ctx.save();
      ctx.translate(r.x, r.y);
      ctx.rotate(r.angle);
      ctx.beginPath();
      const n = r.verts.length;
      for (let i = 0; i < n; i++) {
        const a = (i / n) * Math.PI * 2;
        const rad = r.r * r.verts[i];
        const px = Math.cos(a) * rad;
        const py = Math.sin(a) * rad;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fillStyle = 'rgba(18, 18, 22, 0.55)';
      ctx.fill();
      ctx.strokeStyle = `rgba(${AMBER}, 0.22)`;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.restore();
    };

    const drawShip = (s: Ship) => {
      ctx.save();
      ctx.translate(s.x, s.y);
      ctx.scale(s.vx < 0 ? -s.scale : s.scale, s.scale);

      // Schweif
      const grad = ctx.createLinearGradient(-46, 0, -6, 0);
      grad.addColorStop(0, `rgba(${AMBER}, 0)`);
      grad.addColorStop(1, `rgba(${AMBER}, ${0.5 * s.trail})`);
      ctx.fillStyle = grad;
      ctx.fillRect(-46, -1.4, 40, 2.8);

      // Rumpf
      ctx.beginPath();
      ctx.moveTo(14, 0);
      ctx.lineTo(-6, -6);
      ctx.lineTo(-2, 0);
      ctx.lineTo(-6, 6);
      ctx.closePath();
      ctx.fillStyle = `rgba(${AMBER}, 0.85)`;
      ctx.fill();
      ctx.restore();
    };

    const render = (dt: number) => {
      ctx.clearRect(0, 0, w, h);

      for (const s of stars) {
        s.y += s.vy * dt;
        if (s.y > h + 2) {
          s.y = -2;
          s.x = Math.random() * w;
        }
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(245, 245, 244, ${s.a})`;
        ctx.fill();
      }

      for (const r of rocks) {
        r.x += r.vx * dt;
        r.y += r.vy * dt;
        r.angle += r.spin * dt;
        // Rundum-Wrap mit Rand, damit nichts sichtbar aufploppt
        const m = r.r + 8;
        if (r.x < -m) r.x = w + m;
        if (r.x > w + m) r.x = -m;
        if (r.y > h + m) {
          r.y = -m;
          r.x = Math.random() * w;
        }
        drawRock(r);
      }

      if (ship) {
        ship.x += ship.vx * dt;
        if (ship.x < -120 || ship.x > w + 120) ship = null;
        else drawShip(ship);
      }
    };

    let last = 0;
    let raf = 0;
    let running = false;

    const frame = (now: number) => {
      if (!running) return;
      // dt in 60fps-Einheiten, gedeckelt gegen Sprünge nach Tab-Wechsel
      const dt = last ? Math.min((now - last) / 16.67, 3) : 1;
      last = now;

      if (now > nextShipAt) {
        const fromLeft = Math.random() > 0.5;
        ship = {
          x: fromLeft ? -100 : w + 100,
          y: rand(h * 0.12, h * 0.85),
          vx: (fromLeft ? 1 : -1) * rand(1.6, 3.4),
          scale: rand(0.7, 1.25),
          trail: rand(0.5, 1),
        };
        nextShipAt = now + rand(9000, 20000);
      }

      render(dt);
      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (running || reduced.matches) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    const applyMotionPreference = () => {
      if (reduced.matches) {
        stop();
        // Ein einzelnes Standbild — die Seite bleibt bebildert,
        // nur eben ohne Bewegung.
        ctx.clearRect(0, 0, w, h);
        render(0);
      } else {
        nextShipAt = performance.now() + 2500;
        start();
      }
    };

    resize();
    applyMotionPreference();

    window.addEventListener('resize', () => {
      resize();
      if (reduced.matches) {
        ctx.clearRect(0, 0, w, h);
        render(0);
      }
    });

    reduced.addEventListener('change', applyMotionPreference);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (!reduced.matches) start();
    });
  }
</script>

<style>
  .werkstatt-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .werkstatt-bg-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Haelt die Sterne unten aus dem Footer-Uebergang raus und gibt dem
     Text oben etwas mehr Ruhe. */
  .werkstatt-bg-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 80% 55% at 50% 38%,
        rgba(5, 5, 7, 0.72) 0%,
        rgba(5, 5, 7, 0.3) 55%,
        transparent 100%
      ),
      linear-gradient(to bottom, transparent 70%, rgba(5, 5, 7, 0.85) 100%);
  }

  /* Im Light-Mode wuerde ein Sternenfeld auf Cream nur wie Schmutz
     wirken — dort bleibt der Hintergrund leer. */
  :global(html[data-site-theme='light']) .werkstatt-bg {
    display: none;
  }
</style>
