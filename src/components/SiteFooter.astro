---
// Shared Site-Footer für alle Pages + Landing-Closing-Section.
// Liest Nav-/Legal-Links und Copyright aus SECTION5.footer, damit
// die Datenquelle single-source bleibt.
//
// variant='default'        — standalone Footer am Seitenende (Sub-Pages).
//                            Background + Full-Padding + max-width Container.
// variant='embedded'       — Footer innerhalb einer flex-column Section
//                            (dark Landing-Sections). Kein Background, nur
//                            Border-Top + margin-top:auto.
// variant='embedded-cream' — Wie embedded, aber Charcoal-Text auf Cream —
//                            fuer die Cream-Landing-Section (Fahrplan/Closing).
export interface Props {
  variant?: 'default' | 'embedded' | 'embedded-cream';
}

const { variant = 'default' } = Astro.props;

import { SITE } from '../lib/constants';
import { t } from '../lib/i18n';
import { localeOf, path, pathOr } from '../lib/routes.mjs';

const d = t(Astro.url.pathname);
const locale = localeOf(Astro.url.pathname);

// Fussleiste aus Routen-Schluesseln statt aus festen Pfaden. Eintraege,
// die es in dieser Sprache nicht gibt (Journal auf Englisch), fallen
// ganz weg — eine Fussleiste ist Navigation, dort gehoert kein Verweis
// auf eine Seite hin, die in dieser Sprache nicht existiert.
// as const, damit die Schluessel ein Literal-Union sind und d.nav
// damit indiziert werden kann. Ohne das ist key einfach string, und
// der Typchecker laesst den Zugriff zu Recht nicht durch.
const FOOTER_KEYS = [
  'home', 'ueber', 'website', 'software', 'preise', 'werkstatt',
  'referenzen', 'journal',
] as const;
const navLinks = FOOTER_KEYS
  .map((key) => ({ key, href: path(key, locale) }))
  .filter((e): e is { key: (typeof FOOTER_KEYS)[number]; href: string } => e.href !== null)
  .map((e) => ({
    href: e.href,
    // 'website' traegt in der Fussleiste das Angebots-Label, so wie im
    // Kopf — der Eintrag zeigt auf die Angebots-Uebersicht.
    label: e.key === 'website' ? d.nav.angebot : d.nav[e.key],
  }));

// Rechtstexte bleiben deutsch. Auf englischen Seiten tragen die Links
// deshalb hreflang, damit klar ist, in welcher Sprache das ZIEL
// verfasst ist. NICHT lang: das beschreibt den Inhalt des Elements
// selbst, und der Linktext ist englisch ("Imprint (German)"). Mit
// lang="de" haette eine englische Sprachausgabe auf die deutsche Stimme
// umgeschaltet, um englischen Text vorzulesen.
const legalLinks = [
  { href: pathOr('impressum'), label: d.footer.impressum },
  { href: pathOr('datenschutz'), label: d.footer.datenschutz },
];
---

<footer class:list={['site-footer', `is-${variant}`]}>
  <div class="footer-row">
    <span class="footer-brand">{d.establishedLine}</span>
    <div class="footer-links">
      {/* Die Sprache kommt aus dem Pfad, nicht daraus, wie ein
          uebersetzter String gerade lautet. Vorher stand hier ein
          Vergleich auf d.nav.bereichRechtliches === "Legal" — eine
          Aenderung dieser Beschriftung haette die Navigation
          stillschweigend wieder deutsch benannt. */}
      <nav class="footer-nav" aria-label={d.nav.hauptnavigation}>
        {navLinks.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </nav>
      <ul class="footer-socials" aria-label={d.footer.socialsLabel}>
        {SITE.socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer me"
              aria-label={`${social.label}: ${social.handle} ${d.footer.neuerTab}`}
              class="footer-social-link"
            >
              {social.platform === 'instagram' && (
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              )}
              {social.platform === 'linkedin' && (
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" fill="currentColor" stroke="none" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-row footer-row-legal">
    <span class="footer-copy">{d.footer.copyright}</span>
    <nav class="footer-legal" aria-label={d.nav.bereichRechtliches}>
      {legalLinks.map((link, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a
            href={link.href}
            hreflang={locale === 'en' ? 'de' : undefined}
          >{link.label}</a>
        </>
      ))}
    </nav>
  </div>

  <!-- Datenschutz-Kurzhinweis. Bewusst eine dauerhafte Zeile statt eines
       wegklickbaren Balkens: ein Banner muesste sich das Schliessen
       merken und braeuchte dafuer Speicher auf dem Geraet — neben der
       Aussage "wir speichern nichts" ein unnoetiger Widerspruch.
       Der Wortlaut nannte mal eine Ausnahme fuer die Terminbuchung.
       Seit die weg ist, stimmt die kurze Fassung — und sie ist die
       staerkere Aussage. -->
  <p class="footer-privacy">
    {d.footer.datenschutzHinweis}
    {' '}
    <a
      href={pathOr('datenschutz')}
      hreflang={locale === 'en' ? 'de' : undefined}
    >{d.footer.datenschutzDetails}</a>
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 1200px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Default: standalone am Seitenende. Vollstaendiges Padding,
     eigener Background, zentriert im Viewport.
     position:relative + z-index:1 wird auf /preise gebraucht (Layer
     hinter dem Footer via SubPageBackground). Auf anderen Pages
     harmlos — kein stacking-Kontext-Konflikt. */
  .site-footer.is-default {
    background: #050507;
    padding: 32px 40px 24px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Embedded: Section-6 Kontext. Kein eigener Background (Section
     rendert BG-Layer), Padding nur oben (Border-Abstand), margin-top:
     auto zieht ihn ans untere Ende der flex-Spalte, flex-shrink:0
     verhindert Squish bei knappem Vertical Space, z-index:2 hebt ihn
     ueber die Section-6 Cosmic-Layer. */
  .site-footer.is-embedded,
  .site-footer.is-embedded-cream {
    background: transparent;
    padding-top: 24px;
    margin-top: auto;
    margin-left: auto;
    margin-right: auto;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  /* Cream-Variant: gleiche Layout-Semantik wie embedded, aber Charcoal-
     Text + amber-700 Hover statt Light-on-Dark. Border-Top wird dunkler
     damit sie auf Cream sichtbar bleibt. */
  .site-footer.is-embedded-cream {
    border-top-color: rgba(26, 26, 28, 0.15);
  }

  .site-footer.is-embedded-cream .footer-brand,
  .site-footer.is-embedded-cream .footer-nav a,
  .site-footer.is-embedded-cream .footer-legal a {
    color: rgba(26, 26, 28, 0.7);
  }

  .site-footer.is-embedded-cream .footer-copy {
    color: rgba(26, 26, 28, 0.5);
  }

  /* Cream-Variante am Fuss der Startseite */
  .site-footer.is-embedded-cream .footer-privacy {
    /* 4.75:1 gegen den Cream-Grund #ecdcbf */
    color: rgba(26, 26, 28, 0.65);
  }

  .site-footer.is-embedded-cream .footer-privacy a {
    color: rgba(26, 26, 28, 0.65);
    border-bottom-color: rgba(26, 26, 28, 0.25);
  }

  .site-footer.is-embedded-cream .footer-privacy a:hover {
    color: #92400e;
    border-bottom-color: #92400e;
  }

  /* Hellmodus auf den Unterseiten. Die Component ist gescoped, der
     Theme-Schalter sitzt auf <html> — daher :global. */
  :global(html[data-site-theme='light']) .footer-privacy {
    /* Nicht --theme-text-muted: dessen 0.55 ergaeben nur 3.79:1 auf
       #f8f4ea. 0.7 bringt 6.15:1. */
    color: rgba(26, 26, 28, 0.7);
  }

  :global(html[data-site-theme='light']) .footer-privacy a {
    color: var(--theme-text-dim);
    border-bottom-color: rgba(26, 26, 28, 0.25);
  }

  :global(html[data-site-theme='light']) .footer-privacy a:hover {
    color: #92400e;
    border-bottom-color: #92400e;
  }

  .site-footer.is-embedded-cream .footer-nav a:hover,
  .site-footer.is-embedded-cream .footer-nav a:focus-visible,
  .site-footer.is-embedded-cream .footer-legal a:hover,
  .site-footer.is-embedded-cream .footer-legal a:focus-visible {
    color: #92400e;
  }

  .site-footer.is-embedded-cream .footer-social-link {
    color: rgba(26, 26, 28, 0.7);
  }

  .site-footer.is-embedded-cream .footer-social-link:hover,
  .site-footer.is-embedded-cream .footer-social-link:focus-visible {
    color: #92400e;
    background: rgba(180, 83, 9, 0.08);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.78rem;
  }

  .footer-brand {
    color: rgba(245, 245, 244, 0.7);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer-copy {
    color: rgba(245, 245, 244, 0.5);
  }

  .footer-privacy {
    margin: 4px 0 0;
    max-width: 78ch;
    font-size: 0.7rem;
    line-height: 1.55;
    /* 0.55 statt 0.38: ein Pflichthinweis muss lesbar sein. Gerechnet
       ergibt 0.38 nur 3.24:1 gegen #050507, 0.55 bringt 5.82:1 und
       liegt damit ueber den geforderten 4.5:1. */
    color: rgba(245, 245, 244, 0.55);
  }

  .footer-privacy a {
    color: rgba(245, 245, 244, 0.55);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 245, 244, 0.2);
    transition: color 200ms ease, border-color 200ms ease;
  }

  .footer-privacy a:hover {
    color: rgba(245, 158, 11, 0.95);
    border-bottom-color: rgba(245, 158, 11, 0.6);
  }

  .footer-nav,
  .footer-legal {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-nav a,
  .footer-legal a {
    color: rgba(245, 245, 244, 0.7);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: rgba(245, 158, 11, 0.95);
    outline: none;
  }

  /* Links-Gruppe: Nav + Socials im Top-Row rechts vom Brand.
     18px Gap zwischen Nav und Socials (mehr als 12px innerhalb Nav) —
     kleiner visueller Trennstrich ohne echten Divider. */
  .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: rgba(245, 245, 244, 0.7);
    text-decoration: none;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    color: rgba(245, 158, 11, 0.95);
    background: rgba(245, 158, 11, 0.08);
    transform: translateY(-1px);
    outline: none;
  }

  .footer-social-link:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.8);
    outline-offset: 2px;
  }

  .footer-row-legal {
    color: rgba(245, 245, 244, 0.4);
    font-size: 0.72rem;
  }

  @media (max-width: 768px) {
    .site-footer.is-embedded {
      padding-top: 16px;
    }
    .footer-row {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 4px 12px;
      font-size: 0.65rem;
    }
    .footer-row-legal {
      font-size: 0.6rem;
      opacity: 0.7;
    }
    /* Mobile: Nav + Socials in einer Zeile zentriert, kleiner Gap. */
    .footer-links {
      gap: 12px;
      justify-content: center;
    }
    .footer-social-link {
      width: 26px;
      height: 26px;
    }
  }
</style>
