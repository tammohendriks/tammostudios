---
// Shared Site-Footer für alle Pages + Landing-Closing-Section.
// Liest Nav-/Legal-Links und Copyright aus SECTION5.footer, damit
// die Datenquelle single-source bleibt.
//
// variant='default'        — standalone Footer am Seitenende (Sub-Pages).
//                            Background + Full-Padding + max-width Container.
// variant='embedded'       — Footer innerhalb einer flex-column Section
//                            (dark Landing-Sections). Kein Background, nur
//                            Border-Top + margin-top:auto.
// variant='embedded-cream' — Wie embedded, aber Charcoal-Text auf Cream —
//                            fuer die Cream-Landing-Section (Fahrplan/Closing).
export interface Props {
  variant?: 'default' | 'embedded' | 'embedded-cream';
}

const { variant = 'default' } = Astro.props;

import { SECTION5 } from '../lib/constants';

const { footer } = SECTION5;
---

<footer class:list={['site-footer', `is-${variant}`]}>
  <div class="footer-row">
    <span class="footer-brand">{footer.brand}</span>
    <div class="footer-links">
      <nav class="footer-nav" aria-label="Hauptnavigation">
        {footer.navLinks.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </nav>
      <ul class="footer-socials" aria-label="Social Media">
        {footer.socials.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer me"
              aria-label={`${social.label}: ${social.handle} (oeffnet in neuem Tab)`}
              class="footer-social-link"
            >
              {social.platform === 'instagram' && (
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              )}
              {social.platform === 'linkedin' && (
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" fill="currentColor" stroke="none" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-row footer-row-legal">
    <span class="footer-copy">{footer.copyright}</span>
    <nav class="footer-legal" aria-label="Rechtliches">
      {footer.legalLinks.map((link, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a href={link.href}>{link.label}</a>
        </>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 1200px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Default: standalone am Seitenende. Vollstaendiges Padding,
     eigener Background, zentriert im Viewport.
     position:relative + z-index:1 wird auf /preise gebraucht (Layer
     hinter dem Footer via SubPageBackground). Auf anderen Pages
     harmlos — kein stacking-Kontext-Konflikt. */
  .site-footer.is-default {
    background: #050507;
    padding: 32px 40px 24px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Embedded: Section-6 Kontext. Kein eigener Background (Section
     rendert BG-Layer), Padding nur oben (Border-Abstand), margin-top:
     auto zieht ihn ans untere Ende der flex-Spalte, flex-shrink:0
     verhindert Squish bei knappem Vertical Space, z-index:2 hebt ihn
     ueber die Section-6 Cosmic-Layer. */
  .site-footer.is-embedded,
  .site-footer.is-embedded-cream {
    background: transparent;
    padding-top: 24px;
    margin-top: auto;
    margin-left: auto;
    margin-right: auto;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  /* Cream-Variant: gleiche Layout-Semantik wie embedded, aber Charcoal-
     Text + amber-700 Hover statt Light-on-Dark. Border-Top wird dunkler
     damit sie auf Cream sichtbar bleibt. */
  .site-footer.is-embedded-cream {
    border-top-color: rgba(26, 26, 28, 0.15);
  }

  .site-footer.is-embedded-cream .footer-brand,
  .site-footer.is-embedded-cream .footer-nav a,
  .site-footer.is-embedded-cream .footer-legal a {
    color: rgba(26, 26, 28, 0.7);
  }

  .site-footer.is-embedded-cream .footer-copy {
    color: rgba(26, 26, 28, 0.5);
  }

  .site-footer.is-embedded-cream .footer-nav a:hover,
  .site-footer.is-embedded-cream .footer-nav a:focus-visible,
  .site-footer.is-embedded-cream .footer-legal a:hover,
  .site-footer.is-embedded-cream .footer-legal a:focus-visible {
    color: #92400e;
  }

  .site-footer.is-embedded-cream .footer-social-link {
    color: rgba(26, 26, 28, 0.7);
  }

  .site-footer.is-embedded-cream .footer-social-link:hover,
  .site-footer.is-embedded-cream .footer-social-link:focus-visible {
    color: #92400e;
    background: rgba(180, 83, 9, 0.08);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.78rem;
  }

  .footer-brand {
    color: rgba(245, 245, 244, 0.7);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer-copy {
    color: rgba(245, 245, 244, 0.5);
  }

  .footer-nav,
  .footer-legal {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-nav a,
  .footer-legal a {
    color: rgba(245, 245, 244, 0.7);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: rgba(245, 158, 11, 0.95);
    outline: none;
  }

  /* Links-Gruppe: Nav + Socials im Top-Row rechts vom Brand.
     18px Gap zwischen Nav und Socials (mehr als 12px innerhalb Nav) —
     kleiner visueller Trennstrich ohne echten Divider. */
  .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: rgba(245, 245, 244, 0.7);
    text-decoration: none;
    transition:
      color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    color: rgba(245, 158, 11, 0.95);
    background: rgba(245, 158, 11, 0.08);
    transform: translateY(-1px);
    outline: none;
  }

  .footer-social-link:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.8);
    outline-offset: 2px;
  }

  .footer-row-legal {
    color: rgba(245, 245, 244, 0.4);
    font-size: 0.72rem;
  }

  @media (max-width: 768px) {
    .site-footer.is-embedded {
      padding-top: 16px;
    }
    .footer-row {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 4px 12px;
      font-size: 0.65rem;
    }
    .footer-row-legal {
      font-size: 0.6rem;
      opacity: 0.7;
    }
    /* Mobile: Nav + Socials in einer Zeile zentriert, kleiner Gap. */
    .footer-links {
      gap: 12px;
      justify-content: center;
    }
    .footer-social-link {
      width: 26px;
      height: 26px;
    }
  }
</style>
