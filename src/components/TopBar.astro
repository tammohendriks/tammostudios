---
import { SITE_LABELS, NAV_ITEMS, CTA } from '../lib/constants';

// "Startseite" wird IMMER ins DOM gerendert. Sichtbarkeit kommt
// per CSS aus dem html[data-page]- bzw. header[data-page]-State,
// beide werden bei jedem Page-Reload server-seitig korrekt gesetzt.
// Ohne View Transitions: kein Sync nötig, jede Navigation ist ein
// Full-Page-Reload und liefert das richtige data-page direkt vom
// Server.
const currentPath = Astro.url.pathname;
const isLanding = currentPath === '/' || currentPath === '/index.html';
const pageType = isLanding ? 'landing' : 'subpage';

type NavChild = { label: string; href: string };
type NavItem = {
  label: string;
  href: string;
  key?: string;
  children?: readonly NavChild[];
};
const navItems: NavItem[] = [
  { label: 'Startseite', href: '/', key: 'startseite' },
  ...NAV_ITEMS,
];

function isActive(href: string) {
  if (href === '/') return isLanding;
  // Sub-Pages: aktiv wenn currentPath mit href beginnt — fängt
  // auch potenzielle Sub-Routes wie /referenzen/foo später ab.
  return currentPath === href || currentPath.startsWith(href + '/');
}

// Ein Nav-Item ist "aktiv" wenn seine eigene href matcht ODER
// eines seiner Kinder — sonst wuerde das Preise-Dropdown auf
// /preisrechner keinen aktiven State zeigen.
function itemIsActive(item: NavItem): boolean {
  if (isActive(item.href)) return true;
  if (item.children) return item.children.some((c) => isActive(c.href));
  return false;
}
---

<header class="topbar" data-topbar data-page={pageType}>
  <span class="top-left label-tracked">{SITE_LABELS.establishedLine}</span>

  <nav class="nav" aria-label="Hauptnavigation">
    {navItems.map((item, i) => {
      const hasChildren = !!(item.children && item.children.length > 0);
      return (
        <span class:list={['nav-item', item.key && `nav-item-${item.key}`, hasChildren && 'has-dropdown']}>
          <a
            class="nav-link"
            href={item.href}
            aria-current={itemIsActive(item) ? 'page' : undefined}
            aria-haspopup={hasChildren ? 'menu' : undefined}
          >
            {item.label}
            {hasChildren && (
              <svg
                class="nav-chevron"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            )}
          </a>
          {hasChildren && item.children && (
            <div class="nav-dropdown" role="menu">
              {item.children.map((child) => (
                <a
                  class="nav-dropdown-item"
                  role="menuitem"
                  href={child.href}
                  aria-current={isActive(child.href) ? 'page' : undefined}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
          {i < navItems.length - 1 && (
            <span class="dot" aria-hidden="true"> · </span>
          )}
        </span>
      );
    })}
  </nav>

  <button
    id="nav-toggle"
    class="hamburger"
    type="button"
    aria-label="Menü öffnen"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span></span>
    <span></span>
  </button>

  <a class="cta-orbital topbar-cta" href="/kontakt" aria-current={isActive('/kontakt') ? 'page' : undefined}>
    <span class="cta-label">{CTA.label}</span>
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </a>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <ul>
    {navItems.map((item) => {
      const hasChildren = !!(item.children && item.children.length > 0);
      const subId = `mobile-sub-${item.href.replace(/\//g, '-') || 'root'}`;
      return (
        <li class:list={[item.key && `mobile-item-${item.key}`, hasChildren && 'mobile-item-has-children']}>
          {hasChildren ? (
            <>
              <div class="mobile-item-row">
                <a
                  class="mobile-link"
                  href={item.href}
                  aria-current={itemIsActive(item) ? 'page' : undefined}
                >
                  {item.label}
                </a>
                <button
                  class="mobile-expand"
                  type="button"
                  aria-expanded="false"
                  aria-controls={subId}
                  aria-label={`${item.label} Untermenü ein-/ausklappen`}
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
              </div>
              <ul id={subId} class="mobile-sub" hidden>
                {item.children!.map((child) => (
                  <li>
                    <a
                      class="mobile-sub-link"
                      href={child.href}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a
              class="mobile-link"
              href={item.href}
              aria-current={itemIsActive(item) ? 'page' : undefined}
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
    <li class="mobile-cta-wrap">
      <a class="cta-orbital" href="/kontakt" aria-current={isActive('/kontakt') ? 'page' : undefined}>
        <span class="cta-label">{CTA.label}</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </li>
  </ul>
</div>

<style>
  /* TopBar-Wrapper: 3-Spalten-Grid 1fr/auto/1fr. Die mittlere
     auto-Spalte hat die Breite ihres Inhalts (Nav-Pille bzw. auf
     Mobile der Hamburger); links und rechts sind je 1fr — exakt
     gleich breit, sodass die Mitte garantiert in der Viewport-
     Mitte liegt, egal wie unterschiedlich Eyebrow und CTA in der
     Breite sind. Ohne Grid (flex space-between) hingen die Pillen
     asymmetrisch. */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 20px 32px;
    gap: 16px;
    pointer-events: none;
    overflow: visible;
  }

  .topbar > * {
    pointer-events: auto;
  }

  .label-tracked {
    grid-column: 1;
    justify-self: start;
  }

  .nav,
  .hamburger {
    grid-column: 2;
    justify-self: center;
  }

  .topbar-cta {
    grid-column: 3;
    justify-self: end;
  }

  /* Splash-Coupling: TopBar-Items sind während Splash + Reveal
     unsichtbar und faden bei "ready" mit den Section-1-Heroes ein.
     Returning visitors mit .splash-skip sehen alles sofort.
     Default-Hidden ist KRITISCH gegen Mobile-FOUC: ohne diese Regel
     blitzt die TopBar im ersten Frame auf, bevor das Splash-Script
     greift. */
  .label-tracked,
  .nav,
  .cta-orbital,
  .hamburger {
    opacity: 0;
    pointer-events: none;
    transition: opacity 600ms ease-out;
  }

  :global(html[data-splash="ready"]) .label-tracked,
  :global(html[data-splash="ready"]) .nav,
  :global(html[data-splash="ready"]) .cta-orbital,
  :global(html[data-splash="ready"]) .hamburger,
  :global(html.splash-skip) .label-tracked,
  :global(html.splash-skip) .nav,
  :global(html.splash-skip) .cta-orbital,
  :global(html.splash-skip) .hamburger {
    opacity: 1;
    pointer-events: auto;
  }

  :global(html[data-splash="ready"]) .label-tracked { transition-delay: 0ms;   }
  :global(html[data-splash="ready"]) .nav           { transition-delay: 80ms;  }
  :global(html[data-splash="ready"]) .cta-orbital   { transition-delay: 160ms; }
  :global(html[data-splash="ready"]) .hamburger     { transition-delay: 80ms;  }


  /* Glass-Pill: subtiler dunkler Backdrop mit blur, dünne Border,
     leichter Shadow + inset-Highlight. Wiederverwendet für eyebrow,
     nav und (auf Mobile) hamburger. */
  .label-tracked,
  .nav {
    background: rgba(5, 5, 7, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .label-tracked {
    padding: 10px 18px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 500;
    font-size: 0.7rem;
    color: rgba(245, 245, 244, 0.7);
  }

  .nav {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    gap: 0 4px;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
  }

  .nav-link {
    color: rgba(245, 245, 244, 0.8);
    font-size: 14px;
    font-weight: 500;
    transition: color 200ms ease;
    padding: 4px 2px;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: rgba(245, 245, 244, 1);
  }

  /* Aktive Page: amber + bold, damit User auf einen Blick sieht
     wo er ist. "Startseite" auf Sub-Pages ist KEIN Sonderfall mehr —
     gleicher Stil wie alle anderen Nav-Items, hover ins helle Weiß. */
  .nav-link[aria-current="page"] {
    color: rgba(245, 158, 11, 1);
    font-weight: 600;
  }

  .mobile-link[aria-current="page"] {
    color: rgba(245, 158, 11, 1);
  }

  /* === Desktop Dropdown === */
  .nav-item.has-dropdown {
    position: relative;
  }

  .nav-item.has-dropdown .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .nav-chevron {
    color: rgba(245, 245, 244, 0.5);
    transition: transform 220ms ease, color 220ms ease;
  }

  .nav-item.has-dropdown:hover .nav-chevron,
  .nav-item.has-dropdown:focus-within .nav-chevron,
  .nav-item.has-dropdown .nav-link:hover .nav-chevron {
    color: rgba(245, 245, 244, 0.9);
    transform: rotate(180deg);
  }

  /* Dropdown-Panel — sitzt unter dem parent Nav-Item, matcht die
     Glass-Pill-Aesthetik der TopBar (dark subtle border). Kein
     backdrop-filter: Panel ist mit 0.98 opacity fast opak, Blur
     ist visuell nicht wahrnehmbar aber allokiert einen Filter-
     Backing-Store auch bei visibility:hidden. */
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    min-width: 200px;
    margin-top: 12px;
    padding: 8px;
    background: rgba(10, 10, 12, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-6px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
    z-index: 60;
    pointer-events: none;
  }

  .nav-item.has-dropdown:hover .nav-dropdown,
  .nav-item.has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    transition-delay: 0s;
    pointer-events: auto;
  }

  /* Hover-Bruecke: 12px unsichtbarer Streifen zwischen Trigger und
     Dropdown damit der User nicht rausgeht wenn er sich runterbewegt. */
  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .nav-dropdown-item {
    display: block;
    padding: 10px 14px;
    color: rgba(245, 245, 244, 0.8);
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    transition: background-color 180ms ease, color 180ms ease;
    white-space: nowrap;
  }

  .nav-dropdown-item:hover,
  .nav-dropdown-item:focus-visible {
    background: rgba(245, 158, 11, 0.1);
    color: #f5f5f4;
    outline: none;
  }

  .nav-dropdown-item[aria-current="page"] {
    color: rgba(245, 158, 11, 0.95);
    background: rgba(245, 158, 11, 0.06);
  }

  /* "Startseite" hängt im DOM auf jeder Page, Sichtbarkeit kommt
     aus dem globalen html[data-page]-State. display:none auf Landing
     reserviert KEINEN Layout-Space. Auf Sub-Pages wird inline-flex
     gesetzt; die Fade-Animation läuft NUR, wenn das Inline-Script in
     BaseLayout data-startseite-anim="1" auf <html> setzt — das passiert
     genau einmal pro Session beim ersten Wechsel von Landing → Sub-
     Page. Ohne Flag ist Startseite einfach da, kein erneutes Triggern. */
  .nav-item-startseite {
    display: none;
  }

  :global(html[data-page="subpage"]) .nav-item-startseite {
    display: inline-flex;
    align-items: center;
  }

  :global(html[data-startseite-anim="1"][data-page="subpage"]) .nav-item-startseite {
    animation: startseite-fade-in 400ms ease-out;
  }

  @keyframes startseite-fade-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Mobile-Menü: Stack-Layout, gleiches Schema (ohne Animation,
     reicht für die kleine Liste). */
  .mobile-item-startseite {
    display: none;
  }

  :global(html[data-page="subpage"]) .mobile-item-startseite {
    display: list-item;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-startseite-anim="1"][data-page="subpage"]) .nav-item-startseite {
      animation: none;
    }
  }

  .dot {
    color: rgba(245, 245, 244, 0.3);
    padding: 0 6px;
  }

  /* TopBar-spezifische Verkleinerung des globalen .cta-orbital.
     Compact-Padding & 14px-Type, weil der TopBar-CTA neben Nav-
     Links lebt — Closing-CTA in Section 5 darf größer sein. */
  .topbar-cta {
    padding: 11px 26px;
    font-size: 14px;
    gap: 8px;
  }

  /* Hamburger */
  .hamburger {
    width: 44px;
    height: 44px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    background: transparent;
    border: 0;
    padding: 0;
    /* iOS-Tap-Reliability: 44px ist Apple HIG-Minimum, damit Finger
       das Element zuverlässig trifft. touch-action:manipulation
       unterdrückt den 300ms-Doppel-Tap-Delay, der unter iOS Safari
       Klicks "verschluckt". Pointer-events explizit auf auto, damit
       kein Parent-Override den Hit-Bereich versehentlich abklemmt. */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-ts-fg);
    transition: transform 220ms ease, opacity 220ms ease;
    transform-origin: center;
  }

  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
  }

  .hamburger[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile breakpoint: kompaktere Pills, Nav versteckt zugunsten
     Hamburger der seinerseits als Pill rendert. Kein backdrop-filter
     auf mobile — fixed TopBar mit Blur ist der iOS Safari GPU-Killer
     #1 (Re-Blur auf jedem Scroll-Frame). Opakerer Background (0.88
     statt 0.55) kompensiert visuell. */
  @media (max-width: 767px) {
    .topbar {
      padding: 16px;
    }
    .nav {
      display: none;
    }
    .label-tracked {
      padding: 8px 14px;
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      background: rgba(5, 5, 7, 0.88);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .hamburger {
      display: inline-flex;
      width: 44px;
      height: 44px;
      padding: 0;
      background: rgba(5, 5, 7, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 9999px;
      box-shadow:
        0 4px 24px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
  }

  /* Mobile menu overlay — kein backdrop-filter: Full-Screen-Blur
     (100vw × 100vh) auf iOS Safari freezed den Menu-Open-Anim um
     100-200ms. Opakerer Background (0.98) kompensiert visuell. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 10, 12, 0.98);
    animation: menu-enter 220ms ease-out;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  /* Direkt-Child-Selektor damit nested .mobile-sub NICHT auch dieses
     28px-gap-Layout erbt (Specificity von .mobile-menu ul war hoeher
     als .mobile-sub und ueberschrieb die Sub-Styles). */
  .mobile-menu > ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .mobile-link {
    color: var(--color-ts-fg);
    font-size: 22px;
    font-weight: 500;
  }

  /* === Mobile Accordion (Nav-Items mit Kindern) === */
  .mobile-item-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .mobile-item-row .mobile-link {
    padding-right: 0;
  }

  .mobile-expand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: rgba(245, 245, 244, 0.7);
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
  }

  .mobile-expand:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.7);
    outline-offset: 2px;
  }

  .mobile-expand svg {
    transition: transform 220ms ease;
  }

  .mobile-expand[aria-expanded="true"] {
    color: rgba(245, 158, 11, 0.95);
    border-color: rgba(245, 158, 11, 0.5);
    background: rgba(245, 158, 11, 0.08);
  }

  .mobile-expand[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .mobile-sub {
    list-style: none;
    padding: 8px 0 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mobile-sub[hidden] {
    display: none;
  }

  .mobile-sub-link {
    display: block;
    padding: 10px 14px;
    color: rgba(245, 245, 244, 0.65);
    font-size: 15px;
    font-weight: 400;
    text-align: center;
    text-decoration: none;
    border-radius: 8px;
    transition: color 200ms ease, background-color 200ms ease;
  }

  .mobile-sub-link:hover,
  .mobile-sub-link:focus-visible {
    color: rgba(245, 158, 11, 0.95);
    background: rgba(245, 158, 11, 0.06);
    outline: none;
  }

  .mobile-sub-link[aria-current="page"] {
    color: rgba(245, 158, 11, 1);
    font-weight: 500;
  }

  .mobile-cta-wrap {
    margin-top: 12px;
  }

  @keyframes menu-enter {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      animation: none;
    }
    .hamburger span {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const isOpen = () => !menu.hasAttribute('hidden');
    const open = () => {
      menu.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      if (isOpen()) close();
      else open();
    });

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', close);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) close();
    });
  }

  // === Mobile Accordion Toggle ===
  // Chevron-Button neben Nav-Items mit Kindern toggelt aria-expanded
  // + hidden auf der Sub-Liste. Klick auf den Parent-Link daneben
  // navigiert normal (kein preventDefault noetig).
  document.querySelectorAll<HTMLButtonElement>('.mobile-expand').forEach((btn) => {
    btn.addEventListener('click', () => {
      const controls = btn.getAttribute('aria-controls');
      if (!controls) return;
      const sub = document.getElementById(controls);
      if (!sub) return;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (expanded) sub.setAttribute('hidden', '');
      else sub.removeAttribute('hidden');
    });
  });

  // === Desktop Dropdown: Escape schliesst offenes Dropdown ===
  // CSS handled hover/focus-within, Escape blurred das aktive Element
  // (typischerweise ein Dropdown-Item) → :focus-within loest → Panel
  // schliesst. Zusaetzlich Focus zurueck auf den Parent-Link.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const active = document.activeElement as HTMLElement | null;
    if (!active) return;
    const dropdownItem = active.closest('.nav-dropdown-item');
    if (!dropdownItem) return;
    const parentNavItem = active.closest('.nav-item.has-dropdown');
    const parentLink = parentNavItem?.querySelector<HTMLElement>('.nav-link');
    active.blur();
    parentLink?.focus();
  });
</script>
