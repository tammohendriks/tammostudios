---
/**
 * /website — Uebersichts-Landingpage fuer "Website" als Angebots-
 * Bereich. Ersetzt die aufgegebene /studio Marketing-Seite (deren
 * CMS-USP-Content in Section "Du pflegst selbst" gemergt wurde) und
 * ist Ziel-URL fuer den Nav-Dropdown "Angebot → Website".
 *
 * Struktur:
 *   1. Hero (subpage-Konvention: centered, 780px, padding-top 32px)
 *   2. Problem-Framing — 3 Cards (Gefunden werden / Anfragen statt
 *      Anrufe / Selbst aktuell halten). Ersetzt die frueheren
 *      Branchen-Cards; /webdesign-* bleiben als SEO-Landings bestehen,
 *      sind hier aber nicht mehr die Sortierlogik.
 *   3. Du pflegst selbst (id="cms") — CMS-Autonomie USP (aus /studio migriert)
 *   4. Was du bekommst — Feature-Liste
 *   5. Was kostet's — kompakter Preis-Verweis auf /preise
 *   6. Aus der Praxis — 3 Referenz-Cards, Link zu /referenzen
 *   7. Final-CTA — Erstgespraech
 *
 * /studio Route wird via vercel.json rewrite → /website#cms redirected.
 *
 * Liegt als Komponente und nicht in src/pages, weil es zwei Routen
 * darauf gibt: /website und /en/website. Markup und <style>-Block
 * gehoeren dabei zusammen.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from './SubPageBackground.astro';
import SiteFooter from './SiteFooter.astro';
import ClosingCta from './ClosingCta.astro';
import { REFERENCES } from '../lib/references';
import { subtitleFor } from '../lib/references.en';
import { localeOf, path, pathOr } from '../lib/routes.mjs';
import { WEBSITE } from '../lib/i18n/seiten/website';

const locale = localeOf(Astro.url.pathname);
const d = WEBSITE[locale];

// Ziele der drei Problem-Karten. Der Anker #cms zeigt auf diese Seite
// selbst und gilt in jeder Sprache; /software gibt es nicht
// zwangslaeufig — fehlt es, faellt der Verweis weg.
const softwarePfad = path('software', locale);
const referenzenPfad = path('referenzen', locale);
const preisePfad = path('preise', locale);
const problemZiele = [null, softwarePfad, '#cms'];

// Website-Referenzen fuer die "Aus der Praxis" Section — nur die 3
// visuell staerksten Cases. Keine Duplikate mit Software-Page.
const websiteRefs = REFERENCES.filter((r) =>
  ['samedos', 'er-und-sie', 'kirsch-dach-fassade'].includes(r.slug)
);
---

<BaseLayout
  pageTitle={d.meta.pageTitle}
  title={d.meta.title}
  description={d.meta.description}
>
  <main class="website-page">
    <SubPageBackground />

    <header class="website-hero">
      <h1 class="subpage-hero-title">{d.hero.headline}</h1>
      <p class="subpage-hero-subtitle text-lines">{d.hero.sub}</p>
      <div class="website-hero-cta">
        <a class="cta-link" href={pathOr('kontakt', locale)}>
          {d.hero.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
      </div>
    </header>

    <!-- ================================================================
         2. Problem-Framing — wofuer eine Website da ist
         ============================================================== -->
    <section class="website-problems" data-reveal aria-labelledby="problems-heading">
      <p class="website-eyebrow">{d.probleme.eyebrow}</p>
      <h2 id="problems-heading" class="website-section-title">{d.probleme.headline}</h2>
      <div class="problems-grid">
        {d.probleme.karten.map((p, i) => (
          <article class="problem-card" data-reveal>
            <h3 class="problem-card-label">{p.label}</h3>
            <p class="problem-card-body">{p.body}</p>
            {problemZiele[i] && (
              <a class="cta-link problem-card-cta" href={problemZiele[i]}>
                {p.linkLabel}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
              </a>
            )}
          </article>
        ))}
      </div>
      <p class="problems-note">{d.probleme.notiz}</p>
      {referenzenPfad && (
      <a class="cta-link problems-note-cta" href={referenzenPfad}>
        {d.probleme.notizCta}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      )}
    </section>

    <!-- ================================================================
         3. Du pflegst selbst — CMS-Autonomie (id="cms" fuer /studio Redirect)
         ============================================================== -->
    <section id="cms" class="website-cms" data-reveal aria-labelledby="cms-heading">
      <p class="website-eyebrow">{d.cms.eyebrow}</p>
      <h2 id="cms-heading" class="website-section-title">{d.cms.headline}</h2>
      <div class="cms-body">
        <p>{d.cms.absatz1}</p>
        <p>{d.cms.absatz2}</p>
        <ul class="cms-list">
          {d.cms.punkte.map((punkt) => <li>{punkt}</li>)}
        </ul>
        <p class="cms-examples">
          <strong>{d.cms.beispieleLabel}</strong>{d.cms.beispiele}
        </p>
      </div>
    </section>

    <!-- ================================================================
         4. Was du bekommst — Feature-Liste
         ============================================================== -->
    <section class="website-features" data-reveal aria-labelledby="features-heading">
      <p class="website-eyebrow">{d.features.eyebrow}</p>
      <h2 id="features-heading" class="website-section-title">{d.features.headline}</h2>
      <div class="features-grid">
        {d.features.punkte.map((f) => (
          <div class="feature-item" data-reveal>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================
         5. Was kostet's — Preis-Verweis
         ============================================================== -->
    <section class="website-preise" data-reveal aria-labelledby="preise-heading">
      <p class="website-eyebrow">{d.preise.eyebrow}</p>
      <h2 id="preise-heading" class="website-section-title">{d.preise.headline}</h2>
      <div class="preise-cards">
        <div class="preise-item">
          <p class="preise-amount">{d.preise.websitePreis}</p>
          <p class="preise-label">{d.preise.websiteLabel}</p>
        </div>
        <div class="preise-item">
          <p class="preise-amount">{d.preise.shopPreis}</p>
          <p class="preise-label">{d.preise.shopLabel}</p>
        </div>
      </div>
      <p class="preise-inklusive">{d.preise.inklusive}</p>
      {preisePfad && (
      <a class="cta-link" href={preisePfad}>
        {d.preise.cta}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
      </a>
      )}
    </section>

    <!-- ================================================================
         6. Aus der Praxis — 3 Referenz-Cards
         ============================================================== -->
    <section class="website-refs" data-reveal aria-labelledby="refs-heading">
      <p class="website-eyebrow">{d.referenzen.eyebrow}</p>
      <h2 id="refs-heading" class="website-section-title">{d.referenzen.headline}</h2>
      <div class="refs-grid">
        {websiteRefs.map((r) => (
          <a class="ref-preview" href={r.url} target="_blank" rel="noopener noreferrer">
            <div class="ref-preview-image">
              <img src={r.preview} alt={`${d.referenzen.vorschau} ${r.title}`} loading="lazy" />
            </div>
            <div class="ref-preview-body">
              <h3 class="ref-preview-title">{r.title}</h3>
              <p class="ref-preview-sub">{subtitleFor(r, locale)}</p>
            </div>
          </a>
        ))}
      </div>
      {referenzenPfad && (
      <a class="cta-link refs-note" href={referenzenPfad}>
        {d.referenzen.cta}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      )}
    </section>

    <ClosingCta
      recommendation={
        softwarePfad
          ? { text: d.empfehlung.text, label: d.empfehlung.label, href: softwarePfad }
          : undefined
      }
    />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .website-page {
    position: relative;
    background: #050507;
    padding: 140px 40px 80px;
    min-height: calc(100vh - 200px);
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .website-page {
      padding: 100px 20px 60px;
    }
  }

  .website-page > section,
  .website-hero {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  /* === Hero (subpage convention) === */
  .website-hero {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 96px;
    padding-top: 32px;
  }
  .website-hero-cta {
    margin-top: 28px;
  }

  /* === Shared section styling === */
  .website-eyebrow {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    color: rgba(245, 158, 11, 0.85);
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .website-section-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #f5f5f4;
    margin: 0 0 32px;
  }
  .website-page > section {
    margin-bottom: 96px;
  }
  @media (max-width: 768px) {
    .website-page > section {
      margin-bottom: 72px;
    }
  }

  /* === Problem-Framing === */
  .website-problems {
    text-align: center;
  }
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  @media (max-width: 768px) {
    .problems-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Karten sind hier bewusst KEINE Links mehr (vorher Vertical-Cards,
     ganzflaechig klickbar). Deshalb kein Hover-Lift auf der Karte —
     nur der optionale CTA darin reagiert. */
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 22px;
    background: rgba(15, 15, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-align: left;
  }
  .problem-card-label {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.35rem;
    color: #f5f5f4;
    margin: 0;
  }
  .problem-card-body {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.72);
    margin: 0;
    flex: 1;
  }
  /* Aussehen aus .cta-link, hier nur die Position in der Karte. */
  .problem-card-cta {
    align-self: flex-start;
    margin-top: 6px;
  }
  .problems-note {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(245, 245, 244, 0.6);
    margin: 0 0 14px;
  }

  /* Aussehen aus .cta-link (global.css), hier nur die Position. */
  .problems-note-cta,
  .refs-note {
    margin-top: 4px;
  }

  /* === CMS Section (id="cms" — scroll target from /studio redirect) === */
  .website-cms {
    scroll-margin-top: 100px;
    text-align: center;
  }
  .cms-body {
    max-width: 640px;
    margin: 0 auto;
    text-align: left;
  }
  .cms-body p {
    font-family: 'Inter', sans-serif;
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(245, 245, 244, 0.82);
    margin: 0 0 20px;
  }
  .cms-list {
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }
  .cms-list li {
    position: relative;
    padding-left: 24px;
    font-family: 'Inter', sans-serif;
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.85);
    margin-bottom: 12px;
  }
  .cms-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: rgba(245, 158, 11, 0.85);
    font-weight: 600;
  }
  .cms-examples {
    padding: 20px;
    background: rgba(245, 158, 11, 0.06);
    border-left: 3px solid rgba(245, 158, 11, 0.5);
    border-radius: 6px;
    font-size: 0.95rem !important;
    color: rgba(245, 245, 244, 0.75) !important;
  }
  .cms-examples strong {
    color: rgba(245, 158, 11, 0.95);
  }

  /* === Features === */
  .website-features {
    text-align: center;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    text-align: left;
  }
  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
  .feature-item {
    padding: 24px;
    background: rgba(15, 15, 18, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
  }
  .feature-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #f5f5f4;
    margin: 0 0 8px;
  }
  .feature-body {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.7);
    margin: 0;
  }

  /* === Preise === */
  .website-preise {
    text-align: center;
  }
  .preise-inklusive {
    max-width: 56ch;
    margin: 0 auto 32px;
    font-family: 'Inter', sans-serif;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(245, 245, 244, 0.68);
  }
  .preise-cards {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .preise-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .preise-amount {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: rgba(245, 158, 11, 0.95);
    margin: 0;
  }
  .preise-label {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 245, 244, 0.65);
    margin: 0;
  }

  /* === Refs === */
  .website-refs {
    text-align: center;
  }
  .refs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  @media (max-width: 768px) {
    .refs-grid {
      grid-template-columns: 1fr;
    }
  }
  .ref-preview {
    display: flex;
    flex-direction: column;
    background: rgba(15, 15, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 240ms ease,
      transform 240ms ease;
  }
  .ref-preview:hover {
    border-color: rgba(245, 158, 11, 0.4);
    transform: translateY(-3px);
  }
  /* 2/1 statt 4/3: die Screenshots sind rund 2:1, in einem
     4/3-Rahmen schnitt object-fit:cover ueber 34 % der Breite ab —
     links und rechts, also genau da wo Logo und Navigation sitzen.
     Bei 2/1 bleibt unter 1,5 % weg. Gleicher Wert wie auf
     /referenzen, dadurch sehen die Karten auf beiden Seiten gleich
     aus. object-position haelt den Kopfbereich im Bild, falls ein
     Screenshot doch einmal hoeher ausfaellt. */
  .ref-preview-image {
    aspect-ratio: 2 / 1;
    background: rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .ref-preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .ref-preview-body {
    padding: 16px 18px;
    text-align: left;
  }
  .ref-preview-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: #f5f5f4;
    margin: 0 0 4px;
  }
  .ref-preview-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(245, 245, 244, 0.6);
    margin: 0;
  }

  /* === Final CTA === */

  /* === Inline CTA link === */
</style>
