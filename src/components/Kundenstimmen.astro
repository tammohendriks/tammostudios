---
/**
 * Drei echte Kundenstimmen: eine groß, zwei klein.
 *
 * Steht auf den Branchen-Landingpages zwischen FAQ und Abschluss: nach
 * allen Argumenten, vor der Aufforderung. Wer bis hierhin gelesen hat,
 * weiß was es kostet und wie es abläuft — was fehlt, ist jemand
 * anderes, der es schon gemacht hat.
 *
 * WARUM NICHT DREI GLEICHE KARTEN: drei gleich große Karten sind drei
 * gleich wichtige Stimmen, und das Auge liest dann keine. Die erste
 * Stimme ist die, die zur Branche der Seite passt (die Reihenfolge
 * steht in testimonials.ts) — die bekommt Platz, die anderen beiden
 * stützen sie.
 *
 * In jeder Stimme ist eine Stelle hervorgehoben. Sie steht wörtlich im
 * Zitat; zerlegen() wirft beim Bauen, wenn nicht. Eine Hervorhebung,
 * die im Original nicht vorkommt, wäre ein erfundenes Zitat im Zitat.
 *
 * Die Breite steht hier und nicht in der Elternseite: deren Regel
 * `.vertical-page > *:not(:first-child)` ist auf die Komponenten-
 * Kennung der Elternseite gebunden und greift bei einer eigenen
 * Komponente nicht (nachgemessen im gebauten CSS). Dasselbe macht
 * ClosingCta.astro, aus demselben Grund.
 *
 * Kein helles Thema: auf /webdesign-* setzt BaseLayout data-no-theme,
 * der Umschalter erscheint dort gar nicht.
 */
import { localeOf } from '../lib/routes.mjs';
import { SKIZZE } from '../lib/i18n/seiten/skizze';
import { testimonialsFuer, zerlegen, type TestimonialBranche } from '../lib/testimonials';

interface Props {
  branche: TestimonialBranche;
}

const { branche } = Astro.props;
const locale = localeOf(Astro.url.pathname);
const s = SKIZZE[locale as 'de' | 'en'];

const [gross, ...klein] = testimonialsFuer(branche);
const [vorG, phraseG, nachG] = zerlegen(gross);

/**
 * Die Schriftgroesse des grossen Zitats haengt an seiner LAENGE.
 *
 * Die drei Stimmen sind 112, 197 und 232 Zeichen lang. In einer
 * festen Groesse heisst das drei bis zwoelf Zeilen — und zwoelf
 * zentrierte Zeilen in 38px sind kein Zitat mehr, sondern ein Absatz
 * in Grossschrift. Genau so stand die Stimme von Dr. Witzak-Agah auf
 * der Praxis- und der Medienseite.
 *
 * Die drei Stufen sind so gewaehlt, dass JEDE Stimme auf drei bis
 * fuenf Zeilen kommt. Nebenwirkung: text-wrap: balance greift erst
 * bis etwa sechs Zeilen — in der alten Groesse lief es ins Leere.
 */
const stufe = gross.zitat.length > 200 ? 'lang' : gross.zitat.length > 140 ? 'mittel' : 'kurz';
---

<section class="ks" aria-labelledby="ks-titel">
  <p class="ks-augenbraue" id="ks-titel" data-reveal>{s.stimmen.titel}</p>

  {/* Der Bewertungs-Kopf. Die Zahl und die Sterne sagen dasselbe —
      zusammen sind sie ein Siegel, einzeln nur eine Angabe. Für
      Vorleseprogramme steht beides einmal als Satz da, die gemalten
      Teile sind ausgeblendet. */}
  <div class="ks-kopf" data-reveal>
    <p class="ks-note" aria-hidden="true" data-zaehlen>{s.stimmen.note}</p>
    <p class="ks-sterne" aria-hidden="true">★★★★★</p>
    <span class="ks-nurlesen">{s.stimmen.noteLabel}</span>
    <p class="ks-unterzeile">{s.stimmen.unterZeile}</p>
  </div>

  <figure class="ks-gross" data-laenge={stufe} data-reveal>
    {/* Reine Zierde, und zwar eine, die ein Vorleseprogramm sonst als
        Anführungszeichen vorlesen würde. */}
    <span class="ks-zeichen" aria-hidden="true">&ldquo;</span>
    <blockquote class="ks-gross-zitat">
      {vorG}<strong>{phraseG}</strong>{nachG}
    </blockquote>
    <figcaption class="ks-autor">
      <span class="ks-initialen" aria-hidden="true">{gross.initialen}</span>
      <span class="ks-autor-text">
        <strong>{gross.autor}</strong>
        <span>{gross.betrieb}</span>
      </span>
    </figcaption>
  </figure>

  <ul class="ks-raster">
    {
      klein.map((stimme) => {
        const [vor, phrase, nach] = zerlegen(stimme);
        return (
          <li class="ks-karte" data-reveal>
            {stimme.abzeichen && (
              <span class="ks-abzeichen" aria-hidden="true">{stimme.abzeichen}</span>
            )}
            <p class="ks-sterne-klein" aria-hidden="true">★★★★★</p>
            <span class="ks-nurlesen">{s.stimmen.sterne}</span>
            <blockquote class="ks-zitat">
              {vor}<strong>{phrase}</strong>{nach}
            </blockquote>
            <figure class="ks-autor">
              <span class="ks-initialen" aria-hidden="true">{stimme.initialen}</span>
              <figcaption class="ks-autor-text">
                <strong>{stimme.autor}</strong>
                <span>{stimme.betrieb}</span>
              </figcaption>
            </figure>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .ks {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto 96px;
    padding: 0 40px;
    text-align: center;
  }

  .ks-augenbraue {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: var(--lp-braue);
    letter-spacing: var(--lp-braue-sperrung);
    text-transform: uppercase;
    color: rgba(245, 158, 11, 0.85);
    margin: 0 0 26px;
  }

  /* === Bewertungs-Kopf === */
  .ks-kopf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 48px;
  }

  .ks-note {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: var(--lp-zahl);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #f5f5f4;
    margin: 0;
  }

  .ks-sterne {
    font-size: clamp(1.4rem, 3.4vw, 2rem);
    letter-spacing: 0.18em;
    line-height: 1;
    color: #f59e0b;
    margin: 4px 0 0;
    /* Der Buchstabenabstand hängt rechts als Leerraum nach und
       verschiebt die Reihe nach links. */
    text-indent: 0.18em;
  }

  .ks-unterzeile {
    font-family: var(--lp-mono);
    font-size: var(--lp-mono-groesse);
    letter-spacing: 0.14em;
    color: rgba(245, 245, 244, 0.45);
    margin: 10px 0 0;
  }

  /* === Die große Stimme === */
  .ks-gross {
    /* Grundstufe: kurzes Zitat. Die beiden anderen Stufen stehen
       darunter und ueberschreiben nur diese drei Werte. */
    --zitat-groesse: clamp(1.75rem, 3vw, 2.4rem);
    --zitat-breite: 720px;
    --zitat-zeile: 1.38;
    --zitat-zeichen: clamp(9rem, 22vw, 15rem);

    position: relative;
    max-width: var(--zitat-breite);
    margin: 0 auto 32px;
    padding: 0 8px;
  }

  .ks-gross[data-laenge='mittel'] {
    --zitat-groesse: clamp(1.45rem, 2.4vw, 1.95rem);
    --zitat-breite: 780px;
    --zitat-zeile: 1.42;
    --zitat-zeichen: clamp(7rem, 17vw, 11.5rem);
  }

  .ks-gross[data-laenge='lang'] {
    --zitat-groesse: clamp(1.3rem, 2.1vw, 1.7rem);
    --zitat-breite: 800px;
    --zitat-zeile: 1.46;
    --zitat-zeichen: clamp(6rem, 15vw, 10rem);
  }

  /* Hinter dem Zitat, nicht daneben: ein Anführungszeichen in dieser
     Größe ist Textur, kein Zeichen. */
  .ks-zeichen {
    position: absolute;
    top: -0.34em;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: var(--zitat-zeichen);
    line-height: 1;
    color: rgba(245, 158, 11, 0.09);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* AUFRECHT, NICHT KURSIV. Die Kursive von Neue Montreal ist ein
     echter eigener Schnitt mit anderen Buchstabenformen — einstöckiges
     a, anderes g. Bei einem Wort fällt das als Betonung auf, bei
     vierzig Wörtern in 38px liest es sich wie eine zweite Schrift auf
     der Seite. Dass es ein Zitat ist, sagen schon das
     Anführungszeichen dahinter und die Namenszeile darunter. */
  .ks-gross-zitat {
    position: relative;
    z-index: 1;
    margin: 0 0 26px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: var(--zitat-groesse);
    line-height: var(--zitat-zeile);
    letter-spacing: -0.012em;
    color: rgba(245, 245, 244, 0.95);
    text-wrap: balance;
  }

  .ks-gross-zitat strong,
  .ks-zitat strong {
    color: #f59e0b;
    font-weight: 500;
  }

  /* Ohne die Kursive trug die Hervorhebung nur noch die Farbe. Im
     grossen Zitat reicht das nicht — dort steht sie in Bold. */
  .ks-gross-zitat strong {
    font-weight: 700;
  }

  /* === Die beiden kleinen === */
  .ks-raster {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 0;
    padding: 0;
  }

  .ks-karte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 24px 22px;
    background: rgba(15, 15, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    text-align: left;
    transition:
      transform 280ms ease,
      border-color 280ms ease;
  }

  .ks-karte:hover {
    transform: translateY(-3px);
    border-color: rgba(245, 158, 11, 0.32);
  }

  .ks-abzeichen {
    position: absolute;
    top: 18px;
    right: 20px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: rgba(245, 158, 11, 0.95);
  }

  .ks-sterne-klein {
    margin: 0;
    font-size: 0.92rem;
    letter-spacing: 0.1em;
    line-height: 1;
    color: #f59e0b;
  }

  .ks-zitat {
    margin: 0;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: var(--lp-text);
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.8);
  }

  /* === Namenszeile, in beiden Größen gleich === */
  .ks-autor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    margin: 0;
  }

  .ks-karte .ks-autor {
    justify-content: flex-start;
    margin-top: auto;
    padding-top: 4px;
  }

  .ks-initialen {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(245, 158, 11, 0.4);
    background: rgba(245, 158, 11, 0.09);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(245, 158, 11, 0.95);
  }

  .ks-autor-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: left;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: var(--lp-klein);
    line-height: 1.35;
  }

  .ks-autor-text strong {
    font-weight: 600;
    color: #f5f5f4;
  }

  .ks-autor-text span {
    color: rgba(245, 245, 244, 0.5);
    font-size: 0.82rem;
  }

  .ks-nurlesen {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .ks {
      margin-bottom: 64px;
      padding: 0 20px;
    }

    .ks-kopf {
      margin-bottom: 36px;
    }

    .ks-raster {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .ks-abzeichen {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ks-karte {
      transition: none;
    }

    .ks-karte:hover {
      transform: none;
    }
  }
</style>
