---
// Shared Iframe-Preview-Modal fuer Referenzen. Verwendet auf:
//   - /referenzen (jede Card triggert das Modal via .ref-card-trigger)
//   - / (Landing-Teaser triggert via .ref-teaser-card)
//
// Modal ist singleton per Page: nur EINE Instanz pro Page-Mount, alle
// Trigger auf der Page nutzen dieselbe Modal-Instanz. Fuer Rapid-
// Open/Close-Sicherheit + saubere Cross-Origin-Load-Detection wird
// AbortController fuer Listener + 12s Safety-Timer verwendet.
---

<div class="ref-modal" id="ref-modal" hidden>
  <div class="ref-modal-backdrop" data-close-modal></div>
  <div
    class="ref-modal-content"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ref-modal-url"
  >
    <header class="ref-modal-header">
      <span class="ref-modal-url" id="ref-modal-url"></span>
      <div class="ref-modal-actions">
        <a
          class="ref-modal-external"
          id="ref-modal-external"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>In neuem Tab</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17L17 7M7 7h10v10" />
          </svg>
        </a>
        <button
          class="ref-modal-close"
          data-close-modal
          type="button"
          aria-label="Modal schließen"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>
    <div class="ref-modal-frame-wrap">
      <iframe
        class="ref-modal-iframe"
        id="ref-modal-iframe"
        src=""
        title="Referenz-Vorschau"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
        loading="lazy"></iframe>
      <div class="ref-modal-fallback" id="ref-modal-fallback" hidden>
        <p>Diese Seite kann nicht direkt eingebettet werden.</p>
        <a
          class="ref-modal-fallback-link"
          id="ref-modal-fallback-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          Im neuen Tab öffnen →
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .ref-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
  }

  .ref-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .ref-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
  }

  /* Reduced-Motion (iOS LPM): 100vw x 100vh backdrop-filter re-sample
     beim Modal-Open stallt den Open-Transition um 100-200ms auf iPhone
     LPM. Solid Background mit hoeherer Alpha ersetzt den Blur-Look.
     Normal-Mobile behaelt Frosted-Glass. */
  @media (prefers-reduced-motion: reduce) {
    .ref-modal-backdrop {
      background: rgba(0, 0, 0, 0.94);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .ref-modal-content {
    position: relative;
    width: 100%;
    max-width: 1280px;
    height: 100%;
    max-height: 800px;
    background: #0a0a0c;
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.6),
      0 0 80px rgba(245, 158, 11, 0.1);
  }

  .ref-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: rgba(15, 15, 18, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    gap: 16px;
  }

  .ref-modal-url {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.8rem;
    color: rgba(245, 245, 244, 0.6);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ref-modal-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-shrink: 0;
  }

  .ref-modal-external {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 6px;
    color: rgba(245, 158, 11, 0.95);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 200ms ease;
  }

  .ref-modal-external:hover,
  .ref-modal-external:focus-visible {
    background: rgba(245, 158, 11, 0.25);
    outline: none;
  }

  .ref-modal-close {
    width: 32px;
    height: 32px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: rgba(245, 245, 244, 0.8);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 200ms ease;
  }

  .ref-modal-close:hover,
  .ref-modal-close:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    outline: none;
  }

  .ref-modal-frame-wrap {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #fff;
  }

  .ref-modal-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .ref-modal-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: #0a0a0c;
    color: rgba(245, 245, 244, 0.8);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    text-align: center;
    padding: 40px;
  }

  .ref-modal-fallback-link {
    color: rgba(245, 158, 11, 0.95);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid rgba(245, 158, 11, 0.4);
    padding-bottom: 2px;
    transition: border-color 200ms ease;
  }

  .ref-modal-fallback-link:hover {
    border-bottom-color: rgba(245, 158, 11, 1);
  }

  @media (max-width: 768px) {
    .ref-modal {
      padding: 0;
    }
    .ref-modal-content {
      max-width: 100%;
      max-height: 100%;
      height: 100dvh;
      border-radius: 0;
      border: none;
    }
  }
</style>

<script>
  const modal = document.getElementById('ref-modal');
  const iframe = document.getElementById(
    'ref-modal-iframe'
  ) as HTMLIFrameElement | null;
  const fallback = document.getElementById('ref-modal-fallback');
  const fallbackLink = document.getElementById(
    'ref-modal-fallback-link'
  ) as HTMLAnchorElement | null;
  const urlDisplay = document.getElementById('ref-modal-url');
  const externalLink = document.getElementById(
    'ref-modal-external'
  ) as HTMLAnchorElement | null;
  // Beide Selector-Klassen: .ref-card-trigger (auf /referenzen) und
  // .ref-teaser-card (Landing-Teaser) triggern dasselbe Modal.
  const triggers = document.querySelectorAll<HTMLElement>(
    '.ref-card-trigger, .ref-teaser-card'
  );
  const closeBtns = document.querySelectorAll<HTMLElement>(
    '[data-close-modal]'
  );

  if (modal && iframe && fallback && fallbackLink && urlDisplay && externalLink) {
    let blockTimer: number | null = null;
    let abortController: AbortController | null = null;
    let lastFocused: HTMLElement | null = null;

    function showFallback() {
      if (!iframe || !fallback) return;
      iframe.style.display = 'none';
      fallback.hidden = false;
    }

    function openModal(url: string) {
      if (
        !modal ||
        !iframe ||
        !fallback ||
        !urlDisplay ||
        !externalLink ||
        !fallbackLink
      )
        return;

      // Vorigen Listener-Set + Safety-Timer abraeumen, falls offen
      if (abortController) abortController.abort();
      if (blockTimer) window.clearTimeout(blockTimer);
      abortController = new AbortController();

      lastFocused = document.activeElement as HTMLElement;
      urlDisplay.textContent = url;
      externalLink.href = url;
      fallbackLink.href = url;

      fallback.hidden = true;
      iframe.style.display = 'block';

      // Echte iframe-Load-Detection statt contentDocument-Probe.
      // Cross-Origin-contentDocument war kaputt: Chrome gibt
      // stillschweigend null zurueck -> false-positive Fallback bei
      // legitim ladenden Sites.
      let loaded = false;
      iframe.addEventListener(
        'load',
        () => {
          loaded = true;
        },
        { signal: abortController.signal }
      );
      iframe.addEventListener(
        'error',
        () => {
          showFallback();
        },
        { signal: abortController.signal }
      );

      iframe.src = url;

      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add('is-open'));
      document.body.style.overflow = 'hidden';

      // Safety-Net: nach 12s ohne Load-Event Fallback zeigen
      // (Site komplett unerreichbar / langsames Netz / stiller
      // X-Frame-Block ohne error-Event).
      blockTimer = window.setTimeout(() => {
        if (!loaded) showFallback();
      }, 12000);
    }

    function closeModal() {
      if (!modal || !iframe) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      if (abortController) {
        abortController.abort();
        abortController = null;
      }
      if (blockTimer) {
        window.clearTimeout(blockTimer);
        blockTimer = null;
      }
      window.setTimeout(() => {
        modal.hidden = true;
        iframe.src = '';
        if (lastFocused) lastFocused.focus();
      }, 200);
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const url = (btn as HTMLElement).dataset.url;
        if (url) openModal(url);
      });
    });

    closeBtns.forEach((btn) => {
      btn.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    });
  }
</script>
