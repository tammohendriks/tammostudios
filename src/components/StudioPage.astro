  /* Editor und PDF-Mock bleiben dunkel: beide stellen eine
     Programmoberflaeche dar, und die ist in Wirklichkeit auch
     dunkel. Ein heller Nachbau waere eine Oberflaeche, die es nicht
     gibt. */
</style>

<script>
  /* Die Schleife laeuft nur, solange der Kasten im Blick ist.
     Dieselbe Bremse wie beim Scroll-Moment auf den Branchenseiten:
     eine Animation hinter dem Bildschirmrand kostet Rechenzeit und
     zeigt niemandem etwas — auf einem Laptop im Akkubetrieb ist das
     der Unterschied zwischen lautlos und Luefter. */
  (() => {
    const editor = document.querySelector<HTMLElement>('[data-editor]');
    if (!editor) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const beobachter = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (e.isIntersecting) editor.dataset.laeuft = '';
          else delete editor.dataset.laeuft;
        }
      },
      // Erst wenn ein gutes Stueck davon zu sehen ist: sonst startet
      // der Durchlauf, waehrend nur die obere Kante im Bild haengt,
      // und das Beste ist vorbei, bevor jemand hinsieht.
      { threshold: 0.35 }
    );

    beobachter.observe(editor);
  })();
</script>
