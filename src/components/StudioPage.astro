  }

  /* ===================== HELLES THEMA =====================
     Die Seite hat den Umschalter wie jede Unterseite. Die Regeln
     stehen hier und nicht in global.css, weil beide Seiten desselben
     Paares dadurch dieselbe Astro-Kennung tragen und die hellen
     Regeln ohne !important gewinnen — anders als bei den
     Branchenseiten, deren Theme-Block von aussen eingreifen muss. */
  :global(html[data-site-theme='light']) .st-titel,
