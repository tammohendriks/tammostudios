---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from '../components/SubPageBackground.astro';
import ReferenzModal from '../components/ReferenzModal.astro';
import { REFERENCES } from '../lib/references';
import { SECTION5 } from '../lib/constants';

const { footer } = SECTION5;
---

<BaseLayout
  pageTitle="Referenzen"
  description="Eine kleine Auswahl der Sites, die ich zuletzt für Unternehmen gebaut habe, von der Praxis bis zur Kneipe. Jede Site ein Original, kein Template-Recycling."
>
  <main class="referenzen-page">
    <SubPageBackground />
    <header class="ref-hero">
      <h1 class="subpage-hero-title">Referenzen</h1>
      <p class="subpage-hero-subtitle ref-description">
        Eine kleine Auswahl der Sites, die ich zuletzt für
        Unternehmen gebaut habe. Von der Praxis bis zur Kneipe.
      </p>
    </header>

    <section class="ref-grid">
      {REFERENCES.map((ref) => (
        <article class="ref-card" data-slug={ref.slug} data-reveal>
          <div class="ref-preview">
            <img
              src={ref.preview}
              alt={`Vorschau von ${ref.title}`}
              loading="lazy"
            />
            <div class="ref-overlay">
              <span class="ref-overlay-label">Ansehen</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </div>
          </div>
          <div class="ref-info">
            <h3 class="ref-card-title">{ref.title}</h3>
            <p class="ref-card-subtitle">{ref.subtitle}</p>
            <div class="ref-tags">
              {ref.tags.map((tag) => (
                <span class="ref-tag">{tag}</span>
              ))}
            </div>
          </div>
          <button
            class="ref-card-trigger"
            data-url={ref.url}
            data-title={ref.title}
            type="button"
            aria-label={`${ref.title} im Modal öffnen`}
          />
        </article>
      ))}
    </section>

    <ReferenzModal />
  </main>

  <footer class="site-footer">
    <div class="footer-row">
      <span class="footer-brand">{footer.brand}</span>
      <nav class="footer-nav" aria-label="Hauptnavigation">
        {footer.navLinks.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </nav>
    </div>
    <div class="footer-row footer-row-legal">
      <span class="footer-copy">{footer.copyright}</span>
      <nav class="footer-legal" aria-label="Rechtliches">
        {footer.legalLinks.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  .referenzen-page {
    min-height: calc(100vh - 200px);
    background: #050507;
    padding: 140px 40px 80px;
    position: relative;
    overflow: hidden;
  }
  /* Atmosphäre via <SubPageBackground />, geteilt mit /ueber + /preise. */

  .ref-hero {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 80px;
    position: relative;
    z-index: 1;
    padding-top: 32px;
  }

  /* Typografie der H1 + Subtitle kommt aus .subpage-hero-title /
     .subpage-hero-subtitle in global.css. .ref-description bleibt
     als Marker-Klasse für etwaige seitenspezifische Overrides. */

  .ref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .ref-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .referenzen-page {
      padding: 100px 16px 60px;
    }
  }

  .ref-card {
    position: relative;
    background: rgba(15, 15, 18, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition:
      transform 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .ref-card:hover,
  .ref-card:focus-within {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.4);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 48px rgba(245, 158, 11, 0.15);
  }

  /* Card-Preview-Aspect matched die Source-WebP-Aspect (~2:1).
     Vorher 16:10 → 13% seitliche Crops pro Card, was Sites mit
     Randcontent (waermepower Headline links, ibi-doc Right-Nav)
     abschnitt. 2:1 zeigt alle WebPs edge-to-edge; andere 3 verlieren
     nur ~0.5% pro Seite (unsichtbar). */
  .ref-preview {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #0a0a0c;
  }

  .ref-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 600ms ease;
  }

  .ref-card:hover .ref-preview img,
  .ref-card:focus-within .ref-preview img {
    transform: scale(1.05);
  }

  .ref-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(245, 158, 11, 0.15) 0%,
      rgba(0, 0, 0, 0.4) 100%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #fff;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .ref-card:hover .ref-overlay,
  .ref-card:focus-within .ref-overlay {
    opacity: 1;
  }

  .ref-info {
    padding: 24px;
  }

  .ref-card-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    color: #f5f5f4;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .ref-card-subtitle {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    color: rgba(245, 245, 244, 0.65);
    margin: 0 0 16px;
  }

  .ref-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ref-tag {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(245, 158, 11, 0.85);
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    padding: 4px 10px;
    border-radius: 4px;
  }

  /* Unsichtbarer Click-Layer über die ganze Card — fängt Click,
     liest data-url. Nutzt button statt a href, damit Modal-Logik
     vor Navigation greift. focus-visible Ring für Tastatur-User. */
  .ref-card-trigger {
    position: absolute;
    inset: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 2;
  }

  .ref-card-trigger:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.8);
    outline-offset: 4px;
  }

  /* Modal-Styles wurden in src/components/ReferenzModal.astro
     ausgelagert — Component ist auf beiden Pages einsetzbar
     (/referenzen + Landing-Teaser). */

  /* Footer (gleicher Stil wie in Section 5 — bewusst dupliziert,
     statt Section 5 für eine Komponentenextraktion zu refaktorieren). */
  .site-footer {
    background: #050507;
    padding: 32px 40px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.78rem;
  }

  .footer-brand {
    color: rgba(245, 245, 244, 0.7);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer-copy {
    color: rgba(245, 245, 244, 0.5);
  }

  .footer-nav,
  .footer-legal {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-nav a,
  .footer-legal a {
    color: rgba(245, 245, 244, 0.7);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-legal a:hover,
  .footer-legal a:focus-visible {
    color: rgba(245, 158, 11, 0.95);
    outline: none;
  }

  .footer-row-legal {
    color: rgba(245, 245, 244, 0.4);
    font-size: 0.72rem;
  }

  @media (max-width: 768px) {
    .footer-row {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 4px 12px;
      font-size: 0.65rem;
    }
    .footer-row-legal {
      font-size: 0.6rem;
      opacity: 0.7;
    }
  }
</style>

<!-- Modal-Script lebt in src/components/ReferenzModal.astro -->

