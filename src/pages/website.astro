---
/**
 * /website — Uebersichts-Landingpage fuer "Website" als Angebots-
 * Bereich. Ersetzt die aufgegebene /studio Marketing-Seite (deren
 * CMS-USP-Content in Section "Du pflegst selbst" gemergt wurde) und
 * ist Ziel-URL fuer den Nav-Dropdown "Angebot → Website".
 *
 * Struktur:
 *   1. Hero (subpage-Konvention: centered, 780px, padding-top 32px)
 *   2. Problem-Framing — 3 Cards (Gefunden werden / Anfragen statt
 *      Anrufe / Selbst aktuell halten). Ersetzt die frueheren
 *      Branchen-Cards; /webdesign-* bleiben als SEO-Landings bestehen,
 *      sind hier aber nicht mehr die Sortierlogik.
 *   3. Du pflegst selbst (id="cms") — CMS-Autonomie USP (aus /studio migriert)
 *   4. Was du bekommst — Feature-Liste
 *   5. Was kostet's — kompakter Preis-Verweis auf /preise
 *   6. Aus der Praxis — 3 Referenz-Cards, Link zu /referenzen
 *   7. Final-CTA — Erstgespraech
 *
 * /studio Route wird via vercel.json rewrite → /website#cms redirected.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from '../components/SubPageBackground.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { REFERENCES } from '../lib/references';

/**
 * Problem-Framing statt Branchen-Gruppierung.
 *
 * Vorher standen hier drei Vertical-Cards (Handwerk/Praxis/Gastro). Das
 * hat die Seite kuenstlich verengt — gebaut wird fuer alles, zuletzt
 * z.B. fuer eine Spedition. Die /webdesign-* Deep-Landings bleiben als
 * SEO-Einstiege bestehen, sind hier aber nicht mehr die Sortierlogik.
 */
const problems = [
  {
    label: 'Gefunden werden',
    body:
      'Wer dich googelt, muss dich finden, und zwar vor dem Wettbewerb. ' +
      'Saubere Technik, strukturierte Daten, schnelle Ladezeiten. Das ist ' +
      'eingebaut, nicht nachgerüstet.',
  },
  {
    label: 'Anfragen statt Anrufe',
    body:
      'Ein Formular, das die richtigen Fragen stellt, spart dir das ' +
      'Telefonat. Bei Bedarf mit Preisrechner, Konfigurator oder ' +
      'PDF-Ausgabe.',
    linkHref: '/software',
    linkLabel: 'Wie weit das geht',
  },
  {
    label: 'Selbst aktuell halten',
    body:
      'Öffnungszeiten, Preise, neue Referenzen, ein Stellenangebot. Du ' +
      'änderst das selbst, in 30 Sekunden, ohne Ticket und ohne mich.',
    linkHref: '#cms',
    linkLabel: 'Wie das aussieht',
  },
];

const features = [
  { title: 'Handgemacht', body: 'Kein Wix, kein Squarespace. Astro + Tailwind + eigener Code, sauber auf deinen Betrieb geschnitten.' },
  { title: 'Eigenes CMS', body: 'Du pflegst Inhalte selbst. Texte, Bilder, Preise, Öffnungszeiten, in 30 Sekunden aktualisiert.' },
  { title: 'Mobile-first', body: '60% deiner Besucher kommen vom Handy. Deine Seite ist dort genauso schnell wie am Desktop.' },
  { title: 'SEO-Basis', body: 'Google-Ready aus dem Karton: strukturierte Daten, saubere URLs, schnelle Ladezeiten.' },
  { title: 'DSGVO-konform', body: 'EU-Hosting, korrekte Cookie-Handhabung, Impressum + Datenschutz strukturiert.' },
  { title: 'In 14 Tagen live', body: 'Vom Erstgespräch bis zur Live-Schaltung in maximal zwei Wochen. Meistens schneller.' },
];

// Website-Referenzen fuer die "Aus der Praxis" Section — nur die 3
// visuell staerksten Cases. Keine Duplikate mit Software-Page.
const websiteRefs = REFERENCES.filter((r) =>
  ['samedos', 'er-und-sie', 'kirsch-dach-fassade'].includes(r.slug)
);
---

<BaseLayout
  pageTitle="Website"
  title="Individuelle Website — handgemacht in Bremen | Tammo Studios"
  description="Deine individuelle Website, handgemacht in Bremen. Eigenes Redaktionssystem zum Selbstpflegen, eine individuelle Anwendung inklusive, ab 2.000 € und in 14 Tagen live."
>
  <main class="website-page">
    <SubPageBackground />

    <header class="website-hero">
      <h1 class="subpage-hero-title">Deine Website.</h1>
      <p class="subpage-hero-subtitle text-lines">
        {'Handgemacht in Bremen. Eine individuelle Anwendung ist drin.\nAb 2.000 €, in 14 Tagen live.'}
      </p>
      <div class="website-hero-cta">
        <a class="cta-inline" href="/kontakt">
          Erstgespräch anfragen
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
      </div>
    </header>

    <!-- ================================================================
         2. Problem-Framing — wofuer eine Website da ist
         ============================================================== -->
    <section class="website-problems" data-reveal aria-labelledby="problems-heading">
      <p class="website-eyebrow">WOFÜR DAS GANZE</p>
      <h2 id="problems-heading" class="website-section-title">Drei Probleme, immer die gleichen.</h2>
      <div class="problems-grid">
        {problems.map((p) => (
          <article class="problem-card" data-reveal>
            <h3 class="problem-card-label">{p.label}</h3>
            <p class="problem-card-body">{p.body}</p>
            {p.linkHref && (
              <a class="problem-card-cta" href={p.linkHref}>
                {p.linkLabel}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
              </a>
            )}
          </article>
        ))}
      </div>
      <p class="problems-note">
        Gebaut für Arztpraxen, Betriebsmedizin, Dachdecker, Heizungsbau,
        Gastronomie, Spedition. Die Branche war noch nie das Problem.
        <a href="/referenzen">Sieh dir an, was daraus wurde</a>.
      </p>
    </section>

    <!-- ================================================================
         3. Du pflegst selbst — CMS-Autonomie (id="cms" fuer /studio Redirect)
         ============================================================== -->
    <section id="cms" class="website-cms" data-reveal aria-labelledby="cms-heading">
      <p class="website-eyebrow">DU PFLEGST SELBST</p>
      <h2 id="cms-heading" class="website-section-title">Kein Anruf beim Entwickler.</h2>
      <div class="cms-body">
        <p>
          Deine Website wird von mir gebaut, nicht in Wix zusammengeklickt.
          Trotzdem änderst du Texte, Preise und Bilder selbst — über ein
          klares CMS-Studio, das ich für dich einrichte.
        </p>
        <p>
          Kein Anruf beim Entwickler. Kein 30-Minuten-Ticket für eine
          Preisänderung. Du hast die volle Kontrolle über deinen Content,
          ich sorge dafür dass das Fundament technisch sauber bleibt.
        </p>
        <ul class="cms-list">
          <li>Texte, Bilder und Preise ohne technisches Know-how</li>
          <li>Live-Vorschau bevor du speicherst</li>
          <li>Neue Team-Mitglieder, neue Öffnungszeiten, neue Preise in 30 Sekunden angepasst</li>
          <li>Bei Fragen: ich bin per Mail oder WhatsApp erreichbar</li>
        </ul>
        <p class="cms-examples">
          <strong>Beispiele:</strong> Bei Samedos änderst du die Preise → das PDF
          auf der Website aktualisiert sich automatisch. Bei IBI werden neue
          Team-Mitglieder in Minuten hinzugefügt.
        </p>
      </div>
    </section>

    <!-- ================================================================
         4. Was du bekommst — Feature-Liste
         ============================================================== -->
    <section class="website-features" data-reveal aria-labelledby="features-heading">
      <p class="website-eyebrow">WAS DU BEKOMMST</p>
      <h2 id="features-heading" class="website-section-title">Alles was eine Website 2026 braucht</h2>
      <div class="features-grid">
        {features.map((f) => (
          <div class="feature-item" data-reveal>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ================================================================
         5. Was kostet's — Preis-Verweis
         ============================================================== -->
    <section class="website-preise" data-reveal aria-labelledby="preise-heading">
      <p class="website-eyebrow">WAS KOSTET'S</p>
      <h2 id="preise-heading" class="website-section-title">Fixpreise, ohne Sternchen</h2>
      <div class="preise-cards">
        <div class="preise-item">
          <p class="preise-amount">2.000 €</p>
          <p class="preise-label">Eine Website</p>
        </div>
        <div class="preise-item">
          <p class="preise-amount">3.000 €</p>
          <p class="preise-label">Online-Shop</p>
        </div>
      </div>
      <p class="preise-inklusive">
        In beiden Preisen ist eine individuelle Anwendung enthalten: ein
        Preisrechner, ein durchdachtes Anfrageformular, ein Konfigurator.
        Sie wird in denselben 14 Tagen mitgebaut. Jede weitere kostet
        500 €.
      </p>
      <a class="cta-inline" href="/preise">
        Volle Preisübersicht ansehen
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
      </a>
    </section>

    <!-- ================================================================
         6. Aus der Praxis — 3 Referenz-Cards
         ============================================================== -->
    <section class="website-refs" data-reveal aria-labelledby="refs-heading">
      <p class="website-eyebrow">AUS DER PRAXIS</p>
      <h2 id="refs-heading" class="website-section-title">Kunden, die schon live sind</h2>
      <div class="refs-grid">
        {websiteRefs.map((r) => (
          <a class="ref-preview" href={r.url} target="_blank" rel="noopener noreferrer">
            <div class="ref-preview-image">
              <img src={r.preview} alt={`Vorschau: ${r.title}`} loading="lazy" />
            </div>
            <div class="ref-preview-body">
              <h3 class="ref-preview-title">{r.title}</h3>
              <p class="ref-preview-sub">{r.subtitle}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="refs-note">
        <a href="/referenzen">Alle Referenzen ansehen →</a>
      </p>
    </section>

    <!-- ================================================================
         7. Final-CTA
         ============================================================== -->
    <section class="website-final" data-reveal>
      <h2 class="website-final-headline">Sprechen wir.</h2>
      <p class="website-final-body">
        30 Minuten Erstgespräch, kostenlos, unverbindlich.
      </p>
      <a class="cta-orbital" href="/kontakt">
        Erstgespräch anfragen
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
      </a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .website-page {
    position: relative;
    background: #050507;
    padding: 140px 40px 80px;
    min-height: calc(100vh - 200px);
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .website-page {
      padding: 100px 20px 60px;
    }
  }

  .website-page > section,
  .website-hero {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  /* === Hero (subpage convention) === */
  .website-hero {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 96px;
    padding-top: 32px;
  }
  .website-hero-cta {
    margin-top: 28px;
  }

  /* === Shared section styling === */
  .website-eyebrow {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    color: rgba(245, 158, 11, 0.85);
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .website-section-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #f5f5f4;
    margin: 0 0 32px;
  }
  .website-page > section {
    margin-bottom: 96px;
  }
  @media (max-width: 768px) {
    .website-page > section {
      margin-bottom: 72px;
    }
  }

  /* === Problem-Framing === */
  .website-problems {
    text-align: center;
  }
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  @media (max-width: 768px) {
    .problems-grid {
      grid-template-columns: 1fr;
    }
  }
  /* Karten sind hier bewusst KEINE Links mehr (vorher Vertical-Cards,
     ganzflaechig klickbar). Deshalb kein Hover-Lift auf der Karte —
     nur der optionale CTA darin reagiert. */
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 22px;
    background: rgba(15, 15, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-align: left;
  }
  .problem-card-label {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.35rem;
    color: #f5f5f4;
    margin: 0;
  }
  .problem-card-body {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.72);
    margin: 0;
    flex: 1;
  }
  .problem-card-cta {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 6px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(245, 158, 11, 0.95);
    text-decoration: none;
    margin-top: 6px;
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
    padding-bottom: 2px;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .problem-card-cta:hover {
    color: rgba(252, 211, 77, 1);
    border-bottom-color: rgba(252, 211, 77, 1);
  }
  .problems-note {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(245, 245, 244, 0.6);
    margin: 0;
  }
  .problems-note a {
    color: rgba(245, 158, 11, 0.95);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* === CMS Section (id="cms" — scroll target from /studio redirect) === */
  .website-cms {
    scroll-margin-top: 100px;
    text-align: center;
  }
  .cms-body {
    max-width: 640px;
    margin: 0 auto;
    text-align: left;
  }
  .cms-body p {
    font-family: 'Inter', sans-serif;
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgba(245, 245, 244, 0.82);
    margin: 0 0 20px;
  }
  .cms-list {
    list-style: none;
    padding: 0;
    margin: 24px 0;
  }
  .cms-list li {
    position: relative;
    padding-left: 24px;
    font-family: 'Inter', sans-serif;
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.85);
    margin-bottom: 12px;
  }
  .cms-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: rgba(245, 158, 11, 0.85);
    font-weight: 600;
  }
  .cms-examples {
    padding: 20px;
    background: rgba(245, 158, 11, 0.06);
    border-left: 3px solid rgba(245, 158, 11, 0.5);
    border-radius: 6px;
    font-size: 0.95rem !important;
    color: rgba(245, 245, 244, 0.75) !important;
  }
  .cms-examples strong {
    color: rgba(245, 158, 11, 0.95);
  }

  /* === Features === */
  .website-features {
    text-align: center;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    text-align: left;
  }
  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
  .feature-item {
    padding: 24px;
    background: rgba(15, 15, 18, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
  }
  .feature-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #f5f5f4;
    margin: 0 0 8px;
  }
  .feature-body {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.7);
    margin: 0;
  }

  /* === Preise === */
  .website-preise {
    text-align: center;
  }
  .preise-inklusive {
    max-width: 56ch;
    margin: 0 auto 32px;
    font-family: 'Inter', sans-serif;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(245, 245, 244, 0.68);
  }
  .preise-cards {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .preise-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .preise-amount {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: rgba(245, 158, 11, 0.95);
    margin: 0;
  }
  .preise-label {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 245, 244, 0.65);
    margin: 0;
  }

  /* === Refs === */
  .website-refs {
    text-align: center;
  }
  .refs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  @media (max-width: 768px) {
    .refs-grid {
      grid-template-columns: 1fr;
    }
  }
  .ref-preview {
    display: flex;
    flex-direction: column;
    background: rgba(15, 15, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 240ms ease,
      transform 240ms ease;
  }
  .ref-preview:hover {
    border-color: rgba(245, 158, 11, 0.4);
    transform: translateY(-3px);
  }
  .ref-preview-image {
    aspect-ratio: 4 / 3;
    background: rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .ref-preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ref-preview-body {
    padding: 16px 18px;
    text-align: left;
  }
  .ref-preview-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    color: #f5f5f4;
    margin: 0 0 4px;
  }
  .ref-preview-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(245, 245, 244, 0.6);
    margin: 0;
  }
  .refs-note {
    font-family: 'Inter', sans-serif;
    margin: 0;
  }
  .refs-note a {
    color: rgba(245, 158, 11, 0.95);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* === Final CTA === */
  .website-final {
    text-align: center;
  }
  .website-final-headline {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: #f5f5f4;
    margin: 0 0 12px;
  }
  .website-final-body {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: rgba(245, 245, 244, 0.72);
    margin: 0 0 28px;
  }

  /* === Inline CTA link === */
</style>
