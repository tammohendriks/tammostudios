---
/**
 * /journal/[slug] — Individual Journal Post.
 *
 * Layout:
 *   Zurueck-Link → /journal
 *   Header (centered): tags + Datum, Titel H1, Excerpt
 *   Cover-Bild (full-width, ~500px)
 *   Two-Column-Grid: TOC + Body + Author-Card LINKS (65%),
 *                    Sticky Sidebar mit CTAs RECHTS (30%)
 *   Bottom-CTA-Block (full-width): Erstgespraech buchen
 *
 * TOC nur wenn Post > 800 Woerter. Sticky Sidebar Desktop-only, auf Mobile
 * stacked unter Content.
 *
 * SEO: seoTitle/seoDescription/ogImage ueberschreiben wenn gesetzt.
 * BlogPosting JSON-LD via additionalSchema.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import JournalThemeToggle from '../../components/JournalThemeToggle.astro';
import {
  getJournalPosts,
  getJournalPost,
  urlFor,
  formatJournalDate,
  countWords,
  extractToc,
  type JournalPost,
} from '../../lib/sanity';
import { renderPortableText } from '../../lib/portableText';
import { SITE } from '../../lib/constants';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getJournalPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
};

const { slug } = Astro.params;
const post: JournalPost | null = slug ? await getJournalPost(slug) : null;

if (!post) {
  return Astro.redirect('/journal');
}

const bodyHtml = renderPortableText(post.body);
const toc = extractToc(post.body);
const wordCount = countWords(post.body);
const showToc = wordCount > 800 && toc.length >= 2;

const coverUrl = urlFor(post.coverImage).width(1600).height(900).fit('crop').auto('format').url();
const ogUrl = post.ogImage
  ? urlFor(post.ogImage).width(1200).height(630).fit('crop').auto('format').url()
  : urlFor(post.coverImage).width(1200).height(630).fit('crop').auto('format').url();

const pageTitle = post.seoTitle || post.title;
const description = post.seoDescription || post.excerpt;
const author = post.author || 'Tammo Hendriks';

// BlogPosting JSON-LD, wird via additionalSchema in @graph gemerged
const articleSchema = {
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  author: { '@type': 'Person', name: author },
  image: ogUrl,
  mainEntityOfPage: `${SITE.url}/journal/${post.slug}`,
};
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  additionalSchema={articleSchema}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogUrl} />
    <meta property="article:published_time" content={post.publishedAt} />
    <meta property="article:author" content={author} />
    {post.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </Fragment>

  <main class="post-page">
    <a class="post-back post-back-fixed" href="/journal">← Zum Journal</a>
    <JournalThemeToggle />

    <div class="post-inner">
      <header class="post-header">
        <div class="post-meta-line">
          {post.tags?.map((tag) => (
            <span class="post-tag">{tag}</span>
          ))}
          <time class="post-date" datetime={post.publishedAt}>
            {formatJournalDate(post.publishedAt)}
          </time>
        </div>
        <h1 class="post-h1">{post.title}</h1>
        <p class="post-lede">{post.excerpt}</p>
      </header>

      <figure class="post-cover">
        <img
          src={coverUrl}
          alt={post.coverImage.alt || post.title}
          loading="eager"
          fetchpriority="high"
          width="1600"
          height="900"
        />
      </figure>

      <div class="post-layout">
        <div class="post-main">
          {showToc && (
            <aside class="post-toc-mobile" aria-label="Inhaltsverzeichnis">
              <details>
                <summary>Inhalt</summary>
                <ol class="post-toc-mobile-list">
                  {toc.map((item) => (
                    <li><a href={`#${item.id}`}>{item.text}</a></li>
                  ))}
                </ol>
              </details>
            </aside>
          )}

          <article class="post-body" set:html={bodyHtml} />

          <section class="post-author">
            <img
              src="/tammo-foto.webp"
              alt="Tammo Hendriks"
              class="post-author-photo"
              width="80"
              height="80"
              loading="lazy"
            />
            <div class="post-author-text">
              <p>
                <strong>{author}</strong> — Freelance-Webdeveloper aus Bremen,
                aktuell auf Reise durch Asien. Baut handgemachte Websites für
                kleine Unternehmen, eine nach der anderen.
              </p>
              <a class="post-author-link" href="/ueber">Mehr über mich →</a>
            </div>
          </section>
        </div>

        <aside class="post-sidebar" aria-label="Direkt zu und Inhaltsverzeichnis">
          <div class="sidebar-sticky">
            <p class="sidebar-title">Direkt zu:</p>
            <ul class="sidebar-links">
              <li><a href="/preisrechner">Preisrechner öffnen →</a></li>
              <li><a href="/referenzen">Alle Referenzen ansehen →</a></li>
              <li><a href="/kontakt">Kontakt aufnehmen →</a></li>
              <li><a href="/journal">Alle Journal-Beiträge →</a></li>
            </ul>

            {showToc && (
              <>
                <p class="sidebar-title sidebar-title-toc">Inhalt</p>
                <ol class="sidebar-toc-list">
                  {toc.map((item) => (
                    <li><a href={`#${item.id}`}>{item.text}</a></li>
                  ))}
                </ol>
              </>
            )}
          </div>
        </aside>
      </div>
    </div>

    <section class="post-bottom-cta">
      <div class="bottom-cta-inner">
        <p class="bottom-cta-line">Klingt spannend?</p>
        <a class="bottom-cta-link" href="/kontakt">
          Jetzt Erstgespräch anfragen →
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  // Smooth-Scroll fuer TOC-Anchor-Links. Aktiviert nur wenn User keine
  // reduzierte Motion praeferiert (dann direkter Sprung).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    // Smooth-scroll fuer BEIDE TOCs (Desktop-Sidebar + Mobile-oben)
    document
      .querySelectorAll<HTMLAnchorElement>(
        '.sidebar-toc-list a[href^="#"], .post-toc-mobile a[href^="#"]'
      )
      .forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href')?.slice(1);
          if (!id) return;
          const target = document.getElementById(id);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', `#${id}`);
          }
        });
      });
  }
</script>

<style>
  .post-page {
    position: relative;
    background: #050507;
    color: #f5f5f4;
    padding: 100px 40px 0;
    min-height: 100vh;
  }
  @media (max-width: 768px) {
    .post-page {
      padding: 90px 20px 0;
    }
  }

  .post-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Fixed Back-Link: sitzt permanent oben-links unter der TopBar, egal
     wie weit der User scrollt. Solid dunkles Pill matched TopBar-
     Aesthetik in beiden Themes (Nav-Element, nicht Content). */
  .post-back-fixed {
    position: fixed;
    top: 88px;
    left: 24px;
    z-index: 50;
    display: inline-block;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(245, 245, 244, 0.85);
    text-decoration: none;
    padding: 8px 14px;
    background: rgba(5, 5, 7, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .post-back-fixed:hover {
    color: rgba(245, 158, 11, 0.95);
    border-color: rgba(245, 158, 11, 0.5);
  }
  @media (max-width: 768px) {
    .post-back-fixed {
      top: 74px;
      left: 16px;
      font-size: 0.8rem;
      padding: 6px 12px;
    }
  }

  /* === Header === */
  .post-header {
    max-width: 780px;
    margin: 0 auto 40px;
    text-align: center;
  }
  .post-meta-line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .post-date {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(245, 245, 244, 0.55);
  }
  .post-h1 {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: #fafaf9;
  }
  .post-lede {
    font-family: 'Inter', sans-serif;
    font-size: 1.15rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.75);
    margin: 0;
  }

  /* === Cover ===
     max-width matcht .post-header (780px) damit Cover visuell unter dem
     Header sitzt statt in die Grid-Sidebar-Zone auszulaufen. */
  .post-cover {
    max-width: 780px;
    margin: 0 auto 60px;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-height: 500px;
    background: #0a0a0c;
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* === Two-Column Layout === */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 60px;
    margin-bottom: 80px;
  }
  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  .post-main {
    min-width: 0;
    max-width: 720px;
    /* margin auto auch auf Desktop → Content zentriert in seiner Grid-
       Column (1fr). Sidebar bleibt rechts, Content bekommt Atemluft
       links statt Kante an .post-inner max-width zu kleben. */
    margin: 0 auto;
  }

  /* === Sidebar TOC (Desktop) ===
     Table of Contents in der rechten Sidebar unter „Direkt zu:" — User
     kann waehrend des Lesens zwischen den Kapiteln springen ohne nach
     oben scrollen zu muessen. Sticky durch .sidebar-sticky.
     Auf Mobile ausgeblendet, dort uebernimmt .post-toc-mobile oben. */
  .sidebar-title-toc {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sidebar-toc-list {
    list-style: decimal;
    padding-left: 20px;
    margin: 0;
    color: rgba(245, 245, 244, 0.55);
  }
  .sidebar-toc-list li {
    padding: 4px 0;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .sidebar-toc-list a {
    color: rgba(245, 245, 244, 0.75);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .sidebar-toc-list a:hover {
    color: rgba(245, 158, 11, 0.95);
  }

  /* === Mobile TOC ===
     Auf Mobile stackt die Sidebar unter den Content — TOC unten ergibt
     keinen Sinn (User will vor dem Lesen wissen was kommt). Also ein
     collapsibles <details> oben im .post-main, nur auf Mobile sichtbar.
     Desktop-Sidebar-TOC uebernimmt ab 901px. */
  .post-toc-mobile {
    display: none; /* default hidden, mobile-only */
  }

  @media (max-width: 900px) {
    .post-toc-mobile {
      display: block;
      margin: 0 0 32px;
      padding: 14px 18px;
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 8px;
      background: rgba(245, 158, 11, 0.05);
    }
    .post-toc-mobile summary {
      font-family: 'Neue Montreal', 'Inter', sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(245, 158, 11, 0.95);
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px 0;
    }
    .post-toc-mobile summary::-webkit-details-marker {
      display: none;
    }
    .post-toc-mobile summary::before {
      content: '▸';
      font-size: 0.7rem;
      transition: transform 150ms ease;
      color: rgba(245, 158, 11, 0.7);
    }
    .post-toc-mobile[open] summary::before {
      transform: rotate(90deg);
    }
    .post-toc-mobile-list {
      list-style: decimal;
      padding: 12px 0 4px 22px;
      margin: 0;
      color: rgba(245, 245, 244, 0.55);
    }
    .post-toc-mobile-list li {
      padding: 5px 0;
      font-family: 'Inter', sans-serif;
      font-size: 0.92rem;
      line-height: 1.4;
    }
    .post-toc-mobile-list a {
      color: rgba(245, 245, 244, 0.85);
      text-decoration: none;
    }
    /* Sidebar-TOC auf Mobile ausblenden — nur der Mobile-Block oben */
    .sidebar-title-toc,
    .sidebar-toc-list {
      display: none;
    }
  }

  /* === Body: Serif Reading Font === */
  .post-body {
    font-family: Georgia, Charter, 'Iowan Old Style', 'Times New Roman', serif;
    font-size: 1.08rem;
    line-height: 1.75;
    color: rgba(245, 245, 244, 0.88);
  }
  .post-body :global(p) {
    margin: 0 0 1.4em;
  }
  .post-body :global(h2) {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 2.2em 0 0.6em;
    color: #fafaf9;
    scroll-margin-top: 90px;
  }
  .post-body :global(h3) {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.8em 0 0.5em;
    color: #fafaf9;
    scroll-margin-top: 90px;
  }
  .post-body :global(a.post-link) {
    color: rgba(245, 158, 11, 0.95);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 180ms ease;
  }
  .post-body :global(a.post-link:hover) {
    color: rgba(252, 211, 77, 1);
  }
  .post-body :global(.inline-code) {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.92em;
    background: rgba(245, 158, 11, 0.1);
    color: rgba(252, 211, 77, 1);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .post-body :global(.post-code) {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.88rem;
    line-height: 1.5;
    background: #0a0a0c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 18px 20px;
    overflow-x: auto;
    margin: 1.6em 0;
    color: rgba(245, 245, 244, 0.9);
  }
  .post-body :global(.post-quote) {
    font-style: italic;
    border-left: 3px solid rgba(245, 158, 11, 0.6);
    padding-left: 20px;
    margin: 1.8em 0;
    color: rgba(245, 245, 244, 0.75);
  }
  .post-body :global(.post-list) {
    padding-left: 24px;
    margin: 0 0 1.4em;
  }
  .post-body :global(.post-list li) {
    margin-bottom: 0.4em;
  }
  .post-body :global(.post-figure) {
    margin: 2em 0;
    border-radius: 8px;
    overflow: hidden;
  }
  .post-body :global(.post-figure img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* === Author === */
  .post-author {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 24px;
    margin-top: 60px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(15, 15, 18, 0.55);
  }
  .post-author-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .post-author-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.75);
  }
  .post-author-text p {
    margin: 0 0 10px;
  }
  .post-author-link {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(245, 158, 11, 0.95);
    text-decoration: none;
    transition: color 180ms ease;
  }
  .post-author-link:hover {
    color: rgba(252, 211, 77, 1);
  }

  /* === Sidebar === */
  .post-sidebar {
    min-width: 0;
  }
  .sidebar-sticky {
    position: sticky;
    top: 100px;
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(15, 15, 18, 0.55);
  }
  .sidebar-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 158, 11, 0.95);
    margin: 0 0 14px;
  }
  .sidebar-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sidebar-links li {
    padding: 8px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .sidebar-links li:first-child {
    border-top: none;
  }
  .sidebar-links a {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    color: rgba(245, 245, 244, 0.85);
    text-decoration: none;
    display: block;
    transition: color 180ms ease;
  }
  .sidebar-links a:hover {
    color: rgba(245, 158, 11, 0.95);
  }

  /* === Bottom CTA ===
     Editorial-Style inline-Link statt Amber-Pill-Button — matcht
     Preisrechner-Bottom-CTA. Ruhiger, textueller Abschluss statt
     visuell dominanter Call-to-Action Balken. */
  .post-bottom-cta {
    padding: 80px 40px 60px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 40px;
  }
  @media (max-width: 768px) {
    .post-bottom-cta {
      padding: 60px 20px 40px;
    }
  }
  .bottom-cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .bottom-cta-line {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 500;
    color: rgba(245, 245, 244, 0.9);
    margin: 0 0 20px;
    letter-spacing: -0.005em;
  }
  .bottom-cta-link {
    display: inline-block;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 1rem;
    color: rgba(245, 158, 11, 0.95);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 158, 11, 0.4);
    padding-bottom: 2px;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .bottom-cta-link:hover {
    color: rgba(252, 211, 77, 1);
    border-color: rgba(252, 211, 77, 1);
  }

  /* === Shared Tag === */
  .post-tag {
    display: inline-block;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 158, 11, 0.95);
    padding: 4px 10px;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 999px;
  }

  /* =====================================================================
     === Light-Theme (White Mode) Overrides ==============================
     ===================================================================== */

  /* Aktiviert wenn User in JournalThemeToggle auf Light umschaltet.
     data-journal-theme wird von BaseLayout's inline-Script auf <html>
     gesetzt (aus localStorage) BEVOR die Page rendert → kein Flash.
     Amber-Akzente bleiben identisch, nur BG + Text invertiert.
     Nav-Elements (Back-Link, Toggle) bleiben dunkle Pills — konsistent
     mit TopBar-Aesthetik. */

  html[data-journal-theme='light'] .post-page {
    background: #f8f4ea;
    color: rgba(26, 26, 28, 0.88);
  }

  html[data-journal-theme='light'] .post-h1,
  html[data-journal-theme='light'] .post-body :global(h2),
  html[data-journal-theme='light'] .post-body :global(h3) {
    color: #1a1a1c;
  }

  html[data-journal-theme='light'] .post-lede {
    color: rgba(26, 26, 28, 0.75);
  }

  html[data-journal-theme='light'] .post-date {
    color: rgba(26, 26, 28, 0.55);
  }

  html[data-journal-theme='light'] .post-body {
    color: rgba(26, 26, 28, 0.88);
  }

  html[data-journal-theme='light'] .post-body :global(.inline-code) {
    background: rgba(245, 158, 11, 0.14);
    color: #92400e;
  }

  html[data-journal-theme='light'] .post-body :global(.post-code) {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
    color: rgba(26, 26, 28, 0.9);
  }

  html[data-journal-theme='light'] .post-body :global(.post-quote) {
    color: rgba(26, 26, 28, 0.75);
  }

  html[data-journal-theme='light'] .sidebar-title-toc {
    border-top-color: rgba(0, 0, 0, 0.08);
  }
  html[data-journal-theme='light'] .sidebar-toc-list {
    color: rgba(26, 26, 28, 0.5);
  }
  html[data-journal-theme='light'] .sidebar-toc-list a {
    color: rgba(26, 26, 28, 0.75);
  }
  html[data-journal-theme='light'] .post-toc-mobile-list {
    color: rgba(26, 26, 28, 0.5);
  }
  html[data-journal-theme='light'] .post-toc-mobile-list a {
    color: rgba(26, 26, 28, 0.85);
  }

  html[data-journal-theme='light'] .post-author,
  html[data-journal-theme='light'] .sidebar-sticky {
    background: rgba(255, 255, 255, 0.7);
    border-color: rgba(0, 0, 0, 0.08);
  }
  html[data-journal-theme='light'] .post-author-text {
    color: rgba(26, 26, 28, 0.75);
  }
  html[data-journal-theme='light'] .sidebar-links li {
    border-color: rgba(0, 0, 0, 0.08);
  }
  html[data-journal-theme='light'] .sidebar-links a {
    color: rgba(26, 26, 28, 0.85);
