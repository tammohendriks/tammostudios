---
import { en as EN } from '../../lib/i18n';
/**
 * /journal — Uebersichts-Seite.
 *
 * Layout:
 *   Centered Hero (Eyebrow, Headline, Subheadline)
 *   Filter-Chips (client-JS, kein Reload)
 *   Featured Post (neuester, 2-Col Cover+Text)
 *   Grid (3 Cols Desktop, 1 Col Mobile)
 *
 * Content aus Sanity via getJournalPosts. Bei leerem Dataset zeigen wir
 * einen Empty-State ("Bald mehr hier" statt Placeholder-Karten).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubPageBackground from '../../components/SubPageBackground.astro';
import JournalAtmosphere from '../../components/JournalAtmosphere.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getJournalPosts, urlFor, formatJournalDate } from '../../lib/sanity';
// Dieselbe Quelle, aus der das Studio-Schema und das Veroeffentlichen-
// Skript ihre Tag-Auswahl nehmen.
import { TAG_OPTIONS } from '../../../sanity/schemaTypes/constants.js';

const posts = await getJournalPosts();
const [featured, ...rest] = posts;

// Die REIHENFOLGE der Chips ist eine Gestaltungsfrage und steht
// deshalb hier. Die MENGE darf aber nicht von den Tags abweichen, die
// im Studio ueberhaupt vergeben werden koennen — sonst gibt es
// entweder einen Tag ohne Chip (Beitraege darunter sind nicht
// filterbar) oder einen Chip ohne Tag (bleibt fuer immer leer).
//
// Vorher stand die Liste hier doppelt, und zwar schon leicht anders:
// Prozess und Preise waren gegenueber TAG_OPTIONS vertauscht. Das ist
// harmlos, zeigt aber, wie zwei Listen auseinanderlaufen, sobald es
// zwei sind.
const TAG_REIHENFOLGE = [
  'Handwerk',
  'Praxis',
  'Gastronomie',
  'Prozess',
  'Preise',
  'Recruiting',
  'Tools',
  'SEO',
  'Design',
];

const nurHier = TAG_REIHENFOLGE.filter((t) => !TAG_OPTIONS.includes(t));
const nurImStudio = TAG_OPTIONS.filter((t) => !TAG_REIHENFOLGE.includes(t));
if (nurHier.length || nurImStudio.length) {
  throw new Error(
    'Die Filter-Chips des Journals passen nicht zu den Tags im Studio.' +
      (nurImStudio.length ? `\n  Tag ohne Chip: ${nurImStudio.join(', ')}` : '') +
      (nurHier.length ? `\n  Chip ohne Tag: ${nurHier.join(', ')}` : '') +
      '\nTAG_REIHENFOLGE hier und TAG_OPTIONS in' +
      ' sanity/schemaTypes/constants.js in Deckung bringen.'
  );
}

const TAG_FILTERS = ['Alle', ...TAG_REIHENFOLGE];
---

<BaseLayout
  pageTitle="Journal"
  title="Journal: Websites, Preise, Prozess | Tammo Studios"
  description="Das Journal von Tammo Studios aus Bremen: was eine Website kostet, wie lange sie dauert, was Praxen und Handwerker wirklich brauchen. Ohne Agentursprech."
>
  <Fragment slot="head">
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Tammo Studios Journal"
      href="/journal/rss.xml"
    />
  </Fragment>

  <main class="journal-page">
    <SubPageBackground />
    <JournalAtmosphere />

    <header class="journal-hero">
      <h1 class="subpage-hero-title">Mein Journal.</h1>
      <p class="subpage-hero-subtitle text-lines">
        {"Gedanken über Webdesign, Preise, Prozess.\nNur wenn's was zu sagen gibt."}
      </p>
      {/* Englisch, weil der Hinweis sich an englischsprachige Besucher
          richtet: auf dieser Seite gibt es keinen Sprach-Umschalter,
          und sie sollen verstehen warum. lang-Attribut, damit
          Vorleseprogramme umschalten. */}
      {/* Aus dem Woerterbuch, nicht fest im Markup: der Satz stand
          sonst an zwei Orten, und wer ihn im Woerterbuch aenderte,
          aenderte die Seite nicht. lang="en" bleibt richtig — das
          Journal laeuft immer unter der deutschen Route, der Satz ist
          das einzige Englische darauf. */}
      <p class="journal-lang-note" lang="en">{EN.journal.nurDeutsch}</p>
    </header>

    {posts.length > 0 && (
      <div class="journal-suche">
        {/* Kein <form>: es gibt nichts abzuschicken, gefiltert wird im
            Browser. Ein form wuerde bei Enter die Seite neu laden und
            die Eingabe verlieren. */}
        <label class="journal-suche-label" for="journal-suche">
          Beiträge durchsuchen
        </label>
        <div class="journal-suche-feld">
          <svg class="journal-suche-lupe" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" />
            <line x1="12.8" y1="12.8" x2="17" y2="17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <input
            type="search"
            id="journal-suche"
            name="q"
            class="journal-suche-eingabe"
            placeholder="z.B. Bearbeitungssystem, Preise, DSGVO"
            autocomplete="off"
            enterkeyhint="search"
          />
          <button
            type="button"
            class="journal-suche-leeren"
            data-suche-leeren
            aria-label="Suche zurücksetzen"
            hidden
          >
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <line x1="6" y1="6" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <line x1="14" y1="6" x2="6" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        {/* role="status" statt stiller Umschaltung: wer die Seite vorlesen
            laesst, bekommt sonst nicht mitgeteilt, dass sich unter dem
            Feld gerade die halbe Seite geaendert hat. */}
        <p class="journal-suche-status" role="status" data-suche-status></p>
      </div>
    )}

    {posts.length > 0 && (
      <nav class="journal-filters" aria-label="Beiträge nach Kategorie filtern">
        <ul class="filter-chips">
          {TAG_FILTERS.map((tag) => (
            <li>
              <button
                type="button"
                class:list={['filter-chip', tag === 'Alle' && 'is-active']}
                data-filter={tag}
              >
                {tag}
              </button>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {posts.length === 0 ? (
      <section class="journal-empty">
        <p>Noch keine Beiträge. Bald mehr hier.</p>
      </section>
    ) : (
      <>
        <div class="journal-filter-empty" data-filter-empty hidden>
          <p>
            <span data-filter-empty-text></span>
            <button type="button" class="filter-reset" data-filter-reset>
              Alle anzeigen
            </button>
          </p>
        </div>

        {featured && (
          <article
            class="featured-post"
            data-slug={featured.slug}
            data-tags={(featured.tags || []).join(',')}
          >
            <a class="featured-cover" href={`/journal/${featured.slug}`} aria-label={`Beitrag lesen: ${featured.title}`}>
              <img
                src={urlFor(featured.coverImage).width(1200).height(800).fit('crop').auto('format').url()}
                alt={featured.coverImage.alt || featured.title}
                loading="eager"
                width="1200"
                height="800"
              />
            </a>
            <div class="featured-meta">
              {featured.tags && featured.tags[0] && (
                <span class="post-tag">{featured.tags[0]}</span>
              )}
              <h2 class="featured-title">
                <a href={`/journal/${featured.slug}`}>{featured.title}</a>
              </h2>
              <p class="featured-excerpt">{featured.excerpt}</p>
              <a class="featured-cta" href={`/journal/${featured.slug}`}>
                Weiterlesen →
              </a>
            </div>
          </article>
        )}

        {rest.length > 0 && (
          <section class="journal-grid" aria-label="Weitere Beiträge">
            {rest.map((post) => (
              <article
                class="post-card"
                data-slug={post.slug}
                data-tags={(post.tags || []).join(',')}
              >
                <a class="post-card-link" href={`/journal/${post.slug}`} aria-label={`Beitrag lesen: ${post.title}`}>
                  <div class="post-card-cover">
                    <img
                      src={urlFor(post.coverImage).width(720).height(480).fit('crop').auto('format').url()}
                      alt={post.coverImage.alt || post.title}
                      loading="lazy"
                      width="720"
                      height="480"
                    />
                  </div>
                  <div class="post-card-body">
                    {post.tags && post.tags[0] && (
                      <span class="post-tag">{post.tags[0]}</span>
                    )}
                    <h3 class="post-card-title">{post.title}</h3>
                    <p class="post-card-excerpt">{post.excerpt}</p>
                    <time class="post-card-date" datetime={post.publishedAt}>
                      {formatJournalDate(post.publishedAt)}
                    </time>
                  </div>
                </a>
              </article>
            ))}
          </section>
        )}
      </>
    )}
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  // Tag-Filter UND Suche, zusammen in einem Durchgang.
  //
  // Beide blenden dieselben Karten ein und aus, also darf es nur EINE
  // Stelle geben, die das entscheidet — sonst ueberschreibt die zweite,
  // was die erste gerade gesetzt hat. Der Zustand steht in zwei
  // Variablen, anwenden() liest beide.
  //
  // Die Reihenfolge der Karten bleibt, wie sie ist. Nach Punktzahl zu
  // sortieren waere naheliegend, wuerde aber den hervorgehobenen
  // Beitrag aus seinem eigenen Layout reissen: der steht im Markup als
  // breite Karte ueber dem Raster und kann nicht einfach dahinter
  // rutschen.
  import { suchen, type Indexeintrag } from '../../lib/journalSuche';

  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('[data-tags]');
  const emptyEl = document.querySelector<HTMLElement>('[data-filter-empty]');
  const emptyTextEl = document.querySelector<HTMLElement>(
    '[data-filter-empty-text]'
  );
  const resetBtn = document.querySelector<HTMLButtonElement>(
    '[data-filter-reset]'
  );
  const sucheEl = document.querySelector<HTMLInputElement>('#journal-suche');
  const leerenBtn = document.querySelector<HTMLButtonElement>('[data-suche-leeren]');
  const statusEl = document.querySelector<HTMLElement>('[data-suche-status]');

  let aktiverTag = 'Alle';
  let anfrage = '';
  /** Der Suchindex, erst geladen wenn jemand wirklich tippt. */
  let index: Record<string, Indexeintrag> | null = null;
  let ladefehler = false;

  const setActive = (tag: string) => {
    chips.forEach((c) => {
      const isActive = (c.dataset.filter || '') === tag;
      c.classList.toggle('is-active', isActive);
    });
  };

  const anwenden = () => {
    // Ohne Anfrage oder ohne Index wird nicht gesucht, nur nach Tag
    // gefiltert. Das ist der Zustand, solange der Index noch laedt —
    // und der Zustand fuer immer, falls er nicht ankommt.
    const treffer = anfrage && index ? suchen(index, anfrage) : null;

    let sichtbar = 0;
    cards.forEach((card) => {
      const tags = (card.dataset.tags || '').split(',').filter(Boolean);
      const tagPasst = aktiverTag === 'Alle' || tags.includes(aktiverTag);
      const suchePasst = !treffer || treffer.has(card.dataset.slug || '');
      const passt = tagPasst && suchePasst;
      card.style.display = passt ? '' : 'none';
      if (passt) sichtbar += 1;
    });

    if (statusEl) {
      if (ladefehler) {
        statusEl.textContent =
          'Die Suche konnte nicht geladen werden. Die Kategorien oben funktionieren weiter.';
      } else if (!anfrage) {
        statusEl.textContent = '';
      } else if (!index) {
        statusEl.textContent = 'Suche wird geladen …';
      } else if (sichtbar === 0) {
        // Kurz, weil das Feld unten den ganzen Satz samt Zurücksetzen
        // zeigt. Zweimal dasselbe wäre doppelt — aber ganz zu schweigen
        // auch falsch: wer die Seite vorlesen lässt, hört nur diese
        // Zeile, das Feld unten ist keine Live-Region.
        statusEl.textContent = 'Keine Beiträge gefunden.';
      } else {
        statusEl.textContent =
          sichtbar === 1
            ? '1 Beitrag gefunden.'
            : `${sichtbar} Beiträge gefunden.`;
      }
    }

    if (leerenBtn) leerenBtn.hidden = !anfrage;

    if (emptyEl && emptyTextEl) {
      if (sichtbar === 0) {
        emptyTextEl.textContent =
          anfrage && aktiverTag !== 'Alle'
            ? `Keine Beiträge zu „${anfrage}“ unter „${aktiverTag}“.`
            : anfrage
              ? `Keine Beiträge zu „${anfrage}“.`
              : `Keine Beiträge unter „${aktiverTag}“.`;
        emptyEl.hidden = false;
      } else {
        emptyEl.hidden = true;
      }
    }
  };

  /**
   * Holt den Index einmal. Mehrfache Tastendruecke warten auf dasselbe
   * Versprechen, statt den Index mehrfach zu laden.
   */
  let laden: Promise<void> | null = null;
  const indexHolen = () => {
    if (index || laden) return laden ?? Promise.resolve();
    laden = fetch('/journal/suchindex.json')
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((daten: Record<string, Indexeintrag>) => {
        index = daten;
      })
      .catch(() => {
        ladefehler = true;
      })
      .then(() => {
        anwenden();
      });
    return laden;
  };

  /** Die Anfrage in die Adresse schreiben, damit man sie teilen kann. */
  const adresseSchreiben = () => {
    const url = new URL(window.location.href);
    if (anfrage) url.searchParams.set('q', anfrage);
    else url.searchParams.delete('q');
    // replaceState, nicht pushState: sonst liegen nach „Bearbeitungssystem"
    // achtzehn Einträge im Verlauf und der Zurück-Knopf fuehrt nicht
    // zurueck zur vorigen Seite, sondern Buchstabe fuer Buchstabe durch
    // die Eingabe.
    window.history.replaceState(null, '', url);
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      aktiverTag = chip.dataset.filter || 'Alle';
      setActive(aktiverTag);
      anwenden();
    });
  });

  resetBtn?.addEventListener('click', () => {
    aktiverTag = 'Alle';
    anfrage = '';
    if (sucheEl) sucheEl.value = '';
    setActive('Alle');
    adresseSchreiben();
    anwenden();
  });

  leerenBtn?.addEventListener('click', () => {
    anfrage = '';
    if (sucheEl) {
      sucheEl.value = '';
      sucheEl.focus();
    }
    adresseSchreiben();
    anwenden();
  });

  if (sucheEl) {
    // Kurz warten, statt bei jedem Buchstaben durch 145 kB zu laufen.
    // 160 ms ist unter der Schwelle, ab der Tippen sich zaeh anfuehlt,
    // und spart bei einem Wort wie „bearbeitungssystem“ 17 Durchgaenge.
    let timer = 0;
    sucheEl.addEventListener('input', () => {
      anfrage = sucheEl.value.trim();
      if (anfrage) void indexHolen();
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        adresseSchreiben();
        anwenden();
      }, 160);
    });
    // Enter soll nichts abschicken, sondern nur sofort filtern.
    sucheEl.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      window.clearTimeout(timer);
      adresseSchreiben();
      anwenden();
    });

    // Mit ?q=… im Link ankommen: Eingabe fuellen und sofort suchen.
    const start = new URL(window.location.href).searchParams.get('q');
    if (start) {
      anfrage = start.trim();
      sucheEl.value = start;
      void indexHolen();
    }
  }

  setActive('Alle');
  anwenden();
</script>

<style>
  .journal-page {
    position: relative;
    background: #050507;
    color: #f5f5f4;
    padding: 140px 40px 80px;
    min-height: 100vh;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .journal-page {
      padding: 100px 20px 60px;
    }
  }

  /* === Hero ===
     Nutzt die geteilten .subpage-hero-title + .subpage-hero-subtitle
     Klassen aus global.css (dieselben wie /referenzen, /ueber, /preise) —
     einheitliche H1-Groesse (clamp 48–96px) und Subtitle-Ton ueber alle
     Sub-Pages. Keine eigenen typografischen Overrides hier. */
  /* Hinweis fuer englischsprachige Besucher. Leiser als der
     Untertitel, aber lesbar: rgba(…,0.55) ergibt 5.8:1 auf #050507. */
  .journal-lang-note {
    margin: 14px 0 0;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: rgba(245, 245, 244, 0.55);
  }

  :global(html[data-site-theme='light']) .journal-lang-note {
    color: rgba(26, 26, 28, 0.6);
  }

  .journal-hero {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto 60px;
    text-align: center;
    /* padding-top:32px matcht /referenzen und /preise — dadurch landet
       die H1-Baseline auf derselben vertikalen Hoehe wie bei den anderen
       Sub-Pages. */
    padding-top: 32px;
  }

  /* === Suchfeld ===
     Bewusst ruhiger als die Chips: die Chips sind das auffaellige
     Element oben, das Suchfeld ist das genauere darunter. Waeren beide
     in Bernstein, konkurrierten sie um denselben Blick. */
  .journal-suche {
    position: relative;
    z-index: 2;
    max-width: 520px;
    margin: 0 auto 28px;
  }
  /* Die Beschriftung ist fuer Vorleseprogramme da, nicht fuer das Auge —
     sichtbar sagt sie dasselbe wie der Platzhalter. Nicht display:none:
     damit faellt sie auch aus der Vorlese-Reihenfolge. */
  .journal-suche-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .journal-suche-feld {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(245, 245, 244, 0.16);
    background: rgba(245, 245, 244, 0.04);
    transition: border-color 180ms ease, background 180ms ease;
  }
  .journal-suche-feld:focus-within {
    border-color: rgba(245, 158, 11, 0.6);
    background: rgba(245, 158, 11, 0.06);
  }
  .journal-suche-lupe {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: rgba(245, 245, 244, 0.45);
  }
  .journal-suche-feld:focus-within .journal-suche-lupe {
    color: rgba(245, 158, 11, 0.9);
  }
  .journal-suche-eingabe {
    flex: 1;
    min-width: 0;
    /* 16px, nicht kleiner: darunter zoomt iOS Safari beim Antippen in
       das Feld hinein und der Besucher sitzt in einer vergroesserten
       Seite fest. */
    font-size: 1rem;
    font-family: 'Inter', sans-serif;
    color: rgba(245, 245, 244, 0.95);
    background: transparent;
    border: 0;
    padding: 13px 0;
    outline: none;
  }
  .journal-suche-eingabe::placeholder {
    color: rgba(245, 245, 244, 0.38);
  }
  /* Das eigene Kreuz steht schon rechts im Feld — das von WebKit waere
     ein zweites daneben. */
  .journal-suche-eingabe::-webkit-search-cancel-button {
    display: none;
  }
  .journal-suche-leeren {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(245, 245, 244, 0.08);
    color: rgba(245, 245, 244, 0.7);
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease;
  }
  .journal-suche-leeren:hover {
    background: rgba(245, 158, 11, 0.2);
    color: rgba(245, 158, 11, 0.95);
  }
  .journal-suche-leeren svg {
    width: 14px;
    height: 14px;
  }
  .journal-suche-status {
    margin: 10px 0 0;
    min-height: 1.2em;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: rgba(245, 245, 244, 0.5);
  }

  :global(html[data-site-theme='light']) .journal-suche-feld {
    border-color: rgba(26, 26, 28, 0.18);
    background: rgba(26, 26, 28, 0.03);
  }
  :global(html[data-site-theme='light']) .journal-suche-eingabe {
    color: rgba(26, 26, 28, 0.95);
  }
  :global(html[data-site-theme='light']) .journal-suche-eingabe::placeholder {
    color: rgba(26, 26, 28, 0.45);
  }
  :global(html[data-site-theme='light']) .journal-suche-lupe {
    color: rgba(26, 26, 28, 0.45);
  }
  :global(html[data-site-theme='light']) .journal-suche-leeren {
    background: rgba(26, 26, 28, 0.07);
    color: rgba(26, 26, 28, 0.6);
  }
  :global(html[data-site-theme='light']) .journal-suche-status {
    color: rgba(26, 26, 28, 0.55);
  }

  /* === Filter-Chips === */
  .journal-filters {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto 60px;
  }
  .filter-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .filter-chip {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(245, 158, 11, 0.4);
    background: transparent;
    color: rgba(245, 158, 11, 0.95);
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .filter-chip:hover {
    background: rgba(245, 158, 11, 0.12);
  }
  .filter-chip.is-active {
    background: rgba(245, 158, 11, 0.95);
    color: #050507;
    border-color: rgba(245, 158, 11, 0.95);
  }

  @media (max-width: 768px) {
    .journal-suche {
      margin-bottom: 22px;
    }
    .journal-filters {
      margin-left: -20px;
      margin-right: -20px;
      padding: 0 20px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .filter-chips {
      flex-wrap: nowrap;
      justify-content: flex-start;
      padding-bottom: 4px;
    }
    .filter-chip {
      flex-shrink: 0;
    }
  }

  /* === Featured Post === */
  .featured-post {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .featured-post {
      grid-template-columns: 1fr;
      gap: 24px;
      /* Cover ist auf Mobile full-bleed am Card-Top, .featured-meta
