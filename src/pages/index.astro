---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section1 from '../components/sections/Section1.astro';
import Section2 from '../components/sections/Section2.astro';
import Section3Referenzen from '../components/sections/Section3Referenzen.astro';
import Section4Kernbotschaften from '../components/sections/Section4Kernbotschaften.astro';
import Section5Timeline from '../components/sections/Section5Timeline.astro';
import Section6Werkzeug from '../components/sections/Section6Werkzeug.astro';
import Section7Werkstatt from '../components/sections/Section7Werkstatt.astro';
import Section7Closing from '../components/sections/Section7Closing.astro';
import { SITE } from '../lib/constants';
---

<BaseLayout
  pageTitle="Digitale Handarbeit aus Bremen"
  title="Digitale Handarbeit aus Bremen — Websites & Web-Anwendungen"
  description="Digitale Handarbeit aus Bremen: individuelle Websites und maßgeschneiderte Web-Anwendungen. Eine Person, eine Handschrift — eine individuelle Anwendung ist im Website-Preis enthalten."
>
  <main>
    <Section1 />
    <Section2 />
    <Section3Referenzen />
    <Section4Kernbotschaften />
    <Section5Timeline />
    <Section6Werkzeug />
    <Section7Werkstatt />
    <Section7Closing />
  </main>
</BaseLayout>
