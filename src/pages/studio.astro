---
// Studio — Detail-Seite fuer das CMS ("Studio").
//
// Auf der Landing (Section 6) wird das Studio als interaktives Blueprint-
// Widget angeteast. Diese Detail-Page zeigt:
//   1. Was du selbst aendern kannst (4 Feature-Bullets)
//   2. Screenshots aus 3 echten Kunden-Studios (Er&Sie/Samedos/Kirsch)
//   3. Wie es funktioniert (3 Schritte: einloggen, bearbeiten, live)
//   4. Closing-CTA zum Kontakt
//
// Ton matcht Section 6 Sprache: kein "CMS"/"Backend"/"Dashboard", nur
// alltaegliche Woerter. Zielgruppe: Betriebe die selbst pflegen wollen
// ohne Technik-Vorwissen.

import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from '../components/SubPageBackground.astro';
import SiteFooter from '../components/SiteFooter.astro';

const features = [
  {
    number: '01',
    title: 'Texte ändern',
    body: 'Überschriften, About, alles.\nKlick rein, tippen, speichern.',
  },
  {
    number: '02',
    title: 'Bilder tauschen',
    body: 'Vom Handy oder Desktop. Größen macht dein Studio automatisch — kein Photoshop.',
  },
  {
    number: '03',
    title: 'News & Termine',
    body: 'Neuigkeiten und Aktionen.\nAuch für später planbar — Datum setzen, geht dann von selbst live.',
  },
  {
    number: '04',
    title: 'Preise & Öffnungszeiten',
    body: 'Ändert sich mal was? In 30 Sekunden angepasst. Speichern-Button, fertig.',
  },
] as const;

const showcase = [
  {
    src: '/sanity-screenshots/cms-erundsie.png',
    alt: 'Studio-Ansicht von Er & Sie',
    client: 'Er & Sie',
    branch: 'Gastronomie',
    tags: ['Stammdaten', 'Ankündigung', 'Getränkekarte', 'Bewertung', 'Termin'],
  },
  {
    src: '/sanity-screenshots/cms-samedos.png',
    alt: 'Studio-Ansicht von Samedos',
    client: 'Samedos',
    branch: 'Medizin',
    tags: ['Team', 'Stellenanzeige', 'Preislisten'],
  },
  {
    src: '/sanity-screenshots/cms-kirsch.png',
    alt: 'Studio-Ansicht von Kirsch Dach & Fassade',
    client: 'Kirsch Dach & Fassade',
    branch: 'Handwerk',
    tags: ['Stammdaten', 'Leistungen', 'Referenz-Projekte', 'Offene Stellen', 'Karriere-Vorteile', 'Bewertungen'],
  },
] as const;

const steps = [
  {
    number: '01',
    title: 'Einloggen',
    body: 'deine-domain.de/studio · von jedem Gerät, mit deinem Passwort.',
  },
  {
    number: '02',
    title: 'Bearbeiten',
    body: 'Klick auf den Ordner, dann auf das Feld.\nKein Menü-Wald, keine versteckten Optionen.',
  },
  {
    number: '03',
    title: 'Veröffentlichen',
    body: 'Speichern-Button. Sekunden später live auf deiner Website. Fertig.',
  },
] as const;
---

<BaseLayout
  pageTitle="Dein Studio"
  description="Dein CMS, gezeichnet auf deinen Betrieb. Nur die Felder, die du brauchst, mit Labels, die du sprichst. Texte, Bilder, News, Preise selbst ändern — ohne Fachwissen."
>
  <main class="studio-page">
    <SubPageBackground />

    <div class="studio-inner">
    <header class="studio-hero">
      <h1 class="subpage-hero-title">
        So pflegst du deine Website
      </h1>
      <p class="subpage-hero-subtitle text-lines">{
        'Vor dem Start besprechen wir, welche Inhalte du selbst anpassen willst.\n' +
        'Dein Studio zeigt genau die — nicht mehr, nicht weniger.'
      }</p>
    </header>

    <!-- Manifest-Break: editorial Statement zwischen Hero und Features
         setzt den Ton — die Seite spricht direkt, wie ein Handwerker. -->
    <aside class="studio-manifest" data-reveal>
      <p>Deine Website spricht deine Sprache. Nicht meine.</p>
    </aside>

    <section class="studio-features" data-reveal aria-labelledby="features-heading">
      <h2 id="features-heading" class="studio-section-title">
        Was du selbst änderst
      </h2>
      <ul class="feature-grid">
        {features.map((f) => (
          <li class="feature-item">
            <span class="feature-number">{f.number}</span>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body text-lines">{f.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="studio-showcase" data-reveal aria-labelledby="showcase-heading">
      <h2 id="showcase-heading" class="studio-section-title">
        Live bei drei Betrieben
      </h2>
      <p class="studio-section-sub">
        Jedes Studio ist auf den Betrieb gezeichnet.<br />
        Andere Ordner, andere Felder — gleicher Klick-Flow.
      </p>
      <div class="showcase-stack">
        {showcase.map((s) => (
          <details class="showcase-item">
            <summary class="showcase-summary">
              <div class="shot-meta">
                <span class="shot-client">{s.client}</span>
                <span class="shot-branch">{s.branch}</span>
              </div>
              <ul class="shot-tags" aria-label="Gepflegte Inhalte">
                {s.tags.map((t) => <li>{t}</li>)}
              </ul>
              <span class="showcase-toggle" aria-hidden="true">
                <span class="toggle-label toggle-closed">Vorschau ansehen</span>
                <span class="toggle-label toggle-open">Zuklappen</span>
                <svg class="toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </span>
            </summary>
            <div class="shot-wrap">
              <img
                src={s.src}
                alt={s.alt}
                loading="lazy"
                decoding="async"
                width="2400"
                height="1400"
              />
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="studio-steps" data-reveal aria-labelledby="steps-heading">
      <h2 id="steps-heading" class="studio-section-title">
        So funktioniert's
      </h2>
      <!-- Steps als stacked cards mit grossen Aileron-Zahlen (analog
           Features, aber untereinander statt 2x2). -->
      <ol class="steps-list">
        {steps.map((s) => (
          <li class="step-item">
            <span class="step-number">{s.number}</span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body text-lines">{s.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="studio-cta" data-reveal>
      <h2 class="studio-cta-headline">Klingt gut?</h2>
      <p class="studio-cta-sub">
        Deine Website, dein Studio.
      </p>
      <a class="studio-cta-link" href="/kontakt">
        <span>Lass uns sprechen</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* === Page Root === */
  /* .studio-page ist jetzt full-width (wie /ueber /referenzen /preise etc.)
     — SubPageBackground fuellt den Viewport statt in einer 1200er-Box
     eingesperrt zu sein. Content-max-width kommt via .studio-inner. */
  .studio-page {
    position: relative;
    background: #050507;
    padding: 140px 40px 100px;
    min-height: calc(100vh - 200px);
    overflow: hidden;
  }

  .studio-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .studio-page {
      padding: 100px 16px 60px;
    }
  }

  /* === Hero === */
  .studio-hero {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 56px;
    /* Kompensation fuer 2-zeilige H1 "So pflegst du deine Website":
       shift by -0.5 * H1-line-height so visual center matches 1-line H1s
       auf /referenzen, /preise, /journal. Baseline-Formel identisch zu
       /preisrechner. */
    padding-top: calc(32px - 0.5 * clamp(48px, 8vw, 96px));
  }

  @media (max-width: 768px) {
    .studio-hero {
      margin-bottom: 40px;
    }
  }

  /* === Manifest-Break: editorial Statement zwischen Sections ===
     Grosses italic Aileron-Zitat mit dünnen Amber-Linien darueber
     und darunter. Setzt den Ton fuer die Features-Sektion. */
  .studio-manifest {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 64px;
    padding: 32px 20px;
    border-top: 1px solid rgba(245, 158, 11, 0.25);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
  }

  .studio-manifest p {
    font-family: 'Aileron', 'Inter', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #f5f5f4;
    margin: 0;
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .studio-manifest {
      margin-bottom: 48px;
      padding: 24px 16px;
    }
  }

  /* === Section-Level Headings === */
  .studio-section-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #f5f5f4;
    margin: 0 0 12px;
    text-align: center;
  }

  .studio-section-sub {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.65);
    max-width: 640px;
    margin: 0 auto 48px;
    text-align: center;
  }

  /* === Features Grid (2x2 Kacheln) === */
  .studio-features {
    margin: 0 0 80px;
  }

  .feature-grid {
    list-style: none;
    padding: 0;
    margin: 40px auto 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 56px;
    max-width: 900px;
  }

  @media (max-width: 768px) {
    .studio-features {
      margin-bottom: 56px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 28px;
    }
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-number {
    font-family: 'Aileron', 'Inter', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 0.9;
    color: rgba(245, 158, 11, 0.85);
    letter-spacing: -0.04em;
    text-shadow: 0 0 20px rgba(245, 158, 11, 0.18);
  }

  @media (max-width: 768px) {
    .feature-number {
      text-shadow: none;
    }
  }

  .feature-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    color: #f5f5f4;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.25;
  }

  .feature-body {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.68);
    max-width: 340px;
    margin: 0;
  }

  /* === Showcase (CMS Screenshots) === */
  .studio-showcase {
    margin: 0 0 80px;
  }

  @media (max-width: 768px) {
    .studio-showcase {
      margin-bottom: 56px;
    }
  }

  .showcase-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 860px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .showcase-stack {
      gap: 14px;
    }
  }

  /* Native <details> als Accordion — klick auf Summary klappt
     Screenshot auf/zu. Kein JS. */
  .showcase-item {
    background: rgba(245, 245, 244, 0.02);
    border: 1px solid rgba(245, 158, 11, 0.2);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 220ms ease, background 220ms ease;
  }

  .showcase-item[open] {
    border-color: rgba(245, 158, 11, 0.45);
    background: rgba(245, 158, 11, 0.03);
  }

  /* Grid: meta oben, tags darunter, toggle rechts ueber beide Rows
     gespannt — tags stehen konsistent UNTER dem Client-Namen, nicht
     daneben (egal wie viele tags). */
  .showcase-summary {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 10px 20px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    align-items: center;
  }

  .showcase-summary .shot-meta { grid-column: 1; grid-row: 1; }
  .showcase-summary .shot-tags { grid-column: 1; grid-row: 2; }
  .showcase-summary .showcase-toggle {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .showcase-summary::-webkit-details-marker { display: none; }
  .showcase-summary::marker { display: none; content: ''; }

  .showcase-summary:hover .toggle-icon,
  .showcase-summary:focus-visible .toggle-icon {
    color: #fbbf24;
  }

  .showcase-summary:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.5);
    outline-offset: -2px;
    border-radius: 12px;
  }

  .shot-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .shot-client {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    color: #f5f5f4;
  }

  .shot-branch {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 158, 11, 0.85);
  }

  .shot-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }

  .shot-tags li {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.78rem;
    color: rgba(245, 245, 244, 0.7);
    padding: 4px 10px;
    border: 1px solid rgba(245, 245, 244, 0.15);
    border-radius: 999px;
  }

  .showcase-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.82rem;
    color: #f59e0b;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .toggle-label { display: inline-flex; }
  .showcase-item .toggle-open   { display: none; }
  .showcase-item[open] .toggle-closed { display: none; }
  .showcase-item[open] .toggle-open   { display: inline-flex; }

  .toggle-icon {
    transition: transform 260ms ease, color 200ms ease;
    flex-shrink: 0;
  }

  .showcase-item[open] .toggle-icon {
    transform: rotate(180deg);
  }

  .shot-wrap {
    position: relative;
    overflow: hidden;
    background: #0a0a0c;
    border-top: 1px solid rgba(245, 158, 11, 0.2);
  }

  /* Amber-Scanline beim Aufklappen eines Screenshots — 3px amber
     Gradient-Balken laeuft einmalig top→bottom als "Scan"-Effekt.
     Signalisiert: das Bild ist lebendig, editierbar. Composite-only
     (translateY + opacity), kein Perf-Impact. */
  .showcase-item[open] .shot-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(245, 158, 11, 0.9) 50%,
      transparent 100%
    );
    animation: shot-scanline 1.4s ease-out;
    pointer-events: none;
    z-index: 2;
  }

  @keyframes shot-scanline {
    0%   { transform: translateY(0); opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    100% { transform: translateY(700px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-item[open] .shot-wrap::before {
      animation: none;
    }
  }

  .shot-wrap img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .showcase-summary {
      padding: 16px 18px;
    }
    .shot-meta {
      gap: 8px;
    }
    .shot-client {
      font-size: 0.98rem;
    }
    .shot-tags {
      gap: 4px 6px;
    }
    .shot-tags li {
      font-size: 0.7rem;
      padding: 3px 8px;
    }
    .showcase-toggle {
      font-size: 0.75rem;
    }
    .toggle-label {
      display: none;
    }
  }

  /* === Steps: stacked cards mit grossen Aileron-Zahlen ===
     Layout analog zu Features (Aileron italic Zahl + Titel + Body),
     aber untereinander (1-col) statt 2x2. Zentriert mit max-width. */
  .studio-steps {
    margin: 0 0 80px;
  }

  @media (max-width: 768px) {
    .studio-steps {
      margin-bottom: 56px;
    }
  }

  .steps-list {
    list-style: none;
    padding: 0;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 640px;
  }

  @media (max-width: 768px) {
    .steps-list {
      gap: 32px;
      margin-top: 28px;
    }
  }

  .step-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step-number {
    font-family: 'Aileron', 'Inter', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 0.9;
    color: rgba(245, 158, 11, 0.85);
    letter-spacing: -0.04em;
    text-shadow: 0 0 20px rgba(245, 158, 11, 0.18);
  }

  @media (max-width: 768px) {
    .step-number {
      text-shadow: none;
    }
  }

  .step-title {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    color: #f5f5f4;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.25;
  }

  .step-body {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.68);
    max-width: 540px;
    margin: 0;
  }

  /* === Closing CTA === */
  .studio-cta {
    text-align: center;
    padding: 60px 20px 20px;
    border-top: 1px solid rgba(245, 158, 11, 0.15);
  }

  .studio-cta-headline {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #f5f5f4;
    margin: 0 0 12px;
  }

  .studio-cta-sub {
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: rgba(245, 245, 244, 0.7);
    line-height: 1.55;
    margin: 0 auto 32px;
    max-width: 520px;
  }

  /* Editorial Inline-Link CTA (matcht Section 7 / Preisrechner) */
  .studio-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 0 2px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    color: #f5f5f4;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 600;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    text-decoration: none;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .studio-cta-link svg {
    color: #f59e0b;
    transition: transform 200ms ease;
    flex-shrink: 0;
  }

  .studio-cta-link:hover,
  .studio-cta-link:focus-visible {
    border-bottom-color: rgba(245, 158, 11, 0.7);
    color: #fff;
    outline: none;
  }

  .studio-cta-link:hover svg,
  .studio-cta-link:focus-visible svg {
    transform: translateX(4px);
  }

  .studio-cta-link:focus-visible {
    outline: 2px solid rgba(245, 158, 11, 0.5);
    outline-offset: 6px;
    border-radius: 2px;
  }
</style>

