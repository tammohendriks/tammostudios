---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubPageBackground from '../components/SubPageBackground.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { SITE } from '../lib/constants';

// Client-Cases: dieselben Kunden wie auf /referenzen, hier aber unter
// dem technischen Blickwinkel — was fuer eine Anwendung wurde gebaut,
// nicht wie die Website aussieht. Daten bewusst lokal und nicht aus
// lib/references.ts: das sind andere Felder fuer einen anderen Zweck,
// und eine gemeinsame Struktur wuerde beide Seiten einschraenken.
const cases = [
  {
    name: 'IBI',
    full: 'Institut für Betriebsmedizin',
    branch: 'Betriebsmedizin, Isernhagen',
    body:
      'Anfrage-System für Vorsorgen mit drei Wegen durchs Formular. ' +
      'Unternehmen tragen Mitarbeitende ein, wählen die Untersuchungen ' +
      'aus, daraus entsteht automatisch ein PDF, das direkt in der Praxis ' +
      'landet. Der Absender bekommt eine Bestätigung. Die ganze Seite ' +
      'schaltet außerdem auf Englisch um, für internationale Belegschaften.',
    tags: ['Formular mit drei Wegen', 'PDF automatisch', 'Deutsch / Englisch'],
    href: 'https://ibi-doc.de/anfrage',
  },
  {
    name: 'Samedos',
    full: 'Arbeitsmedizinische Praxis',
    branch: 'Betriebsmedizin, Bremen',
    body:
      'Ein 360°-Rundgang durch die Praxis, direkt auf der Seite begehbar. ' +
      'Wer zur Vorsorge kommt, weiß vorher, wo er landet. Dazu eine ' +
      'vollständige englische Fassung der Seite auf Knopfdruck, ohne ' +
      'zweite Website und ohne doppelte Pflege.',
    tags: ['360°-Rundgang', 'Deutsch / Englisch', 'Eigenes Redaktionssystem'],
    href: 'https://www.samedos.de/rundgang',
  },
  {
    name: 'WärmePower',
    full: 'Heizung, Wärmepumpe, Sanitär',
    branch: 'Handwerk, Bremen',
    body:
      'Sechs Fragen zu Wohnfläche, Baujahr, Personen und Warmwasser. ' +
      'Daraus eine Empfehlung: Wärmepumpe, Hybrid oder Gas-Brennwert. Mit ' +
      'Investitionsrahmen, möglicher BEG-Förderung und Eigenanteil. ' +
      'WärmePower bekommt das ausgefüllte Formular als Mail und PDF, der ' +
      'Kunde eine Bestätigung. Zweimal im Monat kommen echte Anfragen ' +
      'darüber rein.',
    tags: ['Empfehlungs-Logik', 'PDF automatisch', 'Förder-Berechnung'],
    href: 'https://waermepower.de/heizungsrechner',
  },
  {
    name: 'Kirsch',
    full: 'Dach & Fassade',
    branch: 'Dachdecker, Bremen',
    body:
      'Investitionsrechner, der zeigt wie viel teurer dasselbe Bauprojekt ' +
      'in fünf und zehn Jahren wird, auf Basis realer ' +
      'Baupreis-Entwicklungen. Dazu: wie viel Wertsteigerung eine neue ' +
      'Dachhülle der Immobilie zurückgibt. Beratung wird damit nachvollziehbar ' +
      'statt gefühlt.',
    tags: ['Kosten-Prognose', 'Baupreis-Entwicklung', 'Wertsteigerung'],
    href: 'https://kirsch-dach-fassade.de/investition',
  },
] as const;

const steps = [
  {
    number: '01',
    title: 'Erstgespräch',
    meta: '30 Minuten, kostenlos',
    body:
      'Wir sprechen über deinen Ablauf. Was läuft von Hand, wo verbrennst ' +
      'du Zeit? Am Ende weißt du, ob sich eine eigene Anwendung für dich ' +
      'lohnt.',
  },
  {
    number: '02',
    title: 'Konzeption + Angebot',
    meta: '48 Stunden',
    body:
      'Du bekommst einen konkreten Vorschlag: was sie können soll, wie ' +
      'lange es dauert, was es kostet. Fix, nicht mit Sternchen. Darauf ' +
      'entscheidest du.',
  },
  {
    number: '03',
    title: 'Entwicklung',
    // Bewusst keine Wochenzahl: wie lange etwas dauert, weiss man erst,
    // wenn klar ist was es koennen soll. Die feste Zahl kommt in 02.
    meta: 'Termin steht im Angebot',
    body:
      'Kein wochenlanges Hin und Her an Details. Ich baue in klaren ' +
      'Schritten, du siehst nach jedem Abschnitt was passiert und kannst ' +
      'korrigieren. Zum Schluss bekommst du deine Zugänge, eine Anleitung ' +
      'und eine Einweisung.',
  },
] as const;

// Was im Alltag unter "eine individuelle Anwendung" faellt. Steht
// bewusst VOR den Cases: erst die Kategorie greifbar machen, dann die
// vier konkreten Umsetzungen zeigen. Ohne das liest sich die Case-Liste
// wie vier Einzelfaelle statt wie ein Angebot.
const kinds = [
  {
    title: 'Rechner',
    body:
      'Ein paar Eckdaten rein, eine brauchbare Zahl raus: eine Empfehlung, ' +
      'ein Investitionsrahmen, eine Förderhöhe.',
  },
  {
    title: 'Anfrageformulare, die mitdenken',
    body:
      'Nicht „Name, Mail, Nachricht". Sondern Formulare, die je nach Antwort ' +
      'anders weitergehen und dir am Ende ein fertiges PDF ins Postfach ' +
      'legen.',
  },
  {
    title: 'Konfiguratoren',
    body:
      'Leistungen, Varianten, Optionen: zusammenklickbar, mit Preis oder ' +
      'Zusammenfassung am Ende. Spart das erste Klärungs-Telefonat.',
  },
  {
    title: 'Inhalte, die sich selbst ausgeben',
    body:
      'Einmal gepflegt, und daraus entstehen Seite, PDF und Übersetzung. ' +
      'Keine drei Dateien, die auseinanderlaufen.',
  },
] as const;
---

<BaseLayout
  pageTitle="Software"
  title="App- & Software-Entwicklung aus Bremen | Tammo Studios"
  description="Software-Entwicklung aus Bremen: Preisrechner, Konfiguratoren, mitdenkende Anfrageformulare, eigene Apps. Eine individuelle Anwendung ist im Website-Preis enthalten, Größeres nach Erstgespräch."
>
  <main class="software-page">
    <SubPageBackground />

    <header class="software-hero">
      <h1 class="subpage-hero-title">Websites können mehr als nur da sein.</h1>
      <p class="subpage-hero-subtitle software-hero-sub">
        Preisrechner, mitdenkende Anfrageformulare, Konfiguratoren,
        automatische PDFs. Eine davon ist im Website-Preis schon drin.
      </p>

      <div class="software-hero-cta">
        <a class="cta-link" href="/kontakt">
          Erstgespräch anfragen
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
        </a>
        <p class="software-hero-note">Eine Anwendung inklusive · jede weitere 500 €</p>
      </div>
    </header>

    <section class="software-positioning" aria-label="Was ich baue" data-reveal>
      <p>
        Die meisten Websites hören auf, wo es interessant wird: bei
        „Formular abgeschickt". <br class="hidden sm:inline" />
        Rechnen, ein Dokument erzeugen, an die richtige Stelle schicken: <br class="hidden sm:inline" />
        das läuft dann wieder per Telefon.
      </p>
      <p>
        Genau der Teil ist mein Handwerk. Keine fertige Vorlage. <br class="hidden sm:inline" />
        Kein zugekauftes Modul, sondern deine Abläufe als Grundlage.
      </p>
    </section>

    <!-- ================================================================
         Was eine "Anwendung" ueberhaupt ist — Kategorie vor Beispielen
         ============================================================== -->
    <section class="software-kinds" aria-labelledby="kinds-heading" data-reveal>
      <h2 id="kinds-heading" class="software-section-title">Was damit gemeint ist</h2>
      <div class="kinds-grid">
        {kinds.map((k) => (
          <article class="kind-item" data-reveal>
            <h3 class="kind-title">{k.title}</h3>
            <p class="kind-body">{k.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="software-cases" aria-labelledby="cases-heading">
      <h2 id="cases-heading" class="software-section-title" data-reveal>Vier, die live sind</h2>

      <div class="case-grid">
        {cases.map((item) => (
          <article class="case-card" data-reveal>
            <h3 class="case-name">{item.name}</h3>
            <p class="case-full">{item.full}</p>
            <p class="case-branch">{item.branch}</p>
            <p class="case-body">{item.body}</p>

            <ul class="case-tags">
              {item.tags.map((tag) => <li class="case-tag">{tag}</li>)}
            </ul>

            <a class="cta-link case-link" href={item.href} target="_blank" rel="noopener">
              Ansehen
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- ================================================================
         Groesser als eine Website — App-/Software-Entwicklung als
         eigenstaendiges Angebot. Zielt auf "app agentur bremen" und
         "software entwicklung bremen": beides hatte Impressions, aber
         keinen passenden Landeplatz. Der Werkstatt-Link ist Beleg, KEINE
         Weiterleitung — wer beauftragen will, bleibt hier.
         ============================================================== -->
    <section class="software-bigger" aria-labelledby="bigger-heading" data-reveal>
      <h2 id="bigger-heading" class="software-section-title">Größer als eine Website</h2>
      <div class="bigger-body">
        <p>
          Manches passt nicht mehr in eine Website. Eine Anwendung, die
          deine Mitarbeiter täglich benutzen. Ein System mit mehreren
          Rollen. Eine App. Oder ein Spiel.
        </p>
        <p>
          Das baue ich auch, nur eben nicht zum Listenpreis. <br class="hidden sm:inline" />
          Eine Zahl vor dem ersten Gespräch wäre geraten.
        </p>
      </div>
      <p class="bigger-proof">
        Wie tief das geht, kannst du dir ansehen statt es mir zu glauben:
        In der <a href="/werkstatt">Werkstatt</a> liegt ein Spiel, das ich
        ohne Auftrag gebaut habe. Spielbar direkt im Browser.
      </p>
    </section>

    <section class="software-process" aria-labelledby="process-heading">
      <h2 id="process-heading" class="software-section-title" data-reveal>So läuft das ab</h2>

      <div class="process-grid">
        {steps.map((step) => (
          <article class="process-step" data-reveal>
            <p class="process-number">{step.number}</p>
            <h3 class="process-title">{step.title}</h3>
            <p class="process-meta">{step.meta}</p>
            <p class="process-body">{step.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="software-pricing" aria-labelledby="pricing-heading" data-reveal>
      <h2 id="pricing-heading" class="software-section-title">Was das kostet</h2>

      <div class="pricing-body">
        <p>
          <strong>2.000 €</strong> für eine Website, <strong>3.000 €</strong>
          für einen Online-Shop. <br class="hidden sm:inline" />
          Eine Anwendung deiner Wahl ist dabei, ohne Aufpreis und ohne
          längere Bauzeit: <br class="hidden sm:inline" />
          sie entsteht in denselben <strong>14 Tagen</strong>. Jede weitere
          kostet <strong>500 €</strong>.
        </p>
        <p>
          Geht es über eine Website hinaus, etwa eine eigene App, nenne ich
          vorher keine Zahl. Das hängt zu sehr am Umfang. Nach dem
          Erstgespräch bekommst du eine feste.
        </p>
      </div>

      <p class="pricing-aside">
        Alles im Detail auf der <a href="/preise">Preisseite</a>, oder du
        stellst dir dein Paket direkt im
        <a href="/preisrechner">Preisrechner</a> zusammen.
      </p>
    </section>

    <ClosingCta
      recommendation={{
        text: 'Wissen wollen, wie weit das technisch geht?',
        label: 'In die Werkstatt schauen',
        href: '/werkstatt',
      }}
    />

  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* Site-Konvention fuer Sub-Pages: full-width page-container mit
     140px 40px 80px padding, content darin per max-width zentriert.
     Matched /referenzen /preise /journal /kontakt etc. */
  .software-page {
    position: relative;
    background: #050507;
    padding: 140px 40px 80px;
    min-height: calc(100vh - 200px);
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .software-page {
      padding: 100px 20px 60px;
    }
  }

  /* Site-Konvention: Section-Ueberschriften und Fliesstext sind
     zentriert, Karten-Inhalte bleiben linksbuendig (sonst wird eine
     mehrzeilige Aufzaehlung unlesbar). Gleiches Schema wie /website
     und /preise. */
  .software-page > section {
    max-width: 1080px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  /* ------------------------------------------------------------- hero */
  /* Hero folgt der Sub-Page-Konvention: text-align:center, max-width
     780px, padding-top:32px matched /referenzen /preise /journal /ueber.
     Kein Eyebrow — das hat sonst keine Unterseite. CTA + Note bleiben
     zentriert unter dem Header. */
  .software-hero {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 780px;
    margin: 0 auto 60px;
    /* Kein padding-top wie auf den anderen Sub-Pages: die Headline ist
       hier deutlich laenger und braucht den Platz nach unten, nicht
       nach oben. */
    padding-top: 0;
  }

  /* "Websites koennen mehr als nur da sein." laeuft bei den globalen
     96px auf drei Zeilen und schiebt den Hero optisch nach unten.
     Gedeckelt liest sich der Satz als ein Block — gleiches Mittel wie
     auf den Rechtsseiten. */
  .software-hero .subpage-hero-title {
    font-size: clamp(36px, 5.6vw, 64px);
  }

  .software-hero-sub {
    max-width: 62ch;
    margin-inline: auto;
  }

  .software-hero-cta {
    margin-top: clamp(32px, 5vh, 48px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .software-hero-note {
    margin: 0;
    color: rgba(245, 245, 244, 0.5);
    font-size: 0.9rem;
  }

  /* ------------------------------------------------- section headings */

  .software-section-title {
    margin: 0 0 clamp(24px, 4vh, 40px);
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: rgba(245, 245, 244, 0.96);
  }

  .software-page > section {
    /* War clamp(48px, 8vh, 88px) — zusammen mit den kuerzeren Texten
       stand die Seite sonst zu weit auseinander. */
    padding-block: clamp(28px, 4.5vh, 52px);
  }

  /* ------------------------------------------------------ positioning */

  .software-positioning p {
    margin: 0 auto 18px;
    max-width: 58ch;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.55;
    color: rgba(245, 245, 244, 0.82);
  }

  /* ------------------------------------------------ was gemeint ist */

  .kinds-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (max-width: 640px) {
    .kinds-grid {
      grid-template-columns: 1fr;
    }
  }

  .kind-item {
    padding-left: 18px;
    border-left: 2px solid rgba(245, 158, 11, 0.55);
    text-align: left;
  }

  .kind-title {
    margin: 0 0 8px;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #f5f5f4;
  }

  .kind-body {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.7);
  }

  /* ----------------------------------------------------- client cases */

  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.5vw, 26px);
  }

  .case-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: clamp(24px, 3vw, 32px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 260ms ease, transform 260ms ease;
  }

  .case-card:hover {
    border-color: rgba(245, 158, 11, 0.35);
    transform: translateY(-2px);
  }

  .case-name {
    margin: 0;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: rgba(245, 245, 244, 0.96);
  }

  .case-full {
    margin: 2px 0 0;
    font-size: 0.95rem;
    color: rgba(245, 245, 244, 0.6);
  }

  .case-branch {
    margin: 10px 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 158, 11, 0.75);
  }

  .case-body {
    margin: 18px 0 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.72);
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .case-tag {
    padding: 5px 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: rgba(245, 245, 244, 0.6);
  }

  /* Aussehen kommt aus .cta-link (global.css). Hier bleibt nur, was
     die Position in der Karte betrifft: der Link sitzt am unteren Rand,
     damit er in allen Karten einer Reihe auf derselben Linie liegt. */
  .case-link {
    margin-top: auto;
    padding-top: 22px;
    align-self: flex-start;
  }

  /* ------------------------------------------- groesser als website */

  .bigger-body p {
    max-width: 58ch;
    margin: 0 auto 18px;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.8);
  }

  .bigger-proof {
    max-width: 58ch;
    margin: clamp(24px, 4vh, 36px) auto 0;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.55);
  }

  .bigger-proof a {
    color: rgba(245, 158, 11, 0.9);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
  }

  .bigger-proof a:hover {
    border-bottom-color: rgba(245, 158, 11, 0.9);
  }

  /* --------------------------------------------------------- process */

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 34px);
    text-align: left;
  }

  .process-number {
    margin: 0;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 2.2rem;
    line-height: 1;
    color: rgba(245, 158, 11, 0.95);
  }

  .process-title {
    margin: 12px 0 0;
    font-family: 'Neue Montreal', 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    color: rgba(245, 245, 244, 0.96);
  }

  .process-meta {
    margin: 4px 0 0;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 245, 244, 0.45);
  }

  .process-body {
    margin: 14px 0 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.72);
  }

  /* --------------------------------------------------------- pricing */

  .pricing-body p {
    max-width: 58ch;
    margin: 0 auto 18px;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.8);
  }

  .pricing-body strong {
    color: rgba(245, 158, 11, 0.95);
    font-weight: 600;
  }

  .pricing-aside {
    max-width: 58ch;
    margin: clamp(24px, 4vh, 36px) auto 0;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(245, 245, 244, 0.55);
  }

  .pricing-aside a {
    color: rgba(245, 158, 11, 0.9);
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
  }

  .pricing-aside a:hover {
    border-bottom-color: rgba(245, 158, 11, 0.9);
  }

  /* ---------------------------------------------------------- mobile */

  @media (max-width: 860px) {
    .case-grid,
    .process-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

</style>
