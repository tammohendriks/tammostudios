# Sanity — read-side. PUBLIC_ prefixed = exposed to Astro Client-Bundle.
PUBLIC_SANITY_PROJECT_ID=dszzp6oh
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01
# ACHTUNG, INVERTIERT UND FOLGENREICH: 'false' schaltet NICHT nur die
# robots.txt auf Disallow, sondern setzt auf JEDER Seite
# <meta name="robots" content="noindex,nofollow"> (BaseLayout). Ein
# lokaler Build mit dieser Einstellung ist komplett unsichtbar — wer
# daraus deployt, nimmt die Seite aus dem Index.
# Deshalb steht hier 'true'. Auf 'false' gehoert sie nur in
# Preview-Deploys, die nicht indexiert werden sollen.
PUBLIC_ALLOW_INDEXING=true

# Sanity — Write-Token fuer publish-post CLI (nur .env.local, NICHT
# committen). NIEMALS mit PUBLIC_ oder SANITY_STUDIO_ prefixen — sonst
# leaked in Client-Bundle.
SANITY_WRITE_TOKEN=

# Resend — Kontaktformular API-Route (/api/kontakt)
# Von: https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM_EMAIL=tammo@tammostudios.de
CONTACT_TO_EMAIL=tammo@tammostudios.de
