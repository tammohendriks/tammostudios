{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tammostudios.de"
        }
      ],
      "destination": "https://tammostudios.de/:path*",
      "statusCode": 301
    },
    {
      "source": "/handwerk",
      "destination": "/webdesign-handwerk",
      "statusCode": 301
    },
    {
      "source": "/praxis",
      "destination": "/webdesign-praxis",
      "statusCode": 301
    },
    {
      "source": "/gastro",
      "destination": "/webdesign-gastronomie",
      "statusCode": 301
    },
    {
      "source": "/studio",
      "destination": "/website#cms",
      "statusCode": 301
    },
    {
      "source": "/websites",
      "destination": "/website",
      "statusCode": 301
    },
    {
      "source": "/en/journal/:path*",
      "destination": "/journal/:path*",
      "statusCode": 301
    },
    {
      "source": "/en/imprint",
      "destination": "/impressum",
      "statusCode": 301
    },
    {
      "source": "/en/privacy",
      "destination": "/datenschutz",
      "statusCode": 301
    },
    {
      "source": "/en/impressum",
      "destination": "/impressum",
      "statusCode": 301
    },
    {
      "source": "/en/datenschutz",
      "destination": "/datenschutz",
      "statusCode": 301
    },
    {
      "source": "/en/preisrechner",
      "destination": "/preisrechner",
      "statusCode": 301
    },
    {
      "source": "/en/price-calculator",
      "destination": "/preisrechner",
      "statusCode": 301
    },
    {
      "source": "/en/preise",
      "destination": "/en/pricing",
      "statusCode": 301
    },
    {
      "source": "/en/referenzen",
      "destination": "/en/work",
      "statusCode": 301
    },
    {
      "source": "/en/ueber",
      "destination": "/en/about",
      "statusCode": 301
    },
    {
      "source": "/en/kontakt",
      "destination": "/en/contact",
      "statusCode": 301
    },
    {
      "source": "/en/werkstatt",
      "destination": "/en/lab",
      "statusCode": 301
    },
    {
      "source": "/en/webdesign-handwerk",
      "destination": "/en/web-design-contractors",
      "statusCode": 301
    },
    {
      "source": "/en/webdesign-praxis",
      "destination": "/en/web-design-medical-practices",
      "statusCode": 301
    },
    {
      "source": "/en/webdesign-gastronomie",
      "destination": "/en/web-design-restaurants",
      "statusCode": 301
    }
  ]
}
