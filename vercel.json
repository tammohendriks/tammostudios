{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "www.tammostudios.de" }
      ],
      "destination": "https://tammostudios.de/:path*",
      "statusCode": 301
    }
  ]
}
